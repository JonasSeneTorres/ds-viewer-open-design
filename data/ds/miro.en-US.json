"cv03","cv04","cv09","cv11"],"stack":"\"Roobert PRO Medium\", blwf, cv03, cv04, cv09, cv11, sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Headings"}],"kind":"display","family":"Roobert PRO SemiBold","fallbacks":["Roobert PRO SemiBold Italic"],"stack":"\"Roobert PRO SemiBold\", \"Roobert PRO SemiBold Italic\", sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Body"}],"kind":"body","family":"Noto Sans","fallbacks":["liga\" 0","ss01","ss04","ss05"],"stack":"\"Noto Sans\", \"liga\" 0\", ss01, ss04, ss05, sans-serif","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/Noto+Sans","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/noto-sans"}}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#fff7c2"},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"#fff3a3"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#050038"},{"name":"--fg-2","value":"#322b6b"},{"name":"--muted","value":"#605a8a"},{"name":"--meta","value":"#f7c600"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#ded9ff"},{"name":"--border-soft","value":"#eeeaff"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#ffd02f"},{"name":"--accent-on","value":"#050038"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#1a7f37"},{"name":"--warn","value":"#ff9f1c"},{"name":"--danger","value":"#d92d20"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"18px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"38px"},{"name":"--text-3xl","value":"56px"},{"name":"--text-4xl","value":"76px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.02"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"104px"},{"name":"--section-y-tablet","value":"72px"},{"name":"--section-y-phone","value":"52px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"18px"},{"name":"--radius-lg","value":"28px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 16px 40px rgba(5, 0, 56, 0.14)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(255, 208, 47, 0.38)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"230ms"},{"name":"--ease-standard","value":"cubic-bezier(0.22, 1, 0.36, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1220px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"28px"},{"name":"--container-gutter-phone","value":"18px"}]}],"vars":{"--primary-500":"#ad8b0d","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 90%, var(--fg))","--ok-fg":"#ffffff","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 85%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.375rem","--fs-h1":"3.5rem","--fs-hero":"4.75rem","--lh-body":"1.5","--lh-tight":"1.05","--display-tracking":"-0.025em","--section-y":"104px","--section-y-tablet":"72px","--container-max":"1220px","--gutter":"36px","--gutter-tablet":"28px","--gutter-phone":"18px","--motion-fast":"150ms","--motion-base":"230ms","--ease":"cubic-bezier(0.22, 1, 0.36, 1)","--radius-lg":"28px","--focus-ring":"0 0 0 4px rgba(255, 208, 47, 0.38)","--bg":"#fff7c2","--surface":"#ffffff","--surface-2":"#fff3a3","--fg":"#050038","--fg-soft":"#322b6b","--muted":"#605a8a","--meta":"color-mix(in oklab, #f7c600 50%, var(--fg))","--border":"#ded9ff","--border-soft":"#eeeaff","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ffd02f","--accent-strong":"color-mix(in oklab, var(--accent) 50%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#050038","--solid":"#ffd02f","--solid-hover":"#ffd553","--solid-fg":"#050038","--ok":"#1a7f37","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ff9f1c","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#d92d20","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"18px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 16px 40px rgba(5, 0, 56, 0.14)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Roobert PRO Medium\", blwf, cv03, cv04, cv09, cv11, sans-serif","--font-body":"\"Noto Sans\", \"liga\" 0\", ss01, ss04, ss05, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Miro's website is a clean, collaborative-tool-forward platform that communicates &quot;visual thinking&quot; through generous whitespace, pastel accent colors, and a confident geometric font. The design uses a predominantly white canvas with near-black text (<code>#1c1c1e</code>) and a distinctive pastel color palette — coral, rose, teal, orange, yellow, moss — each representing different collaboration contexts.</p>\n<p>The typography uses Roobert PRO Medium as the primary display font with OpenType character variants (<code>&quot;blwf&quot;, &quot;cv03&quot;, &quot;cv04&quot;, &quot;cv09&quot;, &quot;cv11&quot;</code>) and negative letter-spacing (-1.68px at 56px). Noto Sans handles body text with its own stylistic set (<code>&quot;liga&quot; 0, &quot;ss01&quot;, &quot;ss04&quot;, &quot;ss05&quot;</code>). The design is built with Framer, giving it smooth animations and modern component patterns.</p>\n<p><strong>Key Characteristics:</strong></p>\n<ul><li>White canvas with near-black (<code>#1c1c1e</code>) text</li><li>Roobert PRO Medium with multiple OpenType character variants</li><li>Pastel accent palette: coral, rose, teal, orange, yellow, moss (light + dark pairs)</li><li>Blue 450 (<code>#5b76fe</code>) as primary interactive color</li><li>Success green (<code>#00b473</code>) for positive states</li><li>Generous border-radius: 8px–50px range</li><li>Framer-built with smooth motion patterns</li><li>Ring shadow border: <code>rgb(224,226,232) 0px 0px 0px 1px</code></li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<h3>Primary</h3>\n<ul><li><strong>Near Black</strong> (<code>#1c1c1e</code>): Primary text</li><li><strong>White</strong> (<code>#ffffff</code>): <code>--tw-color-white</code>, primary surface</li><li><strong>Blue 450</strong> (<code>#5b76fe</code>): <code>--tw-color-blue-450</code>, primary interactive</li><li><strong>Actionable Pressed</strong> (<code>#2a41b6</code>): <code>--tw-color-actionable-pressed</code></li></ul>\n<h3>Pastel Accents (Light/Dark pairs)</h3>\n<ul><li><strong>Coral</strong>: Light <code>#ffc6c6</code> / Dark <code>#600000</code></li><li><strong>Rose</strong>: Light <code>#ffd8f4</code> / Dark (implied)</li><li><strong>Teal</strong>: Light <code>#c3faf5</code> / Dark <code>#187574</code></li><li><strong>Orange</strong>: Light <code>#ffe6cd</code></li><li><strong>Yellow</strong>: Dark <code>#746019</code></li><li><strong>Moss</strong>: Dark <code>#187574</code></li><li><strong>Pink</strong> (<code>#fde0f0</code>): Soft pink surface</li><li><strong>Red</strong> (<code>#fbd4d4</code>): Light red surface</li><li><strong>Dark Red</strong> (<code>#e3c5c5</code>): Muted red</li></ul>\n<h3>Semantic</h3>\n<ul><li><strong>Success</strong> (<code>#00b473</code>): <code>--tw-color-success-accent</code></li></ul>\n<h3>Neutral</h3>\n<ul><li><strong>Slate</strong> (<code>#555a6a</code>): Secondary text</li><li><strong>Input Placeholder</strong> (<code>#a5a8b5</code>): <code>--tw-color-input-placeholder</code></li><li><strong>Border</strong> (<code>#c7cad5</code>): Button borders</li><li><strong>Ring</strong> (<code>rgb(224,226,232)</code>): Shadow-as-border</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<h3>Font Families</h3>\n<ul><li><strong>Display</strong>: <code>Roobert PRO Medium</code>, fallback: Placeholder — <code>&quot;blwf&quot;, &quot;cv03&quot;, &quot;cv04&quot;, &quot;cv09&quot;, &quot;cv11&quot;</code></li><li><strong>Display Variants</strong>: <code>Roobert PRO SemiBold</code>, <code>Roobert PRO SemiBold Italic</code>, <code>Roobert PRO</code></li><li><strong>Body</strong>: <code>Noto Sans</code> — <code>&quot;liga&quot; 0, &quot;ss01&quot;, &quot;ss04&quot;, &quot;ss05&quot;</code></li></ul>\n<h3>Hierarchy</h3>\n<table><thead><tr><th>Role</th><th>Font</th><th>Size</th><th>Weight</th><th>Line Height</th><th>Letter Spacing</th></tr></thead><tbody><tr><td>Display Hero</td><td>Roobert PRO Medium</td><td>56px</td><td>400</td><td>1.15</td><td>-1.68px</td></tr><tr><td>Section Heading</td><td>Roobert PRO Medium</td><td>48px</td><td>400</td><td>1.15</td><td>-1.44px</td></tr><tr><td>Card Title</td><td>Roobert PRO Medium</td><td>24px</td><td>400</td><td>1.15</td><td>-0.72px</td></tr><tr><td>Sub-heading</td><td>Noto Sans</td><td>22px</td><td>400</td><td>1.35</td><td>-0.44px</td></tr><tr><td>Feature</td><td>Roobert PRO Medium</td><td>18px</td><td>600</td><td>1.35</td><td>normal</td></tr><tr><td>Body</td><td>Noto Sans</td><td>18px</td><td>400</td><td>1.45</td><td>normal</td></tr><tr><td>Body Standard</td><td>Noto Sans</td><td>16px</td><td>400–600</td><td>1.50</td><td>-0.16px</td></tr><tr><td>Button</td><td>Roobert PRO Medium</td><td>17.5px</td><td>700</td><td>1.29</td><td>0.175px</td></tr><tr><td>Caption</td><td>Roobert PRO Medium</td><td>14px</td><td>400</td><td>1.71</td><td>normal</td></tr><tr><td>Small</td><td>Roobert PRO Medium</td><td>12px</td><td>400</td><td>1.15</td><td>-0.36px</td></tr><tr><td>Micro Uppercase</td><td>Roobert PRO</td><td>10.5px</td><td>400</td><td>0.90</td><td>uppercase</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<h3>Buttons</h3>\n<ul><li>Outlined: transparent bg, <code>1px solid #c7cad5</code>, 8px radius, 7px 12px padding</li><li>White circle: 50% radius, white bg with shadow</li><li>Blue primary (implied from interactive color)</li></ul>\n<h3>Cards: 12px–24px radius, pastel backgrounds</h3>\n<h3>Inputs: white bg, <code>1px solid #e9eaef</code>, 8px radius, 16px padding</h3>"}]},{"id":"layout-principles","title":[{"lang":"en-US","message":"Layout Principles"}],"html":[{"lang":"en-US","message":"<ul><li>Spacing: 1–24px base scale</li><li>Radius: 8px (buttons), 10px–12px (cards), 20px–24px (panels), 40px–50px (large containers)</li><li>Ring shadow: <code>rgb(224,226,232) 0px 0px 0px 1px</code></li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"en-US","message":"Depth & Elevation"}],"html":[{"lang":"en-US","message":"<p>Minimal — ring shadow + pastel surface contrast</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<h3>Do</h3>\n<ul><li>Use pastel light/dark pairs for feature sections</li><li>Apply Roobert PRO with OpenType character variants</li><li>Use Blue 450 (#5b76fe) for interactive elements</li></ul>\n<h3>Don't</h3>\n<ul><li>Don't use heavy shadows</li><li>Don't mix more than 2 pastel accents per section</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<p>Breakpoints: 425px, 576px, 768px, 896px, 1024px, 1200px, 1280px, 1366px, 1700px, 1920px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<h3>Quick Color Reference</h3>\n<ul><li>Text: Near Black (<code>#1c1c1e</code>)</li><li>Background: White (<code>#ffffff</code>)</li><li>Interactive: Blue 450 (<code>#5b76fe</code>)</li><li>Success: <code>#00b473</code></li><li>Border: <code>#c7cad5</code></li></ul>\n<h3>Example Component Prompts</h3>\n<ul><li>&quot;Create hero: white background. Roobert PRO Medium 56px, line-height 1.15, letter-spacing -1.68px. Blue CTA (#5b76fe). Outlined secondary (1px solid #c7cad5, 8px radius).&quot;</li></ul>"}]}]}