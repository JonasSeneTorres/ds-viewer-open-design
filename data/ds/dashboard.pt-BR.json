","message":"Semântico"}],"items":[{"name":"--success","value":"#10b981"},{"name":"--warn","value":"#f59e0b"},{"name":"--danger","value":"#ef4444"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"11px"},{"name":"--text-sm","value":"13px"},{"name":"--text-base","value":"15px"},{"name":"--text-lg","value":"17px"},{"name":"--text-xl","value":"22px"},{"name":"--text-2xl","value":"30px"},{"name":"--text-3xl","value":"42px"},{"name":"--text-4xl","value":"56px"},{"name":"--leading-body","value":"1.48"},{"name":"--leading-tight","value":"1.1"},{"name":"--tracking-display","value":"-0.015em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"84px"},{"name":"--section-y-tablet","value":"60px"},{"name":"--section-y-phone","value":"42px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"12px"},{"name":"--radius-lg","value":"18px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 18px 46px rgba(15, 23, 42, 0.10)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(14, 165, 233, 0.22)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"120ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#0ea5e9","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 60%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 75%, var(--fg))","--danger-fg":"#111111","--bg":"#f4f7fb","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111827","--fg-soft":"#334155","--muted":"#64748b","--border":"#d8e2ee","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#0ea5e9","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#04131d","--solid":"var(--accent-strong)","--solid-fg":"#04131d","--ok":"#10b981","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f59e0b","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ef4444","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 18px 46px rgba(15, 23, 42, 0.10)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"system-ui, sans-serif","--font-body":"system-ui, sans-serif","--font-code":"\"IBM Plex Sans\", monospace","--font-mono":"\"IBM Plex Sans\", monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Estética de plataforma de nuvem em tema escuro, com grids modulares, painéis com aparência de vidro e forte hierarquia de dados para dashboards de produtividade.</p>\n<ul><li><strong>Estilo visual:</strong> moderno, limpo, estética de plataforma de nuvem (inspirada em Heroku/Vercel/GitHub), tema escuro, gradientes sutis, sombras suaves, painéis com aparência de vidro, componentes arredondados</li><li><strong>Postura de cor:</strong> primária, neutra, sucesso, alerta, perigo</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#0C5CAB</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#0A4A8A</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#10B981</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#F59E0B</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#EF4444</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#09090B</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#FAFAFA</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#09090B</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#0C5CAB) para dar ênfase aos CTAs.</li><li>Use a Superfície (#09090B) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#FAFAFA) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> 12/14/16/20/24/32</li><li><strong>Famílias:</strong> primary=IBM Plex Sans, display=IBM Plex Sans, mono=IBM Plex Sans</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> grid de linha de base de 8pt</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#0C5CAB</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#0C5CAB) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}