e":"--radius-lg","value":"24px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 22px 58px rgba(17, 24, 39, 0.11)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(79, 70, 229, 0.24)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.22, 1, 0.36, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#767efe","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 60%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 75%, var(--fg))","--danger-fg":"#111111","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.25rem","--fs-h1":"3.375rem","--fs-hero":"4.75rem","--lh-body":"1.52","--lh-tight":"1.05","--display-tracking":"-0.025em","--section-y":"104px","--section-y-tablet":"72px","--container-max":"1180px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"240ms","--ease":"cubic-bezier(0.22, 1, 0.36, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 4px rgba(79, 70, 229, 0.24)","--bg":"#f7f8fc","--surface":"#ffffff","--surface-2":"#eef1ff","--fg":"#111827","--fg-soft":"#374151","--muted":"color-mix(in oklab, #6b7280 90%, var(--fg))","--meta":"#4f46e5","--border":"#dfe3ed","--border-soft":"#eef1f7","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#4f46e5","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#4f46e5","--solid-hover":"#443cc7","--solid-fg":"#ffffff","--ok":"#10b981","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f59e0b","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ef4444","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 22px 58px rgba(17, 24, 39, 0.11)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"IBM Plex Serif\", sans-serif","--font-body":"\"IBM Plex Serif\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Contemporary editorial style with serif typography, minimal palettes, and clean layouts for polished digital products.</p>\n<ul><li><strong>Visual style:</strong> modern, minimal, clean, editorial</li><li><strong>Color stance:</strong> primary, secondary</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#553F83</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#111111</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#553F83</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#FFFFFF</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#553F83</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#553F83) for CTA emphasis.</li><li>Use Surface (#553F83) for large backgrounds and cards.</li><li>Keep body copy on Text (#FFFFFF) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> 12/14/16/20/24/32</li><li><strong>Families:</strong> primary=IBM Plex Serif, display=IBM Plex Serif, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#553F83</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#553F83) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}