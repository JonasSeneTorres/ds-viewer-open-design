{"lang":"pt-BR","message":"Corpo"}],"kind":"body","family":"CoinbaseSans","fallbacks":[],"stack":"\"CoinbaseSans\", sans-serif","italic":false,"source":null},{"proprietary":true,"role":[{"lang":"pt-BR","message":"Corpo"}],"kind":"body","family":"CoinbaseText","fallbacks":[],"stack":"\"CoinbaseText\", sans-serif","italic":false,"source":null},{"proprietary":false,"role":[{"lang":"en-US","message":"Icons"}],"kind":"primary","family":"CoinbaseIcons","fallbacks":[],"stack":"\"CoinbaseIcons\", sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"pt-BR","message":"Superfície"}],"items":[{"name":"--bg","value":"#ffffff"},{"name":"--surface","value":"#eef0f3"},{"name":"--surface-warm","value":"var(--surface)"}]},{"group":[{"lang":"pt-BR","message":"Texto"}],"items":[{"name":"--fg","value":"#0a0b0d"},{"name":"--fg-2","value":"var(--fg)"},{"name":"--muted","value":"#5b616e"},{"name":"--meta","value":"var(--muted)"}]},{"group":[{"lang":"pt-BR","message":"Borda"}],"items":[{"name":"--border","value":"rgba(91, 97, 110, 0.2)"},{"name":"--border-soft","value":"var(--border)"}]},{"group":[{"lang":"pt-BR","message":"Destaque"}],"items":[{"name":"--accent","value":"#0052ff"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"#578bfa"},{"name":"--accent-active","value":"#0667d0"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#16a34a"},{"name":"--warn","value":"#eab308"},{"name":"--danger","value":"#dc2626"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"18px"},{"name":"--text-xl","value":"32px"},{"name":"--text-2xl","value":"36px"},{"name":"--text-3xl","value":"52px"},{"name":"--text-4xl","value":"80px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.0"},{"name":"--tracking-display","value":"-0.01em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"40px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"32px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 1px 2px color-mix(in oklab, var(--fg), transparent 92%)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 2px var(--fg)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#578bfa","--primary-500-fg":"#111111","--neutral-400":"#a9abae","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.75rem","--fs-h2":"2.25rem","--fs-h1":"3.25rem","--fs-hero":"5rem","--lh-body":"1.5","--lh-tight":"1.05","--display-tracking":"-0.01em","--section-y":"96px","--section-y-tablet":"64px","--container-max":"1280px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"28px","--focus-ring":"0 0 0 2px var(--fg)","--bg":"#ffffff","--surface":"#eef0f3","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#0a0b0d","--fg-soft":"#0a0b0d","--muted":"#5b616e","--meta":"#5b616e","--border":"rgba(91, 97, 110, 0.2)","--border-soft":"rgba(91, 97, 110, 0.2)","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#0052ff","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#0052ff","--solid-hover":"#0046de","--solid-fg":"#ffffff","--ok":"#16a34a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 1px 2px color-mix(in oklab, var(--fg), transparent 92%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"CoinbaseDisplay\", sans-serif","--font-body":"\"CoinbaseSans\", sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>O site da Coinbase é uma plataforma cripto limpa e confiável, que comunica solidez financeira por meio de uma paleta binária de azul e branco. O design usa o Coinbase Blue (<code>#0052ff</code>) — um azul profundo e saturado — como único destaque da marca sobre superfícies brancas e quase pretas. A família tipográfica proprietária inclui a CoinbaseDisplay para títulos de hero, a CoinbaseSans para texto de interface, a CoinbaseText para leitura e a CoinbaseIcons para a iconografia — um sistema completo de quatro fontes.</p>\n<p>O sistema de botões usa um raio característico de 56px para CTAs em formato de pílula, com transição no hover para um azul mais claro (<code>#578bfa</code>). O design alterna seções de conteúdo brancas com seções de recursos escuras (<code>#0a0b0d</code>, <code>#282b31</code>), criando uma interface profissional, de padrão financeiro.</p>\n<p><strong>Características principais:</strong></p>\n<ul><li>Coinbase Blue (<code>#0052ff</code>) como único destaque da marca</li><li>Família proprietária de quatro fontes: Display, Sans, Text, Icons</li><li>Botões em pílula com raio de 56px e transição azul no hover</li><li>Seções escuras quase pretas (<code>#0a0b0d</code>) + seções claras brancas</li><li>Altura de linha 1.00 nos títulos de display — extremamente justa</li><li>Superfície secundária cinza fria (<code>#eef0f3</code>) com toque azulado</li><li><code>text-transform: lowercase</code> em alguns rótulos de botão — algo incomum</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<h3>Primárias</h3>\n<ul><li><strong>Coinbase Blue</strong> (<code>#0052ff</code>): cor principal da marca, links, bordas de CTAs</li><li><strong>Pure White</strong> (<code>#ffffff</code>): superfície clara principal</li><li><strong>Near Black</strong> (<code>#0a0b0d</code>): texto, fundos das seções escuras</li><li><strong>Cool Gray Surface</strong> (<code>#eef0f3</code>): fundo de botões secundários</li></ul>\n<h3>Interativas</h3>\n<ul><li><strong>Hover Blue</strong> (<code>#578bfa</code>): fundo de botões no hover</li><li><strong>Link Blue</strong> (<code>#0667d0</code>): cor de links secundários</li><li><strong>Muted Blue</strong> (<code>#5b616e</code>): cor de borda a 20% de opacidade</li></ul>\n<h3>Superfícies</h3>\n<ul><li><strong>Dark Card</strong> (<code>#282b31</code>): fundos escuros de botões/cards</li><li><strong>Light Surface</strong> (<code>rgba(247,247,247,0.88)</code>): superfície sutil</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<h3>Famílias tipográficas</h3>\n<ul><li><strong>Display</strong>: <code>CoinbaseDisplay</code> — títulos de hero</li><li><strong>Interface / Sans</strong>: <code>CoinbaseSans</code> — botões, títulos, navegação</li><li><strong>Corpo</strong>: <code>CoinbaseText</code> — texto de leitura</li><li><strong>Ícones</strong>: <code>CoinbaseIcons</code> — fonte de ícones</li></ul>\n<h3>Hierarquia</h3>\n<table><thead><tr><th>Papel</th><th>Fonte</th><th>Tamanho</th><th>Peso</th><th>Altura da linha</th><th>Observações</th></tr></thead><tbody><tr><td>Display Hero</td><td>CoinbaseDisplay</td><td>80px</td><td>400</td><td>1.00 (justa)</td><td>Impacto máximo</td></tr><tr><td>Display secundário</td><td>CoinbaseDisplay</td><td>64px</td><td>400</td><td>1.00</td><td>Sub-hero</td></tr><tr><td>Display terciário</td><td>CoinbaseDisplay</td><td>52px</td><td>400</td><td>1.00</td><td>Terceiro nível</td></tr><tr><td>Título de seção</td><td>CoinbaseSans</td><td>36px</td><td>400</td><td>1.11 (justa)</td><td>Seções de recursos</td></tr><tr><td>Título de card</td><td>CoinbaseSans</td><td>32px</td><td>400</td><td>1.13</td><td>Títulos de cards</td></tr><tr><td>Título de recurso</td><td>CoinbaseSans</td><td>18px</td><td>600</td><td>1.33</td><td>Ênfase em recursos</td></tr><tr><td>Corpo negrito</td><td>CoinbaseSans</td><td>16px</td><td>700</td><td>1.50</td><td>Corpo forte</td></tr><tr><td>Corpo seminegrito</td><td>CoinbaseSans</td><td>16px</td><td>600</td><td>1.25</td><td>Botões, navegação</td></tr><tr><td>Corpo</td><td>CoinbaseText</td><td>18px</td><td>400</td><td>1.56</td><td>Leitura padrão</td></tr><tr><td>Corpo pequeno</td><td>CoinbaseText</td><td>16px</td><td>400</td><td>1.50</td><td>Leitura secundária</td></tr><tr><td>Botão</td><td>CoinbaseSans</td><td>16px</td><td>600</td><td>1.20</td><td>Tracking de +0.16px</td></tr><tr><td>Legenda</td><td>CoinbaseSans</td><td>14px</td><td>600–700</td><td>1.50</td><td>Metadados</td></tr><tr><td>Pequeno</td><td>CoinbaseSans</td><td>13px</td><td>600</td><td>1.23</td><td>Tags</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<h3>Botões</h3>\n<p><strong>Pílula primária (raio de 56px)</strong></p>\n<ul><li>Fundo: <code>#eef0f3</code> ou <code>#282b31</code></li><li>Raio: 56px</li><li>Borda: <code>1px solid</code> na mesma cor do fundo</li><li>Hover: <code>#578bfa</code> (azul claro)</li><li>Foco: contorno <code>2px solid black</code></li></ul>\n<p><strong>Pílula completa (raio de 100000px)</strong></p>\n<ul><li>Usada para o formato de pílula máximo</li></ul>\n<p><strong>Borda azul</strong></p>\n<ul><li>Borda: <code>1px solid #0052ff</code></li><li>Fundo: transparente</li></ul>\n<h3>Cards e contêineres</h3>\n<ul><li>Raio: faixa de 8px–40px</li><li>Bordas: <code>1px solid rgba(91,97,110,0.2)</code></li></ul>"}]},{"id":"layout-principles","title":[{"lang":"pt-BR","message":"Princípios de layout"}],"html":[{"lang":"pt-BR","message":"<h3>Sistema de espaçamento</h3>\n<ul><li>Base: 8px</li><li>Escala: 1px, 3px, 4px, 5px, 6px, 8px, 10px, 12px, 15px, 16px, 20px, 24px, 25px, 32px, 48px</li></ul>\n<h3>Escala de raios de borda</h3>\n<ul><li>Pequeno (4px–8px): links de artigos, cards pequenos</li><li>Padrão (12px–16px): cards, menus</li><li>Grande (24px–32px): contêineres de recursos</li><li>XL (40px): botões/contêineres grandes</li><li>Pílula (56px): CTAs principais</li><li>Completo (100000px): pílula máxima</li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"pt-BR","message":"Profundidade e elevação"}],"html":[{"lang":"pt-BR","message":"<p>Sistema de sombras mínimo — a profundidade vem do contraste de cor entre seções escuras e claras.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<h3>Faça</h3>\n<ul><li>Use o Coinbase Blue (#0052ff) nos elementos interativos principais</li><li>Aplique raio de 56px em todos os botões de CTA</li><li>Use a CoinbaseDisplay apenas nos títulos de hero</li><li>Alterne seções escuras (#0a0b0d) e brancas</li></ul>\n<h3>Não faça</h3>\n<ul><li>Não use o azul de forma decorativa — ele é apenas funcional</li><li>Não use cantos vivos nos CTAs — 56px no mínimo</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<p>Breakpoints: 400px, 576px, 640px, 768px, 896px, 1280px, 1440px, 1600px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<h3>Referência rápida de cores</h3>\n<ul><li>Marca: Coinbase Blue (<code>#0052ff</code>)</li><li>Fundo: White (<code>#ffffff</code>)</li><li>Superfície escura: <code>#0a0b0d</code></li><li>Superfície secundária: <code>#eef0f3</code></li><li>Hover: <code>#578bfa</code></li><li>Texto: <code>#0a0b0d</code></li></ul>\n<h3>Exemplos de prompts de componentes</h3>\n<ul><li>&quot;Crie um hero: fundo branco. CoinbaseDisplay 80px, line-height 1.00. CTA em pílula (#eef0f3, raio de 56px). Hover: #578bfa.&quot;</li><li>&quot;Construa uma seção escura: fundo #0a0b0d. CoinbaseDisplay 64px em texto branco. Link de destaque azul (#0052ff).&quot;</li></ul>"}]}]}