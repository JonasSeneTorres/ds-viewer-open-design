lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"180ms"},{"name":"--motion-base","value":"280ms"},{"name":"--ease-standard","value":"cubic-bezier(0.22, 1, 0.36, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1120px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"light","--primary-500":"#c9822f","--primary-500-fg":"#111111","--neutral-400":"#acaaa9","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 65%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1.125rem","--fs-h3":"1.75rem","--fs-h2":"2.75rem","--fs-h1":"4rem","--fs-hero":"5.75rem","--lh-body":"1.65","--lh-tight":"1.05","--display-tracking":"-0.02em","--section-y":"112px","--section-y-tablet":"80px","--container-max":"1120px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"180ms","--motion-base":"280ms","--ease":"cubic-bezier(0.22, 1, 0.36, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 4px rgba(154, 90, 47, 0.24)","--bg":"#fbf7f0","--surface":"#fffdf8","--surface-2":"#f1e6d6","--fg":"#1f1a16","--fg-soft":"#4b4038","--muted":"color-mix(in oklab, #7d7168 80%, var(--fg))","--meta":"color-mix(in oklab, #9a5a2f 90%, var(--fg))","--border":"#ded3c5","--border-soft":"#eee5da","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#9a5a2f","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#9a5a2f","--solid-hover":"#854d27","--solid-fg":"#ffffff","--ok":"#4f8a4f","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#c9822f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#b33a3a","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 20px 50px rgba(31, 26, 22, 0.12)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Gelasio\", sans-serif","--font-body":"\"Gelasio\", sans-serif","--font-code":"\"Ubuntu Mono\", monospace","--font-mono":"\"Ubuntu Mono\", monospace","--heading-weight":"600","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Layout editorial inspirado em revistas, com tipografia serifada refinada, grids estruturados e experiências de leitura elegantes.</p>\n<ul><li><strong>Estilo visual:</strong> moderno, editorial</li><li><strong>Postura de cor:</strong> primária, secundária, neutra, sucesso</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#111111</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#F1F1F1</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#16A34A</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#D97706</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#DC2626</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#FFFFFF</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#111827</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#FFFFFF</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#111111) para dar ênfase aos CTAs.</li><li>Use a Superfície (#FFFFFF) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#111827) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> 14/16/18/24/32/40</li><li><strong>Famílias:</strong> primary=Gelasio, display=Gelasio, mono=Ubuntu Mono</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> grid de linha de base de 8pt</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#111111</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#111111) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}