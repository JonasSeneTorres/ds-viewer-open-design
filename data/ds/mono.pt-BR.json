"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"100ms"},{"name":"--motion-base","value":"180ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#00a63d","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 85%, var(--fg))","--ok-fg":"#ffffff","--warn-ink":"color-mix(in oklab, var(--warn) 75%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.25rem","--fs-h2":"1.75rem","--fs-h1":"2.5rem","--fs-hero":"3.5rem","--lh-body":"1.45","--lh-tight":"1.06","--display-tracking":"-0.025em","--section-y":"80px","--section-y-tablet":"60px","--container-max":"1280px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"100ms","--motion-base":"180ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 3px rgba(17, 17, 17, 0.18)","--bg":"#ffffff","--surface":"#f7f7f7","--surface-2":"#eeeeee","--fg":"#111111","--fg-soft":"#3a3a3a","--muted":"color-mix(in oklab, #707070 80%, var(--fg))","--meta":"#111111","--border":"#d9d9d9","--border-soft":"#eeeeee","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#111111","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#111111","--solid-hover":"#0d0d0d","--solid-fg":"#ffffff","--ok":"#168a46","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#b7791f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#c53030","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 16px 40px rgba(0, 0, 0, 0.10)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Space Mono\", sans-serif","--font-body":"\"Space Mono\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"400","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Design guiado por fontes monoespaçadas e inspirado em Matrix, com elementos de alto contraste, densidade compacta e estética hacker-chic.</p>\n<ul><li><strong>Estilo visual:</strong> minimalista, limpo, alto contraste, lúdico, matrix</li><li><strong>Postura de cor:</strong> primária, secundária, sucesso, alerta, perigo, informação</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#37F712</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#00A6F4</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#00A63D</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#FE9900</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#FF2157</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#E7E5E4</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#78716B</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#E7E5E4</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#37F712) para dar ênfase aos CTAs.</li><li>Use a Superfície (#E7E5E4) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#78716B) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> escala expressiva desktop-first</li><li><strong>Famílias:</strong> primary=Space Mono, display=Space Mono, mono=JetBrains Mono</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> modo de densidade compacta</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#37F712</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#37F712) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}