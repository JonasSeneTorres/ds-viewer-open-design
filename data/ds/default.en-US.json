t","value":"1.2"},{"name":"--tracking-display","value":"-0.01em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"80px"},{"name":"--section-y-tablet","value":"48px"},{"name":"--section-y-phone","value":"32px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"12px"},{"name":"--radius-lg","value":"16px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 2px 8px color-mix(in oklab, var(--fg), transparent 92%)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1200px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"12px"}]}],"vars":{"color-scheme":"light","--primary-500":"#4c89fe","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 70%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2rem","--fs-h1":"3rem","--fs-hero":"4rem","--lh-body":"1.5","--lh-tight":"1.2","--display-tracking":"-0.01em","--section-y":"80px","--section-y-tablet":"48px","--container-max":"1200px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"12px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"16px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--bg":"#fafafa","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111111","--fg-soft":"#111111","--muted":"color-mix(in oklab, #6b6b6b 95%, var(--fg))","--meta":"color-mix(in oklab, #6b6b6b 95%, var(--fg))","--border":"#e5e5e5","--border-soft":"#e5e5e5","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#2f6feb","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#2f6feb","--solid-hover":"#2760cc","--solid-fg":"#ffffff","--ok":"#17a34a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 2px 8px color-mix(in oklab, var(--fg), transparent 92%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Inter\", -apple-system, system-ui, sans-serif","--font-body":"\"Inter\", -apple-system, system-ui, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Calm, functional, quietly confident. No ornament. Content-first, chrome-second.</p>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Background:</strong> <code>#FAFAFA</code></li><li><strong>Foreground:</strong> <code>#111111</code></li><li><strong>Accent:</strong> <code>#2F6FEB</code> (cobalt) — primary CTAs, links, one hero element per screen</li><li><strong>Muted:</strong> <code>#6B6B6B</code> — secondary text, captions</li><li><strong>Border:</strong> <code>#E5E5E5</code></li><li><strong>Surface:</strong> <code>#FFFFFF</code> — cards, modals</li><li><strong>Success:</strong> <code>#17A34A</code>, <strong>Warn:</strong> <code>#EAB308</code>, <strong>Danger:</strong> <code>#DC2626</code></li></ul>\n<p>Never pure black; never pure white for backgrounds.</p>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Display / headings:</strong> <code>'Inter', -apple-system, system-ui, sans-serif</code>, weight 600</li><li><strong>Body:</strong> <code>'Inter', -apple-system, system-ui, sans-serif</code>, weight 400</li><li><strong>Mono:</strong> <code>ui-monospace, 'JetBrains Mono', monospace</code></li><li>Scale (px): 12 · 14 · 16 · 20 · 24 · 32 · 48 · 64</li><li>Line-height: 1.5 for body, 1.2 for headings</li><li>Letter-spacing: -0.01em on display sizes ≥32px</li></ul>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Buttons:</strong> 8px radius, 10px padding-block, 16px padding-inline. Primary = cobalt fill, white label. Secondary = 1px border, transparent fill.</li><li><strong>Cards:</strong> white, 1px border, 12px radius, 20px internal padding, no shadow by default.</li><li><strong>Inputs:</strong> 1px border, 8px radius, 10px vertical padding, cobalt border on focus.</li><li><strong>Links:</strong> cobalt, no underline, underline on hover.</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"en-US","message":"Layout Principles"}],"html":[{"lang":"en-US","message":"<ul><li>12-column grid, 1200px max-width, 24px gutters.</li><li>Hero: 40–60vh. Content top-biased, never centered vertically.</li><li>Sections: 80px top+bottom spacing desktop, 48px tablet, 32px phone.</li><li>Use whitespace as the main separator. Dividers only between unrelated top-level sections.</li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"en-US","message":"Depth & Elevation"}],"html":[{"lang":"en-US","message":"<p>Two levels only:</p>\n<ul><li><strong>Flat (0):</strong> default.</li><li><strong>Raised (1):</strong> dropdowns, modals, floating buttons. 2px y-offset, 8px blur, foreground at 8% opacity.</li></ul>\n<p>No neumorphism, no glassmorphism.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<ul><li>✅ Let whitespace do the work.</li><li>✅ One accent element per screen.</li><li>✅ Sentence-case headings by default; title case only for brand names.</li><li>❌ No gradients (except the accent → accent-at-80% on a hero, sparingly).</li><li>❌ No drop shadows on inputs.</li><li>❌ No more than three type sizes on one screen.</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Desktop ≥ 1024px:</strong> 12-col grid.</li><li><strong>Tablet 640–1023px:</strong> 8-col grid, 16px gutters.</li><li><strong>Phone &lt; 640px:</strong> 4-col grid, 12px gutters; hero drops to 40vh.</li></ul>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<ul><li>When in doubt, subtract. Fewer boxes, less chrome, more space.</li><li>Use the accent color sparingly — at most one hero accent and one CTA accent per screen.</li><li>Do not invent hex values outside this palette. If the request needs one, surface a warning comment in the artifact and use the closest existing token.</li></ul>"}]}]}