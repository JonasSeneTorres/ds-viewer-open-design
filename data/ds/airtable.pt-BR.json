n-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--bg":"#ffffff","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#181d26","--fg-soft":"#333333","--muted":"color-mix(in oklab, var(--fg) 65%, var(--bg))","--meta":"var(--muted)","--border":"#e0e2e6","--border-soft":"#eef0f3","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#1b61c9","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#1b61c9","--solid-hover":"#254fad","--solid-fg":"#ffffff","--ok":"#006400","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"12px","--radius-pill":"9999px","--shadow-card":"0 0 1px rgba(0, 0, 0, 0.32), 0 0 2px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(45, 127, 249, 0.28), inset 0 0 0 0.5px rgba(0, 0, 0, 0.06)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Haas Groot Disp\", Haas, sans-serif","--font-body":"\"Haas\", -apple-system, system-ui, \"Segoe UI\", Roboto, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>O site da Airtable é uma plataforma limpa e amigável ao mundo corporativo, que comunica &quot;simplicidade sofisticada&quot; por meio de uma tela branca com texto azul-marinho profundo (<code>#181d26</code>) e o Airtable Blue (<code>#1b61c9</code>) como principal destaque interativo. A família tipográfica Haas (variantes de display + texto) cria um sistema tipográfico de precisão suíça, com espaçamento entre letras positivo em todo lugar.</p>\n<p><strong>Características principais:</strong></p>\n<ul><li>Tela branca com texto azul-marinho profundo (<code>#181d26</code>)</li><li>Airtable Blue (<code>#1b61c9</code>) como cor principal de CTAs e links</li><li>Sistema de duas fontes: Haas + Haas Groot Disp</li><li>Espaçamento entre letras positivo no texto de corpo (0.08px–0.28px)</li><li>Botões com raio de 12px, 16px–32px nos cards</li><li>Sombra em várias camadas tingida de azul: <code>rgba(45,127,249,0.28) 0px 1px 3px</code></li><li>Tokens semânticos de tema: variáveis CSS nomeadas como <code>--theme_*</code></li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<h3>Primárias</h3>\n<ul><li><strong>Deep Navy</strong> (<code>#181d26</code>): texto principal</li><li><strong>Airtable Blue</strong> (<code>#1b61c9</code>): botões de CTA, links</li><li><strong>White</strong> (<code>#ffffff</code>): superfície principal</li><li><strong>Spotlight</strong> (<code>rgba(249,252,255,0.97)</code>): <code>--theme_button-text-spotlight</code></li></ul>\n<h3>Semânticas</h3>\n<ul><li><strong>Success Green</strong> (<code>#006400</code>): <code>--theme_success-text</code></li><li><strong>Weak Text</strong> (<code>rgba(4,14,32,0.69)</code>): <code>--theme_text-weak</code></li><li><strong>Secondary Active</strong> (<code>rgba(7,12,20,0.82)</code>): <code>--theme_button-text-secondary-active</code></li></ul>\n<h3>Neutras</h3>\n<ul><li><strong>Dark Gray</strong> (<code>#333333</code>): texto secundário</li><li><strong>Mid Blue</strong> (<code>#254fad</code>): variante azul de link/destaque</li><li><strong>Border</strong> (<code>#e0e2e6</code>): bordas de cards</li><li><strong>Light Surface</strong> (<code>#f8fafc</code>): superfície sutil</li></ul>\n<h3>Sombras</h3>\n<ul><li><strong>Tingida de azul</strong> (<code>rgba(0,0,0,0.32) 0px 0px 1px, rgba(0,0,0,0.08) 0px 0px 2px, rgba(45,127,249,0.28) 0px 1px 3px, rgba(0,0,0,0.06) 0px 0px 0px 0.5px inset</code>)</li><li><strong>Suave</strong> (<code>rgba(15,48,106,0.05) 0px 0px 20px</code>)</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<h3>Famílias tipográficas</h3>\n<ul><li><strong>Principal</strong>: <code>Haas</code>, fallbacks: <code>-apple-system, system-ui, Segoe UI, Roboto</code></li><li><strong>Display</strong>: <code>Haas Groot Disp</code>, fallback: <code>Haas</code></li></ul>\n<h3>Hierarquia</h3>\n<table><thead><tr><th>Papel</th><th>Fonte</th><th>Tamanho</th><th>Peso</th><th>Altura da linha</th><th>Espaçamento entre letras</th></tr></thead><tbody><tr><td>Display Hero</td><td>Haas</td><td>48px</td><td>400</td><td>1.15</td><td>normal</td></tr><tr><td>Display negrito</td><td>Haas Groot Disp</td><td>48px</td><td>900</td><td>1.50</td><td>normal</td></tr><tr><td>Título de seção</td><td>Haas</td><td>40px</td><td>400</td><td>1.25</td><td>normal</td></tr><tr><td>Subtítulo</td><td>Haas</td><td>32px</td><td>400–500</td><td>1.15–1.25</td><td>normal</td></tr><tr><td>Título de card</td><td>Haas</td><td>24px</td><td>400</td><td>1.20–1.30</td><td>0.12px</td></tr><tr><td>Destaque</td><td>Haas</td><td>20px</td><td>400</td><td>1.25–1.50</td><td>0.1px</td></tr><tr><td>Corpo</td><td>Haas</td><td>18px</td><td>400</td><td>1.35</td><td>0.18px</td></tr><tr><td>Corpo médio</td><td>Haas</td><td>16px</td><td>500</td><td>1.30</td><td>0.08–0.16px</td></tr><tr><td>Botão</td><td>Haas</td><td>16px</td><td>500</td><td>1.25–1.30</td><td>0.08px</td></tr><tr><td>Legenda</td><td>Haas</td><td>14px</td><td>400–500</td><td>1.25–1.35</td><td>0.07–0.28px</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<h3>Botões</h3>\n<ul><li><strong>Azul primário</strong>: <code>#1b61c9</code>, texto branco, padding de 16px 24px, raio de 12px</li><li><strong>Branco</strong>: fundo branco, texto <code>#181d26</code>, raio de 12px, borda branca de 1px</li><li><strong>Consentimento de cookies</strong>: fundo <code>#1b61c9</code>, raio de 2px (canto vivo)</li></ul>\n<h3>Cards: <code>1px solid #e0e2e6</code>, raio de 16px–24px</h3>\n<h3>Campos: estilo Haas padrão</h3>"}]},{"id":"layout","title":[{"lang":"pt-BR","message":"Layout"}],"html":[{"lang":"pt-BR","message":"<ul><li>Espaçamento: 1–48px (base de 8px)</li><li>Raio: 2px (pequeno), 12px (botões), 16px (cards), 24px (seções), 32px (grande), 50% (círculos)</li></ul>"}]},{"id":"depth","title":[{"lang":"pt-BR","message":"Profundidade"}],"html":[{"lang":"pt-BR","message":"<ul><li>Sistema de sombras em várias camadas tingido de azul</li><li>Ambiente suave: <code>rgba(15,48,106,0.05) 0px 0px 20px</code></li></ul>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<h3>Faça: use o Airtable Blue nos CTAs, Haas com tracking positivo, botões com raio de 12px</h3>\n<h3>Não faça: abrir mão do espaçamento entre letras positivo, usar sombras pesadas</h3>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<p>Breakpoints: 425–1664px (23 breakpoints)</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Texto: Deep Navy (<code>#181d26</code>)</li><li>CTA: Airtable Blue (<code>#1b61c9</code>)</li><li>Fundo: White (<code>#ffffff</code>)</li><li>Borda: <code>#e0e2e6</code></li></ul>"}]}]}