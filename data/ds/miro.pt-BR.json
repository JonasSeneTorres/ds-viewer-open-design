,{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#1a7f37"},{"name":"--warn","value":"#ff9f1c"},{"name":"--danger","value":"#d92d20"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"18px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"38px"},{"name":"--text-3xl","value":"56px"},{"name":"--text-4xl","value":"76px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.02"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"104px"},{"name":"--section-y-tablet","value":"72px"},{"name":"--section-y-phone","value":"52px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"18px"},{"name":"--radius-lg","value":"28px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 16px 40px rgba(5, 0, 56, 0.14)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(255, 208, 47, 0.38)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"230ms"},{"name":"--ease-standard","value":"cubic-bezier(0.22, 1, 0.36, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1220px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"28px"},{"name":"--container-gutter-phone","value":"18px"}]}],"vars":{"--primary-500":"#ad8b0d","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 90%, var(--fg))","--ok-fg":"#ffffff","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 85%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.375rem","--fs-h1":"3.5rem","--fs-hero":"4.75rem","--lh-body":"1.5","--lh-tight":"1.05","--display-tracking":"-0.025em","--section-y":"104px","--section-y-tablet":"72px","--container-max":"1220px","--gutter":"36px","--gutter-tablet":"28px","--gutter-phone":"18px","--motion-fast":"150ms","--motion-base":"230ms","--ease":"cubic-bezier(0.22, 1, 0.36, 1)","--radius-lg":"28px","--focus-ring":"0 0 0 4px rgba(255, 208, 47, 0.38)","--bg":"#fff7c2","--surface":"#ffffff","--surface-2":"#fff3a3","--fg":"#050038","--fg-soft":"#322b6b","--muted":"#605a8a","--meta":"color-mix(in oklab, #f7c600 50%, var(--fg))","--border":"#ded9ff","--border-soft":"#eeeaff","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ffd02f","--accent-strong":"color-mix(in oklab, var(--accent) 50%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#050038","--solid":"#ffd02f","--solid-hover":"#ffd553","--solid-fg":"#050038","--ok":"#1a7f37","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ff9f1c","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#d92d20","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"18px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 16px 40px rgba(5, 0, 56, 0.14)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Roobert PRO Medium\", blwf, cv03, cv04, cv09, cv11, sans-serif","--font-body":"\"Noto Sans\", \"liga\" 0\", ss01, ss04, ss05, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>O site da Miro é uma plataforma limpa, centrada na ferramenta de colaboração, que comunica &quot;pensamento visual&quot; por meio de espaço em branco generoso, cores de destaque em tons pastel e uma fonte geométrica confiante. O design usa uma tela predominantemente branca com texto quase preto (<code>#1c1c1e</code>) e uma paleta pastel característica — coral, rosa, verde-azulado, laranja, amarelo, musgo — em que cada cor representa um contexto de colaboração diferente.</p>\n<p>A tipografia usa a Roobert PRO Medium como fonte principal de display, com variantes de caracteres OpenType (<code>&quot;blwf&quot;, &quot;cv03&quot;, &quot;cv04&quot;, &quot;cv09&quot;, &quot;cv11&quot;</code>) e espaçamento entre letras negativo (-1.68px em 56px). A Noto Sans cuida do texto de corpo com seu próprio conjunto estilístico (<code>&quot;liga&quot; 0, &quot;ss01&quot;, &quot;ss04&quot;, &quot;ss05&quot;</code>). O site é construído com Framer, o que lhe dá animações suaves e padrões de componentes modernos.</p>\n<p><strong>Características principais:</strong></p>\n<ul><li>Tela branca com texto quase preto (<code>#1c1c1e</code>)</li><li>Roobert PRO Medium com várias variantes de caracteres OpenType</li><li>Paleta de destaques em tons pastel: coral, rosa, verde-azulado, laranja, amarelo, musgo (pares claro + escuro)</li><li>Blue 450 (<code>#5b76fe</code>) como cor interativa principal</li><li>Verde de sucesso (<code>#00b473</code>) para estados positivos</li><li>Border-radius generoso: faixa de 8px–50px</li><li>Construído em Framer, com padrões de movimento suaves</li><li>Borda por sombra em anel: <code>rgb(224,226,232) 0px 0px 0px 1px</code></li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<h3>Primárias</h3>\n<ul><li><strong>Near Black</strong> (<code>#1c1c1e</code>): texto principal</li><li><strong>White</strong> (<code>#ffffff</code>): <code>--tw-color-white</code>, superfície principal</li><li><strong>Blue 450</strong> (<code>#5b76fe</code>): <code>--tw-color-blue-450</code>, interativa principal</li><li><strong>Actionable Pressed</strong> (<code>#2a41b6</code>): <code>--tw-color-actionable-pressed</code></li></ul>\n<h3>Destaques pastel (pares claro/escuro)</h3>\n<ul><li><strong>Coral</strong>: claro <code>#ffc6c6</code> / escuro <code>#600000</code></li><li><strong>Rose</strong>: claro <code>#ffd8f4</code> / escuro (implícito)</li><li><strong>Teal</strong>: claro <code>#c3faf5</code> / escuro <code>#187574</code></li><li><strong>Orange</strong>: claro <code>#ffe6cd</code></li><li><strong>Yellow</strong>: escuro <code>#746019</code></li><li><strong>Moss</strong>: escuro <code>#187574</code></li><li><strong>Pink</strong> (<code>#fde0f0</code>): superfície rosa suave</li><li><strong>Red</strong> (<code>#fbd4d4</code>): superfície vermelha clara</li><li><strong>Dark Red</strong> (<code>#e3c5c5</code>): vermelho esmaecido</li></ul>\n<h3>Semânticas</h3>\n<ul><li><strong>Success</strong> (<code>#00b473</code>): <code>--tw-color-success-accent</code></li></ul>\n<h3>Neutras</h3>\n<ul><li><strong>Slate</strong> (<code>#555a6a</code>): texto secundário</li><li><strong>Input Placeholder</strong> (<code>#a5a8b5</code>): <code>--tw-color-input-placeholder</code></li><li><strong>Border</strong> (<code>#c7cad5</code>): bordas de botões</li><li><strong>Ring</strong> (<code>rgb(224,226,232)</code>): sombra como borda</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<h3>Famílias tipográficas</h3>\n<ul><li><strong>Display</strong>: <code>Roobert PRO Medium</code>, fallback: Placeholder — <code>&quot;blwf&quot;, &quot;cv03&quot;, &quot;cv04&quot;, &quot;cv09&quot;, &quot;cv11&quot;</code></li><li><strong>Variantes de display</strong>: <code>Roobert PRO SemiBold</code>, <code>Roobert PRO SemiBold Italic</code>, <code>Roobert PRO</code></li><li><strong>Corpo</strong>: <code>Noto Sans</code> — <code>&quot;liga&quot; 0, &quot;ss01&quot;, &quot;ss04&quot;, &quot;ss05&quot;</code></li></ul>\n<h3>Hierarquia</h3>\n<table><thead><tr><th>Papel</th><th>Fonte</th><th>Tamanho</th><th>Peso</th><th>Altura da linha</th><th>Espaçamento entre letras</th></tr></thead><tbody><tr><td>Display Hero</td><td>Roobert PRO Medium</td><td>56px</td><td>400</td><td>1.15</td><td>-1.68px</td></tr><tr><td>Título de seção</td><td>Roobert PRO Medium</td><td>48px</td><td>400</td><td>1.15</td><td>-1.44px</td></tr><tr><td>Título de card</td><td>Roobert PRO Medium</td><td>24px</td><td>400</td><td>1.15</td><td>-0.72px</td></tr><tr><td>Subtítulo</td><td>Noto Sans</td><td>22px</td><td>400</td><td>1.35</td><td>-0.44px</td></tr><tr><td>Destaque</td><td>Roobert PRO Medium</td><td>18px</td><td>600</td><td>1.35</td><td>normal</td></tr><tr><td>Corpo</td><td>Noto Sans</td><td>18px</td><td>400</td><td>1.45</td><td>normal</td></tr><tr><td>Corpo padrão</td><td>Noto Sans</td><td>16px</td><td>400–600</td><td>1.50</td><td>-0.16px</td></tr><tr><td>Botão</td><td>Roobert PRO Medium</td><td>17.5px</td><td>700</td><td>1.29</td><td>0.175px</td></tr><tr><td>Legenda</td><td>Roobert PRO Medium</td><td>14px</td><td>400</td><td>1.71</td><td>normal</td></tr><tr><td>Pequeno</td><td>Roobert PRO Medium</td><td>12px</td><td>400</td><td>1.15</td><td>-0.36px</td></tr><tr><td>Micro em caixa-alta</td><td>Roobert PRO</td><td>10.5px</td><td>400</td><td>0.90</td><td>caixa-alta</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<h3>Botões</h3>\n<ul><li>Com contorno: fundo transparente, <code>1px solid #c7cad5</code>, raio de 8px, padding de 7px 12px</li><li>Círculo branco: raio de 50%, fundo branco com sombra</li><li>Azul primário (implícito a partir da cor interativa)</li></ul>\n<h3>Cards: raio de 12px–24px, fundos em tons pastel</h3>\n<h3>Campos: fundo branco, <code>1px solid #e9eaef</code>, raio de 8px, padding de 16px</h3>"}]},{"id":"layout-principles","title":[{"lang":"pt-BR","message":"Princípios de layout"}],"html":[{"lang":"pt-BR","message":"<ul><li>Espaçamento: escala base de 1–24px</li><li>Raio: 8px (botões), 10px–12px (cards), 20px–24px (painéis), 40px–50px (contêineres grandes)</li><li>Sombra em anel: <code>rgb(224,226,232) 0px 0px 0px 1px</code></li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"pt-BR","message":"Profundidade e elevação"}],"html":[{"lang":"pt-BR","message":"<p>Mínima — sombra em anel + contraste das superfícies pastel</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<h3>Faça</h3>\n<ul><li>Use os pares pastel claro/escuro nas seções de recursos</li><li>Aplique a Roobert PRO com variantes de caracteres OpenType</li><li>Use o Blue 450 (#5b76fe) nos elementos interativos</li></ul>\n<h3>Não faça</h3>\n<ul><li>Não use sombras pesadas</li><li>Não misture mais de 2 destaques pastel por seção</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<p>Breakpoints: 425px, 576px, 768px, 896px, 1024px, 1200px, 1280px, 1366px, 1700px, 1920px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<h3>Referência rápida de cores</h3>\n<ul><li>Texto: Near Black (<code>#1c1c1e</code>)</li><li>Fundo: White (<code>#ffffff</code>)</li><li>Interativo: Blue 450 (<code>#5b76fe</code>)</li><li>Sucesso: <code>#00b473</code></li><li>Borda: <code>#c7cad5</code></li></ul>\n<h3>Exemplos de prompts de componentes</h3>\n<ul><li>&quot;Crie um hero: fundo branco. Roobert PRO Medium 56px, line-height 1.15, letter-spacing -1.68px. CTA azul (#5b76fe). Secundário com contorno (1px solid #c7cad5, raio de 8px).&quot;</li></ul>"}]}]}