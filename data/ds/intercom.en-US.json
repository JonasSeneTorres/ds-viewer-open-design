lse},{"step":800,"hex":"#4c4a47","exact":false},{"step":900,"hex":"#363533","exact":false},{"step":950,"hex":"#201f1e","exact":false}]},{"name":"Neutral","base":"#626260","derived":true,"scale":[{"step":50,"hex":"#faf9f6","exact":true},{"step":100,"hex":"#ededec","exact":false},{"step":200,"hex":"#dedbd6","exact":true},{"step":300,"hex":"#c7c7c6","exact":false},{"step":400,"hex":"#9c9fa5","exact":true},{"step":500,"hex":"#8f8f8d","exact":false},{"step":600,"hex":"#7b7b78","exact":true},{"step":700,"hex":"#626260","exact":true},{"step":800,"hex":"#4a4a49","exact":false},{"step":900,"hex":"#313130","exact":true},{"step":950,"hex":"#111111","exact":true}]}],"colors":[{"name":"Off Black","hex":"#111111","role":"(#111111): --color-off-black, primary text, button backgrounds"},{"name":"Pure White","hex":"#ffffff","role":"(#ffffff): --wsc-color-content-primary, primary surface"},{"name":"Warm Cream","hex":"#faf9f6","role":"(#faf9f6): Button backgrounds, card surfaces"},{"name":"Fin Orange","hex":"#ff5600","role":"(#ff5600): --color-fin, primary brand accent"},{"name":"Report Orange","hex":"#fe4c02","role":"(#fe4c02): --color-report-orange, data visualization"},{"name":"Report Blue","hex":"#65b5ff","role":"(#65b5ff): --color-report-blue"},{"name":"Report Green","hex":"#0bdf50","role":"(#0bdf50): --color-report-green"},{"name":"Report Red","hex":"#c41c1c","role":"(#c41c1c): --color-report-red"},{"name":"Report Pink","hex":"#ff2067","role":"(#ff2067): --color-report-pink"},{"name":"Report Lime","hex":"#b3e01c","role":"(#b3e01c): --color-report-lime-300"},{"name":"Green","hex":"#00da00","role":"(#00da00): --color-green"},{"name":"Deep Blue","hex":"#0007cb","role":"(#0007cb): Deep blue accent"},{"name":"Black 80","hex":"#313130","role":"(#313130): --wsc-color-black-80, dark neutral"},{"name":"Black 60","hex":"#626260","role":"(#626260): --wsc-color-black-60, mid neutral"},{"name":"Black 50","hex":"#7b7b78","role":"(#7b7b78): --wsc-color-black-50, muted text"},{"name":"Content Tertiary","hex":"#9c9fa5","role":"(#9c9fa5): --wsc-color-content-tertiary"},{"name":"Oat Border","hex":"#dedbd6","role":"(#dedbd6): Warm border color"},{"name":"Warm Sand","hex":"#d3cec6","role":"(#d3cec6): Light warm neutral"}],"fonts":[{"proprietary":true,"role":[{"lang":"en-US","message":"Primary"}],"kind":"primary","family":"Saans","fallbacks":["Saans Fallback","ui-sans-serif","system-ui"],"stack":"\"Saans\", \"Saans Fallback\", ui-sans-serif, system-ui, sans-serif","italic":false,"source":null},{"proprietary":true,"role":[{"lang":"en-US","message":"Serif"}],"kind":"primary","family":"Serrif","fallbacks":["Serrif Fallback","ui-serif","Georgia"],"stack":"\"Serrif\", \"Serrif Fallback\", ui-serif, Georgia, sans-serif","italic":false,"source":null},{"proprietary":true,"role":[{"lang":"en-US","message":"Monospace"}],"kind":"mono","family":"SaansMono","fallbacks":["SaansMono Fallback","ui-monospace"],"stack":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","italic":false,"source":null},{"proprietary":true,"role":[{"lang":"en-US","message":"Body"}],"kind":"body","family":"MediumLL","fallbacks":["LLMedium"],"stack":"\"MediumLL\", LLMedium, sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#faf9f6"},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"#faf9f6"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#111111"},{"name":"--fg-2","value":"var(--fg)"},{"name":"--muted","value":"#7b7b78"},{"name":"--meta","value":"#9c9fa5"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#dedbd6"},{"name":"--border-soft","value":"#ebe9e4"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#ff5600"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#00da00"},{"name":"--warn","value":"#eab308"},{"name":"--danger","value":"#c41c1c"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"32px"},{"name":"--text-3xl","value":"54px"},{"name":"--text-4xl","value":"80px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.0"},{"name":"--tracking-display","value":"-0.03em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"4px"},{"name":"--radius-md","value":"6px"},{"name":"--radius-lg","value":"8px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 2px 8px color-mix(in oklab, var(--fg), transparent 94%)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"12px"}]}],"vars":{"color-scheme":"light","--primary-500":"#ff5600","--primary-500-fg":"#111111","--neutral-400":"#9c9fa5","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 55%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2rem","--fs-h1":"3.375rem","--fs-hero":"5rem","--lh-body":"1.5","--lh-tight":"1.05","--display-tracking":"-0.03em","--section-y":"96px","--section-y-tablet":"64px","--container-max":"1280px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"12px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"8px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--h3-weight":"400","--body-weight":"400","--btn-weight":"400","--btn-radius":"4px","--btn-pad-y":"6px","--btn-pad-x":"14px","--bg":"#faf9f6","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111111","--fg-soft":"#111111","--muted":"color-mix(in oklab, #7b7b78 80%, var(--fg))","--meta":"color-mix(in oklab, #9c9fa5 60%, var(--fg))","--border":"#dedbd6","--border-soft":"#ebe9e4","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ff5600","--accent-strong":"color-mix(in oklab, var(--accent) 70%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#ff5600","--solid-hover":"#ff6b35","--solid-fg":"#111111","--ok":"#00da00","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#c41c1c","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"6px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 2px 8px color-mix(in oklab, var(--fg), transparent 94%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Saans\", \"Saans Fallback\", ui-sans-serif, system-ui, sans-serif","--font-body":"\"MediumLL\", LLMedium, sans-serif","--font-code":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","--font-mono":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","--heading-weight":"400","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Intercom's website is a warm, confident customer service platform that communicates &quot;AI-first helpdesk&quot; through a clean, editorial design language. The page operates on a warm off-white canvas (<code>#faf9f6</code>) with off-black (<code>#111111</code>) text, creating an intimate, magazine-like reading experience. The signature Fin Orange (<code>#ff5600</code>) — named after Intercom's AI agent — serves as the singular vibrant accent against the warm neutral palette.</p>\n<p>The typography uses Saans — a custom geometric sans-serif with aggressive negative letter-spacing (-2.4px at 80px, -0.48px at 24px) and a consistent 1.00 line-height across all heading sizes. This creates ultra-compressed, billboard-like headlines that feel engineered and precise. Serrif provides the serif companion for editorial moments, and SaansMono handles code and uppercase technical labels. MediumLL and LLMedium appear for specific UI contexts, creating a rich five-font ecosystem.</p>\n<p>What distinguishes Intercom is its remarkably sharp geometry — 4px border-radius on buttons creates near-rectangular interactive elements that feel industrial and precise, contrasting with the warm surface colors. Button hover states use <code>scale(1.1)</code> expansion, creating a physical &quot;growing&quot; interaction. The border system uses warm oat tones (<code>#dedbd6</code>) and oklab-based opacity values for sophisticated color management.</p>\n<p><strong>Key Characteristics:</strong></p>\n<ul><li>Warm off-white canvas (<code>#faf9f6</code>) with oat-toned borders (<code>#dedbd6</code>)</li><li>Saans font with extreme negative tracking (-2.4px at 80px) and 1.00 line-height</li><li>Fin Orange (<code>#ff5600</code>) as singular brand accent</li><li>Sharp 4px border-radius — near-rectangular buttons and elements</li><li>Scale(1.1) hover with scale(0.85) active — physical button interaction</li><li>SaansMono uppercase labels with wide tracking (0.6px–1.2px)</li><li>Rich multi-color report palette (blue, green, red, pink, lime, orange)</li><li>oklab color values for sophisticated opacity management</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<h3>Primary</h3>\n<ul><li><strong>Off Black</strong> (<code>#111111</code>): <code>--color-off-black</code>, primary text, button backgrounds</li><li><strong>Pure White</strong> (<code>#ffffff</code>): <code>--wsc-color-content-primary</code>, primary surface</li><li><strong>Warm Cream</strong> (<code>#faf9f6</code>): Button backgrounds, card surfaces</li><li><strong>Fin Orange</strong> (<code>#ff5600</code>): <code>--color-fin</code>, primary brand accent</li><li><strong>Report Orange</strong> (<code>#fe4c02</code>): <code>--color-report-orange</code>, data visualization</li></ul>\n<h3>Report Palette</h3>\n<ul><li><strong>Report Blue</strong> (<code>#65b5ff</code>): <code>--color-report-blue</code></li><li><strong>Report Green</strong> (<code>#0bdf50</code>): <code>--color-report-green</code></li><li><strong>Report Red</strong> (<code>#c41c1c</code>): <code>--color-report-red</code></li><li><strong>Report Pink</strong> (<code>#ff2067</code>): <code>--color-report-pink</code></li><li><strong>Report Lime</strong> (<code>#b3e01c</code>): <code>--color-report-lime-300</code></li><li><strong>Green</strong> (<code>#00da00</code>): <code>--color-green</code></li><li><strong>Deep Blue</strong> (<code>#0007cb</code>): Deep blue accent</li></ul>\n<h3>Neutral Scale (Warm)</h3>\n<ul><li><strong>Black 80</strong> (<code>#313130</code>): <code>--wsc-color-black-80</code>, dark neutral</li><li><strong>Black 60</strong> (<code>#626260</code>): <code>--wsc-color-black-60</code>, mid neutral</li><li><strong>Black 50</strong> (<code>#7b7b78</code>): <code>--wsc-color-black-50</code>, muted text</li><li><strong>Content Tertiary</strong> (<code>#9c9fa5</code>): <code>--wsc-color-content-tertiary</code></li><li><strong>Oat Border</strong> (<code>#dedbd6</code>): Warm border color</li><li><strong>Warm Sand</strong> (<code>#d3cec6</code>): Light warm neutral</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<h3>Font Families</h3>\n<ul><li><strong>Primary</strong>: <code>Saans</code>, fallbacks: <code>Saans Fallback, ui-sans-serif, system-ui</code></li><li><strong>Serif</strong>: <code>Serrif</code>, fallbacks: <code>Serrif Fallback, ui-serif, Georgia</code></li><li><strong>Monospace</strong>: <code>SaansMono</code>, fallbacks: <code>SaansMono Fallback, ui-monospace</code></li><li><strong>UI</strong>: <code>MediumLL</code> / <code>LLMedium</code>, fallbacks: <code>system-ui, -apple-system</code></li></ul>\n<h3>Hierarchy</h3>\n<table><thead><tr><th>Role</th><th>Font</th><th>Size</th><th>Weight</th><th>Line Height</th><th>Letter Spacing</th></tr></thead><tbody><tr><td>Display Hero</td><td>Saans</td><td>80px</td><td>400</td><td>1.00 (tight)</td><td>-2.4px</td></tr><tr><td>Section Heading</td><td>Saans</td><td>54px</td><td>400</td><td>1.00</td><td>-1.6px</td></tr><tr><td>Sub-heading</td><td>Saans</td><td>40px</td><td>400</td><td>1.00</td><td>-1.2px</td></tr><tr><td>Card Title</td><td>Saans</td><td>32px</td><td>400</td><td>1.00</td><td>-0.96px</td></tr><tr><td>Feature Title</td><td>Saans</td><td>24px</td><td>400</td><td>1.00</td><td>-0.48px</td></tr><tr><td>Body Emphasis</td><td>Saans</td><td>20px</td><td>400</td><td>0.95</td><td>-0.2px</td></tr><tr><td>Nav / UI</td><td>Saans</td><td>18px</td><td>400</td><td>1.00</td><td>normal</td></tr><tr><td>Body</td><td>Saans</td><td>16px</td><td>400</td><td>1.50</td><td>normal</td></tr><tr><td>Body Light</td><td>Saans</td><td>14px</td><td>300</td><td>1.40</td><td>normal</td></tr><tr><td>Button</td><td>Saans</td><td>16px / 14px</td><td>400</td><td>1.50 / 1.43</td><td>normal</td></tr><tr><td>Button Bold</td><td>LLMedium</td><td>16px</td><td>700</td><td>1.20</td><td>0.16px</td></tr><tr><td>Serif Body</td><td>Serrif</td><td>16px</td><td>300</td><td>1.40</td><td>-0.16px</td></tr><tr><td>Mono Label</td><td>SaansMono</td><td>12px</td><td>400–500</td><td>1.00–1.30</td><td>0.6px–1.2px uppercase</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<h3>Buttons</h3>\n<p><strong>Primary Dark</strong></p>\n<ul><li>Background: <code>#111111</code></li><li>Text: <code>#ffffff</code></li><li>Padding: 0px 14px</li><li>Radius: 4px</li><li>Hover: white background, dark text, scale(1.1)</li><li>Active: green background (<code>#2c6415</code>), scale(0.85)</li></ul>\n<p><strong>Outlined</strong></p>\n<ul><li>Background: transparent</li><li>Text: <code>#111111</code></li><li>Border: <code>1px solid #111111</code></li><li>Radius: 4px</li><li>Same scale hover/active behavior</li></ul>\n<p><strong>Warm Card Button</strong></p>\n<ul><li>Background: <code>#faf9f6</code></li><li>Text: <code>#111111</code></li><li>Padding: 16px</li><li>Border: <code>1px solid oklab(... / 0.1)</code></li></ul>\n<h3>Cards &amp; Containers</h3>\n<ul><li>Background: <code>#faf9f6</code> (warm cream)</li><li>Border: <code>1px solid #dedbd6</code> (warm oat)</li><li>Radius: 8px</li><li>No visible shadows</li></ul>\n<h3>Navigation</h3>\n<ul><li>Saans 16px for links</li><li>Off-black text on white</li><li>Small 4px–6px radius buttons</li><li>Orange Fin accent for AI features</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"en-US","message":"Layout Principles"}],"html":[{"lang":"en-US","message":"<h3>Spacing: 8px, 10px, 12px, 14px, 16px, 20px, 24px, 32px, 40px, 48px, 60px, 64px, 80px, 96px</h3>\n<h3>Border Radius: 4px (buttons), 6px (nav items), 8px (cards, containers)</h3>"}]},{"id":"depth-elevation","title":[{"lang":"en-US","message":"Depth & Elevation"}],"html":[{"lang":"en-US","message":"<p>Minimal shadows. Depth through warm border colors and surface tints.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<h3>Do</h3>\n<ul><li>Use Saans with 1.00 line-height and negative tracking on all headings</li><li>Apply 4px radius on buttons — sharp geometry is the identity</li><li>Use Fin Orange (#ff5600) for AI/brand accent only</li><li>Apply scale(1.1) hover on buttons</li><li>Use warm neutrals (#faf9f6, #dedbd6)</li></ul>\n<h3>Don't</h3>\n<ul><li>Don't round buttons beyond 4px</li><li>Don't use Fin Orange decoratively</li><li>Don't use cool gray borders — always warm oat tones</li><li>Don't skip the negative tracking on headings</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<p>Breakpoints: 425px, 530px, 600px, 640px, 768px, 896px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<h3>Quick Color Reference</h3>\n<ul><li>Text: Off Black (<code>#111111</code>)</li><li>Background: Warm Cream (<code>#faf9f6</code>)</li><li>Accent: Fin Orange (<code>#ff5600</code>)</li><li>Border: Oat (<code>#dedbd6</code>)</li><li>Muted: <code>#7b7b78</code></li></ul>\n<h3>Example Component Prompts</h3>\n<ul><li>&quot;Create hero: warm cream (#faf9f6) background. Saans 80px weight 400, line-height 1.00, letter-spacing -2.4px, #111111. Dark button (#111111, 4px radius). Hover: scale(1.1), white bg.&quot;</li></ul>"}]}]}