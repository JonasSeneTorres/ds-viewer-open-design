},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"#eef7ed"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#1f2a24"},{"name":"--fg-2","value":"#435147"},{"name":"--muted","value":"#788276"},{"name":"--meta","value":"#2f8f46"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#dbe3d7"},{"name":"--border-soft","value":"#edf1ea"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#2f8f46"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#16a34a"},{"name":"--warn","value":"#d97706"},{"name":"--danger","value":"#dc2626"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"18px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"34px"},{"name":"--text-3xl","value":"48px"},{"name":"--text-4xl","value":"66px"},{"name":"--leading-body","value":"1.56"},{"name":"--leading-tight","value":"1.08"},{"name":"--tracking-display","value":"-0.02em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"68px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"12px"},{"name":"--radius-md","value":"18px"},{"name":"--radius-lg","value":"28px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 20px 48px rgba(31, 42, 36, 0.11)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(47, 143, 70, 0.24)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"160ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1160px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#16a34a","--primary-500-fg":"#111111","--neutral-400":"#aaaaac","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 65%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 60%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 85%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.125rem","--fs-h1":"3rem","--fs-hero":"4.125rem","--lh-body":"1.56","--lh-tight":"1.08","--display-tracking":"-0.02em","--section-y":"96px","--section-y-tablet":"68px","--container-max":"1160px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"160ms","--motion-base":"240ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"28px","--focus-ring":"0 0 0 4px rgba(47, 143, 70, 0.24)","--bg":"#fbf7ef","--surface":"#ffffff","--surface-2":"#eef7ed","--fg":"#1f2a24","--fg-soft":"#435147","--muted":"color-mix(in oklab, #788276 70%, var(--fg))","--meta":"color-mix(in oklab, #2f8f46 70%, var(--fg))","--border":"#dbe3d7","--border-soft":"#edf1ea","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#2f8f46","--accent-strong":"color-mix(in oklab, var(--accent) 70%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#2f8f46","--solid-hover":"#499a58","--solid-fg":"#111111","--ok":"#16a34a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#d97706","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"18px","--radius-sm":"12px","--radius-pill":"9999px","--shadow-card":"0 20px 48px rgba(31, 42, 36, 0.11)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Inter\", sans-serif","--font-body":"\"Inter\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Conversion-focused design that removes friction and guides users toward action through clarity, trust, and speed.</p>\n<ul><li><strong>Visual style:</strong> modern, clean</li><li><strong>Color stance:</strong> primary, neutral, success, warning, danger</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#27272A</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#8B5CF6</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#FFFFFF</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#FFFFFF</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#27272A) for CTA emphasis.</li><li>Use Surface (#FFFFFF) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> 12/14/16/20/24/32</li><li><strong>Families:</strong> primary=Inter, display=Inter, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#27272A</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#27272A) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}