ontainer-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"dark","font-synthesis-weight":"none","--primary-500":"#00a4a4","--primary-500-fg":"#111111","--neutral-400":"#a9abac","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.25rem","--fs-h2":"1.75rem","--fs-h1":"2.5rem","--fs-hero":"3.5rem","--lh-body":"1.6","--lh-tight":"1.1","--display-tracking":"0em","--section-y":"80px","--section-y-tablet":"60px","--container-max":"1100px","--gutter":"32px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"80ms","--motion-base":"140ms","--ease":"ease-out","--radius-lg":"4px","--focus-ring":"0 0 0 4px rgba(0, 240, 240, 0.32)","--bg":"#050816","--surface":"#10162a","--surface-2":"#17203a","--fg":"#f8fafc","--fg-soft":"#cbd5e1","--muted":"#94a3b8","--meta":"#00f0f0","--border":"#26324f","--border-soft":"#1c2740","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#00f0f0","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#061018","--solid":"#00f0f0","--solid-hover":"#4cf2f2","--solid-fg":"#061018","--ok":"#00f000","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f0f000","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#f00000","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"0px","--radius-sm":"0px","--radius-pill":"9999px","--shadow-card":"0 18px 0 rgba(0, 0, 0, 0.32)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Bangers\", sans-serif","--font-body":"\"Bangers\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"400","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Design inspirado no clássico jogo de blocos, com cores lúdicas, fontes de display ousadas e layouts compactos e cheios de energia.</p>\n<ul><li><strong>Estilo visual:</strong> alto contraste, lúdico, premium</li><li><strong>Postura de cor:</strong> primária, secundária, sucesso, alerta, perigo, informação</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#1C202B</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#7107E7</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#16A34A</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#D97706</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#DC2626</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#DFE7FF</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#1C398E</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#DFE7FF</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#1C202B) para dar ênfase aos CTAs.</li><li>Use a Superfície (#DFE7FF) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#1C398E) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> escala expressiva desktop-first</li><li><strong>Famílias:</strong> primary=Bangers, display=Bangers, mono=JetBrains Mono</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> modo de densidade compacta</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#1C202B</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#1C202B) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}