   "html": [
    {
     "lang": "en-US",
     "message": "<ul><li>Buttons: primary action uses <code>#5D4432</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"
    },
    {
     "lang": "pt-BR",
     "message": "<ul><li>Botões: a ação principal usa <code>#5D4432</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"
    }
