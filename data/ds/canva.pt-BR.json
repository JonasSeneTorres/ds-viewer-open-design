,"exact":false},{"step":800,"hex":"#654201","exact":false},{"step":900,"hex":"#483006","exact":false},{"step":950,"hex":"#2b1c06","exact":false}]},{"name":"Tangerine","base":"#ff9633","derived":true,"scale":[{"step":50,"hex":"#fff5ed","exact":false},{"step":100,"hex":"#fee8d8","exact":false},{"step":200,"hex":"#fed3b3","exact":false},{"step":300,"hex":"#feb57c","exact":false},{"step":400,"hex":"#ff9633","exact":true},{"step":500,"hex":"#d27304","exact":false},{"step":600,"hex":"#b05f00","exact":false},{"step":700,"hex":"#8f4d04","exact":false},{"step":800,"hex":"#703a00","exact":false},{"step":900,"hex":"#522900","exact":false},{"step":950,"hex":"#301905","exact":false}]},{"name":"Neutral","base":"#5f6368","derived":true,"scale":[{"step":50,"hex":"#f4f5f7","exact":true},{"step":100,"hex":"#ebedf0","exact":false},{"step":200,"hex":"#e1e3e6","exact":true},{"step":300,"hex":"#c7cdd3","exact":true},{"step":400,"hex":"#9aa0a6","exact":true},{"step":500,"hex":"#8c8f94","exact":false},{"step":600,"hex":"#74787d","exact":false},{"step":700,"hex":"#5f6368","exact":true},{"step":800,"hex":"#474b4f","exact":false},{"step":900,"hex":"#3c4043","exact":true},{"step":950,"hex":"#1d1f23","exact":false}]}],"colors":[{"name":"Canva Purple","hex":"#7d2ae8","role":"(#7d2ae8): Brand primary; gradient origin."},{"name":"Canva Cyan","hex":"#00c4cc","role":"(#00c4cc): Brand secondary; gradient terminus."},{"name":"Canva Pink","hex":"#ff5757","role":"(#ff5757): Tertiary brand accent (Magic Studio)."},{"name":"Canvas","hex":"#ffffff","role":"(#ffffff): Primary background."},{"name":"Surface Subtle","hex":"#f4f5f7","role":"(#f4f5f7): Section break, sidebar."},{"name":"Surface Inset","hex":"#e8eaed","role":"(#e8eaed): Disabled, inset block."},{"name":"Surface Cool","hex":"#eef0fc","role":"(#eef0fc): Hover tint on purple-themed cards."},{"name":"Ink Primary","hex":"#0e1318","role":"(#0e1318): Primary text."},{"name":"Ink Secondary","hex":"#3c4043","role":"(#3c4043): Body prose."},{"name":"Ink Muted","hex":"#5f6368","role":"(#5f6368): Captions, descriptions."},{"name":"Ink Faint","hex":"#9aa0a6","role":"(#9aa0a6): Placeholder, disabled label."},{"name":"Success","hex":"#00b894","role":"(#00b894): Saved, exported."},{"name":"Warning","hex":"#ffb020","role":"(#ffb020): Storage limit, advisory."},{"name":"Info","hex":"#0d99ff","role":"(#0d99ff): Tip, link."},{"name":"Coral","hex":"#ff7059","role":"(#ff7059): Social posts."},{"name":"Tangerine","hex":"#ff9633","role":"(#ff9633): Marketing."},{"name":"Mint","hex":"#48c997","role":"(#48c997): Education."},{"name":"Sky","hex":"#3ea6ff","role":"(#3ea6ff): Business."},{"name":"Lavender","hex":"#9b87f5","role":"(#9b87f5): Personal."},{"name":"Border Default","hex":"#e1e3e6","role":"(#e1e3e6): Standard hairline."},{"name":"Border Strong","hex":"#c7cdd3","role":"(#c7cdd3): Emphasized border, hover state."}],"fonts":[{"role":[{"lang":"pt-BR","message":"Títulos"}],"kind":"display","family":"Canva Sans","fallbacks":["YS Text","system-ui","-apple-system","sans-serif"],"stack":"\"Canva Sans\", \"YS Text\", system-ui, -apple-system, sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Editorial (rare)"}],"kind":"primary","family":"Canva Sans Display","fallbacks":["Canva Sans","sans-serif"],"stack":"\"Canva Sans Display\", \"Canva Sans\", sans-serif","italic":false,"source":null},{"role":[{"lang":"pt-BR","message":"Monoespaçada"}],"kind":"mono","family":"JetBrains Mono","fallbacks":["ui-monospace","Menlo","Consolas","monospace"],"stack":"\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/JetBrains+Mono","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://f