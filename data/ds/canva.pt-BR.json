{"id":"canva","name":"Canva","source":{"name":"Canva","url":"https://open-design.ai/plugins/design-system-canva/"},"category":[{"lang":"pt-BR","message":"Design & criativo"}],"intro":[{"lang":"pt-BR","message":"Plataforma de criação visual. Gradiente roxo-azul vívido, espaçamento generoso, geometria amigável."}],"roles":{"primary":"Canva Purple","neutral":"Neutral","secondary":"Canva Cyan"},"palettes":[{"name":"Canva Purple","base":"#7d2ae8","derived":true,"scale":[{"step":50,"hex":"#f7f5fe","exact":false},{"step":100,"hex":"#eeeafd","exact":false},{"step":200,"hex":"#dfd5ff","exact":false},{"step":300,"hex":"#ccbcfd","exact":false},{"step":400,"hex":"#b396fd","exact":false},{"step":500,"hex":"#9b87f5","exact":true},{"step":600,"hex":"#8a40f7","exact":false},{"step":700,"hex":"#7d2ae8","exact":true},{"step":800,"hex":"#5b01b2","exact":false},{"step":900,"hex":"#420086","exact":false},{"step":950,"hex":"#280057","exact":false}]},{"name":"Canva Cyan","base":"#00c4cc","derived":true,"scale":[{"step":50,"hex":"#e0feff","exact":false},{"step":100,"hex":"#b7fbff","exact":false},{"step":200,"hex":"#71f3fa","exact":false},{"step":300,"hex":"#4cdfe6","exact":false},{"step":400,"hex":"#00c4cc","exact":true},{"step":500,"hex":"#0ca3a9","exact":false},{"step":600,"hex":"#08888d","exact":false},{"step":700,"hex":"#026e73","exact":false},{"step":800,"hex":"#065559","exact":false},{"step":900,"hex":"#043e40","exact":false},{"step":950,"hex":"#002527","exact":false}]},{"name":"Canva Pink","base":"#ff5757","derived":true,"scale":[{"step":50,"hex":"#fdf5f4","exact":false},{"step":100,"hex":"#fee7e4","exact":false},{"step":200,"hex":"#fdd0cc","exact":false},{"step":300,"hex":"#ffb0a9","exact":false},{"step":400,"hex":"#fe7f79","exact":false},{"step":500,"hex":"#ff5757","exact":true},{"step":600,"hex":"#d0353a","exact":false},{"step":700,"hex":"#ae2229","exact":false},{"step":800,"hex":"#8b121b","exact":false},{"step":900,"hex":"#680510","exact":false},{"step":950,"hex":"#420106","exac