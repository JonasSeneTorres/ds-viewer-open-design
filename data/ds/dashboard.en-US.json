0px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#0ea5e9","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 60%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 75%, var(--fg))","--danger-fg":"#111111","--fs-xs":"0.6875rem","--fs-sm":"0.8125rem","--fs-base":"0.9375rem","--fs-h3":"1.375rem","--fs-h2":"1.875rem","--fs-h1":"2.625rem","--fs-hero":"3.5rem","--lh-body":"1.48","--lh-tight":"1.1","--display-tracking":"-0.015em","--section-y":"84px","--section-y-tablet":"60px","--container-max":"1280px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"120ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"18px","--focus-ring":"0 0 0 4px rgba(14, 165, 233, 0.22)","--bg":"#f4f7fb","--surface":"#ffffff","--surface-2":"#eef6ff","--fg":"#111827","--fg-soft":"#334155","--muted":"color-mix(in oklab, #64748b 90%, var(--fg))","--meta":"color-mix(in oklab, #0ea5e9 65%, var(--fg))","--border":"#d8e2ee","--border-soft":"#edf3f8","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#0ea5e9","--accent-strong":"color-mix(in oklab, var(--accent) 60%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#04131d","--solid":"#0ea5e9","--solid-hover":"#3faeec","--solid-fg":"#04131d","--ok":"#10b981","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f59e0b","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ef4444","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 18px 46px rgba(15, 23, 42, 0.10)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"system-ui, sans-serif","--font-body":"system-ui, sans-serif","--font-code":"\"IBM Plex Sans\", monospace","--font-mono":"\"IBM Plex Sans\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Dark-themed cloud-platform aesthetic with modular grids, glass-like panels, and strong data hierarchy for productivity dashboards.</p>\n<ul><li><strong>Visual style:</strong> modern, clean, cloud-platform aesthetic (Heroku/Vercel/GitHub inspired), dark theme, subtle gradients, soft shadows, glass-like panels, rounded components</li><li><strong>Color stance:</strong> primary, neutral, success, warning, danger</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#0C5CAB</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#0A4A8A</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#10B981</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#F59E0B</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#EF4444</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#09090B</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#FAFAFA</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#09090B</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#0C5CAB) for CTA emphasis.</li><li>Use Surface (#09090B) for large backgrounds and cards.</li><li>Keep body copy on Text (#FAFAFA) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> 12/14/16/20/24/32</li><li><strong>Families:</strong> primary=IBM Plex Sans, display=IBM Plex Sans, mono=IBM Plex Sans</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 8pt baseline grid</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#0C5CAB</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#0C5CAB) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}