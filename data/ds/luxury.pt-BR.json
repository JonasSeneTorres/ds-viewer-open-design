"value":"180ms"},{"name":"--motion-base","value":"300ms"},{"name":"--ease-standard","value":"cubic-bezier(0.16, 1, 0.3, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1160px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"dark","--primary-500":"#ac8946","--primary-500-fg":"#111111","--neutral-400":"#ababaa","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#111111","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.75rem","--fs-h2":"2.75rem","--fs-h1":"4rem","--fs-hero":"6rem","--lh-body":"1.6","--lh-tight":"1.05","--display-tracking":"-0.015em","--section-y":"112px","--section-y-tablet":"80px","--container-max":"1160px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"180ms","--motion-base":"300ms","--ease":"cubic-bezier(0.16, 1, 0.3, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 4px rgba(198, 161, 91, 0.30)","--bg":"#080706","--surface":"#151310","--surface-2":"#241e14","--fg":"#fff8ea","--fg-soft":"#d8cdb7","--muted":"#9f927c","--meta":"#c6a15b","--border":"#3a3020","--border-soft":"#282217","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#c6a15b","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#080706","--solid":"#c6a15b","--solid-hover":"#ccaa6c","--solid-fg":"#080706","--ok":"#5fa36a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#d8a94f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#d85a52","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"14px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 30px 90px rgba(0, 0, 0, 0.52)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Oswald\", sans-serif","--font-body":"\"Oswald\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Estética escura de alto padrão, com títulos ousados, paleta monocromática e sensação premium para experiências de marcas de luxo.</p>\n<ul><li><strong>Estilo visual:</strong> moderno, ousado, títulos grandes</li><li><strong>Postura de cor:</strong> primária</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#FAFAFA</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#FAFAFA</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#16A34A</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#D97706</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#DC2626</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#000000</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#FFFFFF</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#000000</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#FAFAFA) para dar ênfase aos CTAs.</li><li>Use a Superfície (#000000) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#FFFFFF) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> escala expressiva desktop-first</li><li><strong>Famílias:</strong> primary=Oswald, display=Oswald, mono=JetBrains Mono</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> grid de linha de base de 8pt</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#FAFAFA</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#FAFAFA) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}