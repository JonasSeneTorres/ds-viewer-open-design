,{"step":800,"hex":"#4d4d20","exact":false},{"step":900,"hex":"#373817","exact":false},{"step":950,"hex":"#212101","exact":false}]},{"name":"Neutral","base":"#f8fafc","derived":true,"scale":[{"step":50,"hex":"#f8fafc","exact":true},{"step":100,"hex":"#ebedef","exact":false},{"step":200,"hex":"#dbdcde","exact":false},{"step":300,"hex":"#c6c7c9","exact":false},{"step":400,"hex":"#a9abac","exact":false},{"step":500,"hex":"#8e8f90","exact":false},{"step":600,"hex":"#767778","exact":false},{"step":700,"hex":"#606061","exact":false},{"step":800,"hex":"#4a4a4b","exact":false},{"step":900,"hex":"#353536","exact":false},{"step":950,"hex":"#1f1f20","exact":false}]}],"colors":[{"name":"Primary","hex":"#1c202b","role":"#1C202B — Token from style foundations."},{"name":"Secondary","hex":"#7107e7","role":"#7107E7 — Token from style foundations."},{"name":"Success","hex":"#16a34a","role":"#16A34A — Token from style foundations."},{"name":"Warning","hex":"#d97706","role":"#D97706 — Token from style foundations."},{"name":"Danger","hex":"#dc2626","role":"#DC2626 — Token from style foundations."},{"name":"Surface","hex":"#dfe7ff","role":"#DFE7FF — Token from style foundations."},{"name":"Text","hex":"#1c398e","role":"#1C398E — Token from style foundations."}],"fonts":[{"role":[{"lang":"en-US","message":"Primary / Headings"}],"kind":"display","family":"Bangers","fallbacks":[],"stack":"\"Bangers\", sans-serif","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=Bangers:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/Bangers","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Bangers:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=Bangers:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/bangers"}},{"role":[{"lang":"en-US","message":"Monospace"}],"kind":"mono","family":"JetBrains Mono","fallbacks":[],"stack":"\"JetBrains Mono\", monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/JetBrains+Mono","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/jetbrains-mono"}}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#050816"},{"name":"--surface","value":"#10162a"},{"name":"--surface-warm","value":"#17203a"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#f8fafc"},{"name":"--fg-2","value":"#cbd5e1"},{"name":"--muted","value":"#94a3b8"},{"name":"--meta","value":"#00f0f0"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#26324f"},{"name":"--border-soft","value":"#1c2740"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#00f0f0"},{"name":"--accent-on","value":"#061018"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#00f000"},{"name":"--warn","value":"#f0f000"},{"name":"--danger","value":"#f00000"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"10px"},{"name":"--text-sm","value":"12px"},{"name":"--text-base","value":"14px"},{"name":"--text-lg","value":"16px"},{"name":"--text-xl","value":"20px"},{"name":"--text-2xl","value":"28px"},{"name":"--text-3xl","value":"40px"},{"name":"--text-4xl","value":"56px"},{"name":"--leading-body","value":"1.6"},{"name":"--leading-tight","value":"1.1"},{"name":"--tracking-display","value":"0"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"80px"},{"name":"--section-y-tablet","value":"60px"},{"name":"--section-y-phone","value":"44px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"0px"},{"name":"--radius-md","value":"0px"},{"name":"--radius-lg","value":"4px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 18px 0 rgba(0, 0, 0, 0.32)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(0, 240, 240, 0.32)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"80ms"},{"name":"--motion-base","value":"140ms"},{"name":"--ease-standard","value":"steps(2, end)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1100px"},{"name":"--container-gutter-desktop","value":"32px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#00a4a4","--primary-500-fg":"#111111","--neutral-400":"#a9abac","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--bg":"#050816","--surface":"#10162a","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#f8fafc","--fg-soft":"#cbd5e1","--muted":"#94a3b8","--border":"#26324f","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#00f0f0","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#061018","--solid":"var(--accent-strong)","--solid-fg":"#061018","--ok":"#00f000","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f0f000","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#f00000","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"0px","--radius-sm":"0px","--radius-pill":"9999px","--shadow-card":"0 18px 0 rgba(0, 0, 0, 0.32)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Bangers\", sans-serif","--font-body":"\"Bangers\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Classic block-game inspired design with playful colors, bold display fonts, and compact, high-energy layouts.</p>\n<ul><li><strong>Visual style:</strong> high-contrast, playful, premium</li><li><strong>Color stance:</strong> primary, secondary, success, warning, danger, info</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#1C202B</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#7107E7</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#DFE7FF</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#1C398E</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#DFE7FF</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#1C202B) for CTA emphasis.</li><li>Use Surface (#DFE7FF) for large backgrounds and cards.</li><li>Keep body copy on Text (#1C398E) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> desktop-first expressive scale</li><li><strong>Families:</strong> primary=Bangers, display=Bangers, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> compact density mode</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#1C202B</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#1C202B) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}