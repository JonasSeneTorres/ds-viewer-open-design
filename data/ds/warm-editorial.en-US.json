33e33","exact":false},{"step":950,"hex":"#00261e","exact":false}]},{"name":"Success","base":"#4f8a4f","derived":true,"scale":[{"step":50,"hex":"#e7fee6","exact":false},{"step":100,"hex":"#d3f9d2","exact":false},{"step":200,"hex":"#bfeabe","exact":false},{"step":300,"hex":"#a6d6a5","exact":false},{"step":400,"hex":"#85bb84","exact":false},{"step":500,"hex":"#66a065","exact":false},{"step":600,"hex":"#4f8a4f","exact":true},{"step":700,"hex":"#386f38","exact":false},{"step":800,"hex":"#255726","exact":false},{"step":900,"hex":"#144016","exact":false},{"step":950,"hex":"#042706","exact":false}]},{"name":"Warning","base":"#c9822f","derived":true,"scale":[{"step":50,"hex":"#fef5ed","exact":false},{"step":100,"hex":"#fee9d4","exact":false},{"step":200,"hex":"#ffd3a9","exact":false},{"step":300,"hex":"#fab874","exact":false},{"step":400,"hex":"#e09a4d","exact":false},{"step":500,"hex":"#c9822f","exact":true},{"step":600,"hex":"#a7660d","exact":false},{"step":700,"hex":"#895100","exact":false},{"step":800,"hex":"#6b3e00","exact":false},{"step":900,"hex":"#4e2c01","exact":false},{"step":950,"hex":"#311900","exact":false}]},{"name":"Neutral","base":"#1c1a17","derived":true,"scale":[{"step":50,"hex":"#faf7f2","exact":true},{"step":100,"hex":"#ededeb","exact":false},{"step":200,"hex":"#dddcdb","exact":false},{"step":300,"hex":"#c8c7c6","exact":false},{"step":400,"hex":"#ababa9","exact":false},{"step":500,"hex":"#908f8d","exact":false},{"step":600,"hex":"#797775","exact":false},{"step":700,"hex":"#62605d","exact":false},{"step":800,"hex":"#4c4a47","exact":false},{"step":900,"hex":"#373532","exact":false},{"step":950,"hex":"#1c1a17","exact":true}]}],"colors":[{"name":"Background","hex":"#faf7f2","role":"#FAF7F2 (warm off-white paper)"},{"name":"Foreground","hex":"#1c1a17","role":"#1C1A17 (near-black, slightly warm)"},{"name":"Accent (primary)","hex":"#c0512f","role":"#C0512F (terracotta) — used for links, primary CTAs, 1 hero element max per page"},{"name":"Accent (secondary)","hex":"#2f5b4f","role":"#2F5B4F (forest) — section dividers, tags"},{"name":"Muted","hex":"#8a817a","role":"#8A817A (mid-warm-grey) — timestamps, metadata"},{"name":"Surface","hex":"#ffffff","role":"#FFFFFF — elevated cards only"}],"fonts":[{"role":[{"lang":"en-US","message":"Monospace"}],"kind":"mono","family":"JetBrains Mono","fallbacks":["ui-monospace","monospace"],"stack":"\"JetBrains Mono\", ui-monospace, monospace, monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/JetBrains+Mono","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/jetbrains-mono"}}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#fbf6ee"},{"name":"--surface","value":"#fffdf8"},{"name":"--surface-warm","value":"#f1e3cf"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#201914"},{"name":"--fg-2","value":"#4c4037"},{"name":"--muted","value":"#7a6d63"},{"name":"--meta","value":"#9b5b32"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#ded2c3"},{"name":"--border-soft","value":"#eee4d7"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#9b5b32"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#4f8a4f"},{"name":"--warn","value":"#c9822f"},{"name":"--danger","value":"#b33a3a"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"17px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"28px"},{"name":"--text-2xl","value":"42px"},{"name":"--text-3xl","value":"64px"},{"name":"--text-4xl","value":"88px"},{"name":"--leading-body","value":"1.62"},{"name":"--leading-tight","value":"1"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"112px"},{"name":"--section-y-tablet","value":"80px"},{"name":"--section-y-phone","value":"56px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"24px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 20px 52px rgba(32, 25, 20, 0.12)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(155, 91, 50, 0.24)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#bd7e58","--primary-500-fg":"#111111","--neutral-400":"#ababa9","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 65%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--bg":"#fbf6ee","--surface":"#fffdf8","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#201914","--fg-soft":"#4c4037","--muted":"#7a6d63","--border":"#ded2c3","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#9b5b32","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"var(--accent-strong)","--solid-fg":"#ffffff","--ok":"#4f8a4f","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#c9822f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#b33a3a","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 20px 52px rgba(32, 25, 20, 0.12)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"system-ui, sans-serif","--font-body":"system-ui, sans-serif","--font-code":"\"JetBrains Mono\", ui-monospace, monospace, monospace","--font-mono":"\"JetBrains Mono\", ui-monospace, monospace, monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Warm, unhurried, magazine-like. Think &quot;a New Yorker interview column online.&quot; Generous whitespace, long-form readability, restrained chrome. Playful but never novelty.</p>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Background:</strong> <code>#FAF7F2</code> (warm off-white paper)</li><li><strong>Foreground:</strong> <code>#1C1A17</code> (near-black, slightly warm)</li><li><strong>Accent (primary):</strong> <code>#C0512F</code> (terracotta) — used for links, primary CTAs, 1 hero element max per page</li><li><strong>Accent (secondary):</strong> <code>#2F5B4F</code> (forest) — section dividers, tags</li><li><strong>Muted:</strong> <code>#8A817A</code> (mid-warm-grey) — timestamps, metadata</li><li><strong>Surface:</strong> <code>#FFFFFF</code> — elevated cards only</li></ul>\n<p>Never use pure black or pure white anywhere user-facing.</p>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Display / headings:</strong> &quot;GT Sectra&quot; or fallback serif (<code>'GT Sectra', 'Times New Roman', serif</code>)</li><li><strong>Body:</strong> &quot;Söhne&quot; or fallback sans (<code>'Söhne', -apple-system, system-ui, sans-serif</code>)</li><li><strong>Mono:</strong> <code>'JetBrains Mono', ui-monospace, monospace</code> for code only</li><li>Scale (px): 12 · 14 · 16 · 20 · 28 · 40 · 56 · 80</li><li>Line-height: 1.6 for body, 1.2 for display</li><li>Letter-spacing: -0.02em for display sizes above 40px; default elsewhere</li></ul>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Buttons:</strong> flat fill, 12px radius, 14px padding-block, 20px padding-inline. Primary = terracotta fill, off-white label. Secondary = outlined 1px foreground, transparent fill.</li><li><strong>Cards:</strong> off-white background, 1px forest-at-8%-opacity border, 16px radius, 24–32px internal padding. No shadow except hover (y+2px, blur 16, foreground-at-6%).</li><li><strong>Inputs:</strong> underline only (no box), 1px muted baseline, terracotta baseline on focus, 16px vertical padding.</li><li><strong>Links:</strong> terracotta, 1px terracotta-at-40% underline, no underline on hover (swap for terracotta-at-8% background).</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"en-US","message":"Layout Principles"}],"html":[{"lang":"en-US","message":"<ul><li>12-column grid, 1200px max-width, 24px gutters.</li><li>Hero sections: 72vh minimum, 120vh maximum. Content top-biased, never centered vertically.</li><li>Body sections: 80px top+bottom spacing at desktop; 48px at tablet; 32px at phone.</li><li>One accent color per screen. If a page has a terracotta hero, secondary CTAs are foreground-only, not forest.</li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"en-US","message":"Depth & Elevation"}],"html":[{"lang":"en-US","message":"<p>Minimal. Only two elevation levels:</p>\n<ul><li><strong>Flat (0):</strong> everything by default.</li><li><strong>Raised (1):</strong> cards on hover, dropdown menus, floating CTAs. 2px y-offset, 16px blur, foreground at 6% opacity.</li></ul>\n<p>No shadows on inputs. No shadows on the hero. No neumorphism, no glassmorphism.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<ul><li>✅ Let whitespace breathe. A short headline on 50% of the viewport height is correct.</li><li>✅ Use serif for numbers when they matter (pricing, stats).</li><li>✅ Draw one accent element per page; the rest is foreground.</li><li>❌ No gradients.</li><li>❌ No emojis in product copy.</li><li>❌ No sentence-case for headings — use title case for H1/H2, sentence case for H3 and below.</li><li>❌ No border-radius above 24px; no border-radius below 8px.</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Desktop ≥ 1024px:</strong> 12-col grid, full hero heights, side-by-side columns.</li><li><strong>Tablet 640–1023px:</strong> 8-col grid; hero drops to 60vh; columns stack at 3+.</li><li><strong>Phone &lt; 640px:</strong> 4-col grid; single-column layout; hero drops to 50vh; all padding -33%.</li></ul>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<p>When generating artifacts against this design system:</p>\n<ul><li>Lead with typography and whitespace; chrome (borders, shadows) is subtractive.</li><li>If you need more than one accent element on a screen, you're doing too much — cut one.</li><li>When asked for &quot;professional&quot; or &quot;serious,&quot; lean harder on serif + whitespace. When asked for &quot;modern,&quot; this system isn't the right answer; pick a different DESIGN.md.</li><li>Color tokens are non-negotiable. Do not invent new hex values. If the request needs a color outside this palette, produce a warning comment in the artifact and use the closest existing token.</li><li>Prefer 1 hero + 3–5 body sections over 1 hero + 8+ sections. Editorial means restraint.</li></ul>"}]}]}