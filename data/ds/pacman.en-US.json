lue":"10px"},{"name":"--radius-md","value":"18px"},{"name":"--radius-lg","value":"9999px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 0 0 2px #2338ff, 0 22px 60px rgba(0, 0, 0, 0.46)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(255, 204, 0, 0.34)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"90ms"},{"name":"--motion-base","value":"160ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1080px"},{"name":"--container-gutter-desktop","value":"32px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#ae8b08","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#111111","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.25rem","--fs-h2":"1.875rem","--fs-h1":"2.75rem","--fs-hero":"4rem","--lh-body":"1.6","--lh-tight":"1.08","--display-tracking":"0em","--section-y":"84px","--section-y-tablet":"60px","--container-max":"1080px","--gutter":"32px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"90ms","--motion-base":"160ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"28px","--focus-ring":"0 0 0 4px rgba(255, 204, 0, 0.34)","--bg":"#050505","--surface":"#101014","--surface-2":"#1f1b08","--fg":"#fff7d6","--fg-soft":"#f6e79c","--muted":"#b9a85d","--meta":"#ffcc00","--border":"#2338ff","--border-soft":"#17218a","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ffcc00","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#050505","--solid":"#ffcc00","--solid-hover":"#ffd243","--solid-fg":"#050505","--ok":"#00ff66","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ff9900","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ff3b3b","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"18px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 0 0 2px #2338ff, 0 22px 60px rgba(0, 0, 0, 0.46)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Press Start 2P\", sans-serif","--font-body":"\"Press Start 2P\", sans-serif","--font-code":"\"Space Mono\", monospace","--font-mono":"\"Space Mono\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Retro arcade-inspired design with pixel fonts, dotted borders, playful high-contrast colors, and 8-bit game aesthetics.</p>\n<ul><li><strong>Visual style:</strong> high-contrast, playful, dotted borders</li><li><strong>Color stance:</strong> primary, secondary, success, warning, danger, info, surface/subtle layers</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#2A3FE5</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#F4B9B0</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#000000</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#000000</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#2A3FE5) for CTA emphasis.</li><li>Use Surface (#000000) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> desktop-first expressive scale</li><li><strong>Families:</strong> primary=Press Start 2P, display=Press Start 2P, mono=Space Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 8pt baseline grid</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#2A3FE5</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#2A3FE5) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}