er page"},{"name":"Accent (secondary)","hex":"#2f5b4f","role":"#2F5B4F (forest) — section dividers, tags"},{"name":"Muted","hex":"#8a817a","role":"#8A817A (mid-warm-grey) — timestamps, metadata"},{"name":"Surface","hex":"#ffffff","role":"#FFFFFF — elevated cards only"}],"fonts":[{"proprietary":false,"role":[{"lang":"pt-BR","message":"Monoespaçada"}],"kind":"mono","family":"JetBrains Mono","fallbacks":["ui-monospace","monospace"],"stack":"\"JetBrains Mono\", ui-monospace, monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/JetBrains+Mono","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/jetbrains-mono"}}],"tokens":[{"group":[{"lang":"pt-BR","message":"Superfície"}],"items":[{"name":"--bg","value":"#fbf6ee"},{"name":"--surface","value":"#fffdf8"},{"name":"--surface-warm","value":"#f1e3cf"}]},{"group":[{"lang":"pt-BR","message":"Texto"}],"items":[{"name":"--fg","value":"#201914"},{"name":"--fg-2","value":"#4c4037"},{"name":"--muted","value":"#7a6d63"},{"name":"--meta","value":"#9b5b32"}]},{"group":[{"lang":"pt-BR","message":"Borda"}],"items":[{"name":"--border","value":"#ded2c3"},{"name":"--border-soft","value":"#eee4d7"}]},{"group":[{"lang":"pt-BR","message":"Destaque"}],"items":[{"name":"--accent","value":"#9b5b32"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#4f8a4f"},{"name":"--warn","value":"#c9822f"},{"name":"--danger","value":"#b33a3a"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"17px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"28px"},{"name":"--text-2xl","value":"42px"},{"name":"--text-3xl","value":"64px"},{"name":"--text-4xl","value":"88px"},{"name":"--leading-body","value":"1.62"},{"name":"--leading-tight","value":"1"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"112px"},{"name":"--section-y-tablet","value":"80px"},{"name":"--section-y-phone","value":"56px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"24px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 20px 52px rgba(32, 25, 20, 0.12)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(155, 91, 50, 0.24)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#bd7e58","--primary-500-fg":"#111111","--neutral-400":"#ababa9","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 65%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1.062rem","--fs-h3":"1.75rem","--fs-h2":"2.625rem","--fs-h1":"4rem","--fs-hero":"5.5rem","--lh-body":"1.62","--lh-tight":"1.05","--display-tracking":"-0.025em","--section-y":"112px","--section-y-tablet":"80px","--container-max":"1180px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"240ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 4px rgba(155, 91, 50, 0.24)","--bg":"#fbf6ee","--surface":"#fffdf8","--surface-2":"#f1e3cf","--fg":"#201914","--fg-soft":"#4c4037","--muted":"color-mix(in oklab, #7a6d63 85%, var(--fg))","--meta":"color-mix(in oklab, #9b5b32 90%, var(--fg))","--border":"#ded2c3","--border-soft":"#eee4d7","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#9b5b32","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#9b5b32","--solid-hover":"#864e2a","--solid-fg":"#ffffff","--ok":"#4f8a4f","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#c9822f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#b33a3a","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 20px 52px rgba(32, 25, 20, 0.12)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"system-ui, sans-serif","--font-body":"system-ui, sans-serif","--font-code":"\"JetBrains Mono\", ui-monospace, monospace","--font-mono":"\"JetBrains Mono\", ui-monospace, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Quente, sem pressa, com cara de revista. Pense em &quot;uma coluna de entrevistas da New Yorker na internet&quot;. Espaço em branco generoso, boa legibilidade em textos longos, moldura contida. Lúdico, mas nunca caricato.</p>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Fundo:</strong> <code>#FAF7F2</code> (papel off-white quente)</li><li><strong>Primeiro plano:</strong> <code>#1C1A17</code> (quase preto, levemente quente)</li><li><strong>Destaque (primário):</strong> <code>#C0512F</code> (terracota) — usado em links, CTAs principais, no máximo 1 elemento de destaque por página</li><li><strong>Destaque (secundário):</strong> <code>#2F5B4F</code> (verde-floresta) — divisores de seção, tags</li><li><strong>Esmaecido:</strong> <code>#8A817A</code> (cinza quente médio) — datas e horários, metadados</li><li><strong>Superfície:</strong> <code>#FFFFFF</code> — só em cards elevados</li></ul>\n<p>Nunca use preto puro nem branco puro em nada que o usuário veja.</p>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Display / títulos:</strong> &quot;GT Sectra&quot; ou uma serifa de fallback (<code>'GT Sectra', 'Times New Roman', serif</code>)</li><li><strong>Corpo:</strong> &quot;Söhne&quot; ou uma sem serifa de fallback (<code>'Söhne', -apple-system, system-ui, sans-serif</code>)</li><li><strong>Mono:</strong> <code>'JetBrains Mono', ui-monospace, monospace</code> só para código</li><li>Escala (px): 12 · 14 · 16 · 20 · 28 · 40 · 56 · 80</li><li>Altura da linha: 1.6 no corpo, 1.2 no display</li><li>Espaçamento entre letras: -0.02em nos tamanhos de display acima de 40px; padrão no restante</li></ul>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Botões:</strong> preenchimento chapado, raio de 12px, padding-block de 14px, padding-inline de 20px. Primário = preenchimento terracota, rótulo off-white. Secundário = contorno de 1px na cor de primeiro plano, preenchimento transparente.</li><li><strong>Cards:</strong> fundo off-white, borda de 1px em verde-floresta a 8% de opacidade, raio de 16px, padding interno de 24–32px. Sem sombra, exceto no hover (y+2px, desfoque 16, primeiro plano a 6%).</li><li><strong>Campos:</strong> só sublinhado (sem caixa), linha de base de 1px na cor esmaecida, linha de base terracota no foco, padding vertical de 16px.</li><li><strong>Links:</strong> terracota, sublinhado de 1px em terracota a 40%, sem sublinhado no hover (troca por fundo terracota a 8%).</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"pt-BR","message":"Princípios de layout"}],"html":[{"lang":"pt-BR","message":"<ul><li>Grid de 12 colunas, largura máxima de 1200px, gutters de 24px.</li><li>Seções hero: mínimo de 72vh, máximo de 120vh. Conteúdo puxado para o topo, nunca centralizado na vertical.</li><li>Seções de corpo: espaçamento de 80px em cima e embaixo no desktop; 48px no tablet; 32px no celular.</li><li>Uma cor de destaque por tela. Se a página tem um hero terracota, os CTAs secundários usam só a cor de primeiro plano, não o verde-floresta.</li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"pt-BR","message":"Profundidade e elevação"}],"html":[{"lang":"pt-BR","message":"<p>Mínima. Apenas dois níveis de elevação:</p>\n<ul><li><strong>Plano (0):</strong> tudo, por padrão.</li><li><strong>Elevado (1):</strong> cards no hover, menus dropdown, CTAs flutuantes. Deslocamento y de 2px, desfoque de 16px, cor de primeiro plano com 6% de opacidade.</li></ul>\n<p>Sem sombras nos campos. Sem sombras no hero. Sem neumorfismo, sem glassmorphism.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<ul><li>✅ Deixe o espaço em branco respirar. Um título curto ocupando 50% da altura da viewport está correto.</li><li>✅ Use serifa nos números quando eles importam (preços, estatísticas).</li><li>✅ Coloque um elemento de destaque por página; o resto fica na cor de primeiro plano.</li><li>❌ Sem gradientes.</li><li>❌ Sem emojis nos textos do produto.</li><li>❌ Não use só a primeira letra maiúscula nos títulos — use iniciais maiúsculas em H1/H2 e só a primeira letra maiúscula do H3 para baixo.</li><li>❌ Nenhum border-radius acima de 24px; nenhum border-radius abaixo de 8px.</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Desktop ≥ 1024px:</strong> grid de 12 colunas, heros em altura total, colunas lado a lado.</li><li><strong>Tablet 640–1023px:</strong> grid de 8 colunas; o hero cai para 60vh; colunas empilham a partir de 3.</li><li><strong>Celular &lt; 640px:</strong> grid de 4 colunas; layout de coluna única; o hero cai para 50vh; todo o padding -33%.</li></ul>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<p>Ao gerar artefatos com este design system:</p>\n<ul><li>Comece pela tipografia e pelo espaço em branco; a moldura (bordas, sombras) é algo a subtrair.</li><li>Se você precisa de mais de um elemento de destaque numa tela, está exagerando — corte um.</li><li>Quando pedirem algo &quot;profissional&quot; ou &quot;sério&quot;, aposte ainda mais em serifa + espaço em branco. Quando pedirem algo &quot;moderno&quot;, este sistema não é a resposta certa; escolha outro DESIGN.md.</li><li>Os tokens de cor são inegociáveis. Não invente novos valores hex. Se o pedido precisar de uma cor fora desta paleta, deixe um comentário de aviso no artefato e use o token existente mais próximo.</li><li>Prefira 1 hero + 3–5 seções de corpo a 1 hero + 8 ou mais seções. Editorial significa contenção.</li></ul>"}]}]}