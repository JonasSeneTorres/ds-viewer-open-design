{"id":"warm-editorial","name":"Warm Editorial","source":{"name":"Warm Editorial","url":"https://open-design.ai/plugins/design-system-warm-editorial/"},"category":[{"lang":"en-US","message":"Starter"}],"intro":[{"lang":"pt-BR","message":"Uma estética de revista guiada pela serifa. Destaque terracota sobre papel off-white quente — bom para textos longos, conteúdo editorial e páginas de marketing guiadas pela marca."}],"roles":{"primary":"Muted","neutral":"Neutral","secondary":null},"palettes":[{"name":"Muted","base":"#9b5b32","derived":true,"scale":[{"step":50,"hex":"#fef5f0","exact":false},{"step":100,"hex":"#fee8db","exact":false},{"step":200,"hex":"#fdd2ba","exact":false},{"step":300,"hex":"#efbb9c","exact":false},{"step":400,"hex":"#d79c79","exact":false},{"step":500,"hex":"#bd7e58","exact":false},{"step":600,"hex":"#8a817a","exact":true},{"step":700,"hex":"#9b5b32","exact":true},{"step":800,"hex":"#713911","exact":false},{"step":900,"hex":"#562600","exact":false},{"step":950,"hex":"#371300","exact":false}]},{"name":"Accent (primary)","base":"#c0512f","derived":true,"scale":[{"step":50,"hex":"#fef5f2","exact":false},{"step":100,"hex":"#fee7e0","exact":false},{"step":200,"hex":"#fed1c3","exact":false},{"step":300,"hex":"#fdb29c","exact":false},{"step":400,"hex":"#f28a6c","exact":false},{"step":500,"hex":"#d86b4a","exact":false},{"step":600,"hex":"#c0512f","exact":true},{"step":700,"hex":"#b33a3a","exact":true},{"step":800,"hex":"#832501","exact":false},{"step":900,"hex":"#621700","exact":false},{"step":950,"hex":"#3f0700","exact":false}]},{"name":"Accent (secondary)","base":"#2f5b4f","derived":true,"scale":[{"step":50,"hex":"#edfaf6","exact":false},{"step":100,"hex":"#e1f1ec","exact":false},{"step":200,"hex":"#cee2db","exact":false},{"step":300,"hex":"#b4cec6","exact":false},{"step":400,"hex":"#93b3a9","exact":false},{"step":500,"hex":"#73988d","exact":false},{"step":600,"hex":"#598175","exact":false},{"step":700,"hex":"#3f6a5e","exact":false},{"step":800,"hex":"#2