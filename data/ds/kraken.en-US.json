 Plex Sans","Helvetica","Arial"],"stack":"\"Kraken-Brand\", \"IBM Plex Sans\", Helvetica, Arial, sans-serif","italic":false,"source":null},{"proprietary":true,"role":[{"lang":"en-US","message":"Body"}],"kind":"body","family":"Kraken-Product","fallbacks":["Helvetica Neue","Helvetica","Arial"],"stack":"\"Kraken-Product\", \"Helvetica Neue\", Helvetica, Arial, sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#0b1020"},{"name":"--surface","value":"#121a33"},{"name":"--surface-warm","value":"#1b2450"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#f8fafc"},{"name":"--fg-2","value":"#cbd5e1"},{"name":"--muted","value":"#8b95aa"},{"name":"--meta","value":"#7d5cff"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#26314f"},{"name":"--border-soft","value":"#1b2740"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#7132f5"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#00c853"},{"name":"--warn","value":"#ffb020"},{"name":"--danger","value":"#ff4d6d"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"11px"},{"name":"--text-sm","value":"13px"},{"name":"--text-base","value":"15px"},{"name":"--text-lg","value":"17px"},{"name":"--text-xl","value":"22px"},{"name":"--text-2xl","value":"30px"},{"name":"--text-3xl","value":"44px"},{"name":"--text-4xl","value":"60px"},{"name":"--leading-body","value":"1.48"},{"name":"--leading-tight","value":"1.08"},{"name":"--tracking-display","value":"-0.015em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"88px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"44px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"12px"},{"name":"--radius-lg","value":"18px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 24px 70px rgba(0, 0, 0, 0.42)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(113, 50, 245, 0.32)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"120ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"32px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"dark","--primary-500":"#9497a9","--primary-500-fg":"#111111","--neutral-400":"#aaabac","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#111111","--fs-xs":"0.6875rem","--fs-sm":"0.8125rem","--fs-base":"0.9375rem","--fs-h3":"1.375rem","--fs-h2":"1.875rem","--fs-h1":"2.75rem","--fs-hero":"3.75rem","--lh-body":"1.48","--lh-tight":"1.08","--display-tracking":"-0.015em","--section-y":"88px","--section-y-tablet":"64px","--container-max":"1280px","--gutter":"32px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"120ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"18px","--focus-ring":"0 0 0 4px rgba(113, 50, 245, 0.32)","--h3-weight":"700","--body-weight":"400","--btn-weight":"600","--btn-radius":"12px","--btn-pad-y":"13px","--btn-pad-x":"16px","--bg":"#0b1020","--surface":"#121a33","--surface-2":"#1b2450","--fg":"#f8fafc","--fg-soft":"#cbd5e1","--muted":"#8b95aa","--meta":"color-mix(in oklab, #7d5cff 80%, var(--fg))","--border":"#26314f","--border-soft":"#1b2740","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#7132f5","--accent-strong":"color-mix(in oklab, var(--accent) 65%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#7132f5","--solid-hover":"#612ad5","--solid-fg":"#ffffff","--ok":"#00c853","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ffb020","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ff4d6d","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 24px 70px rgba(0, 0, 0, 0.42)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Kraken-Brand\", \"IBM Plex Sans\", Helvetica, Arial, sans-serif","--font-body":"\"Kraken-Product\", \"Helvetica Neue\", Helvetica, Arial, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"700","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Kraken's website is a clean, trustworthy crypto exchange that uses purple as its commanding brand color. The design operates on white backgrounds with Kraken Purple (<code>#7132f5</code>, <code>#5741d8</code>, <code>#5b1ecf</code>) creating a distinctive, professional crypto identity. The proprietary Kraken-Brand font handles display headings with bold (700) weight and negative tracking, while Kraken-Product (with IBM Plex Sans fallback) serves as the UI workhorse.</p>\n<p><strong>Key Characteristics:</strong></p>\n<ul><li>Kraken Purple (<code>#7132f5</code>) as primary brand with darker variants (<code>#5741d8</code>, <code>#5b1ecf</code>)</li><li>Kraken-Brand (display) + Kraken-Product (UI) dual font system</li><li>Near-black (<code>#101114</code>) text with cool blue-gray neutral scale</li><li>12px radius buttons (rounded but not pill)</li><li>Subtle shadows (<code>rgba(0,0,0,0.03) 0px 4px 24px</code>) — whisper-level</li><li>Green accent (<code>#149e61</code>) for positive/success states</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<h3>Primary</h3>\n<ul><li><strong>Kraken Purple</strong> (<code>#7132f5</code>): Primary CTA, brand accent, links</li><li><strong>Purple Dark</strong> (<code>#5741d8</code>): Button borders, outlined variants</li><li><strong>Purple Deep</strong> (<code>#5b1ecf</code>): Deepest purple</li><li><strong>Purple Subtle</strong> (<code>rgba(133,91,251,0.16)</code>): Purple at 16% — subtle button backgrounds</li><li><strong>Near Black</strong> (<code>#101114</code>): Primary text</li></ul>\n<h3>Neutral</h3>\n<ul><li><strong>Cool Gray</strong> (<code>#686b82</code>): Primary neutral, borders at 24% opacity</li><li><strong>Silver Blue</strong> (<code>#9497a9</code>): Secondary text, muted elements</li><li><strong>White</strong> (<code>#ffffff</code>): Primary surface</li><li><strong>Border Gray</strong> (<code>#dedee5</code>): Divider borders</li></ul>\n<h3>Semantic</h3>\n<ul><li><strong>Green</strong> (<code>#149e61</code>): Success/positive at 16% opacity for badges</li><li><strong>Green Dark</strong> (<code>#026b3f</code>): Badge text</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<h3>Font Families</h3>\n<ul><li><strong>Display</strong>: <code>Kraken-Brand</code>, fallbacks: <code>IBM Plex Sans, Helvetica, Arial</code></li><li><strong>UI / Body</strong>: <code>Kraken-Product</code>, fallbacks: <code>Helvetica Neue, Helvetica, Arial</code></li></ul>\n<h3>Hierarchy</h3>\n<table><thead><tr><th>Role</th><th>Font</th><th>Size</th><th>Weight</th><th>Line Height</th><th>Letter Spacing</th></tr></thead><tbody><tr><td>Display Hero</td><td>Kraken-Brand</td><td>48px</td><td>700</td><td>1.17</td><td>-1px</td></tr><tr><td>Section Heading</td><td>Kraken-Brand</td><td>36px</td><td>700</td><td>1.22</td><td>-0.5px</td></tr><tr><td>Sub-heading</td><td>Kraken-Brand</td><td>28px</td><td>700</td><td>1.29</td><td>-0.5px</td></tr><tr><td>Feature Title</td><td>Kraken-Product</td><td>22px</td><td>600</td><td>1.20</td><td>normal</td></tr><tr><td>Body</td><td>Kraken-Product</td><td>16px</td><td>400</td><td>1.38</td><td>normal</td></tr><tr><td>Body Medium</td><td>Kraken-Product</td><td>16px</td><td>500</td><td>1.38</td><td>normal</td></tr><tr><td>Button</td><td>Kraken-Product</td><td>16px</td><td>500–600</td><td>1.38</td><td>normal</td></tr><tr><td>Caption</td><td>Kraken-Product</td><td>14px</td><td>400–700</td><td>1.43–1.71</td><td>normal</td></tr><tr><td>Small</td><td>Kraken-Product</td><td>12px</td><td>400–500</td><td>1.33</td><td>normal</td></tr><tr><td>Micro</td><td>Kraken-Product</td><td>7px</td><td>500</td><td>1.00</td><td>uppercase</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<h3>Buttons</h3>\n<p><strong>Primary Purple</strong></p>\n<ul><li>Background: <code>#7132f5</code></li><li>Text: <code>#ffffff</code></li><li>Padding: 13px 16px</li><li>Radius: 12px</li></ul>\n<p><strong>Purple Outlined</strong></p>\n<ul><li>Background: <code>#ffffff</code></li><li>Text: <code>#5741d8</code></li><li>Border: <code>1px solid #5741d8</code></li><li>Radius: 12px</li></ul>\n<p><strong>Purple Subtle</strong></p>\n<ul><li>Background: <code>rgba(133,91,251,0.16)</code></li><li>Text: <code>#7132f5</code></li><li>Padding: 8px</li><li>Radius: 12px</li></ul>\n<p><strong>White Button</strong></p>\n<ul><li>Background: <code>#ffffff</code></li><li>Text: <code>#101114</code></li><li>Radius: 10px</li><li>Shadow: <code>rgba(0,0,0,0.03) 0px 4px 24px</code></li></ul>\n<p><strong>Secondary Gray</strong></p>\n<ul><li>Background: <code>rgba(148,151,169,0.08)</code></li><li>Text: <code>#101114</code></li><li>Radius: 12px</li></ul>\n<h3>Badges</h3>\n<ul><li>Success: <code>rgba(20,158,97,0.16)</code> bg, <code>#026b3f</code> text, 6px radius</li><li>Neutral: <code>rgba(104,107,130,0.12)</code> bg, <code>#484b5e</code> text, 8px radius</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"en-US","message":"Layout Principles"}],"html":[{"lang":"en-US","message":"<h3>Spacing: 1px, 2px, 3px, 4px, 5px, 6px, 8px, 10px, 12px, 13px, 15px, 16px, 20px, 24px, 25px</h3>\n<h3>Border Radius: 3px, 6px, 8px, 10px, 12px, 16px, 9999px, 50%</h3>"}]},{"id":"depth-elevation","title":[{"lang":"en-US","message":"Depth & Elevation"}],"html":[{"lang":"en-US","message":"<ul><li>Subtle: <code>rgba(0,0,0,0.03) 0px 4px 24px</code></li><li>Micro: <code>rgba(16,24,40,0.04) 0px 1px 4px</code></li></ul>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<h3>Do</h3>\n<ul><li>Use Kraken Purple (#7132f5) for CTAs and links</li><li>Apply 12px radius on all buttons</li><li>Use Kraken-Brand for headings, Kraken-Product for body</li></ul>\n<h3>Don't</h3>\n<ul><li>Don't use pill buttons — 12px is the max radius for buttons</li><li>Don't use other purples outside the defined scale</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<p>Breakpoints: 375px, 425px, 640px, 768px, 1024px, 1280px, 1536px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<h3>Quick Color Reference</h3>\n<ul><li>Brand: Kraken Purple (<code>#7132f5</code>)</li><li>Dark variant: <code>#5741d8</code></li><li>Text: Near Black (<code>#101114</code>)</li><li>Secondary text: <code>#9497a9</code></li><li>Background: White (<code>#ffffff</code>)</li></ul>\n<h3>Example Component Prompts</h3>\n<ul><li>&quot;Create hero: white background. Kraken-Brand 48px weight 700, letter-spacing -1px. Purple CTA (#7132f5, 12px radius, 13px 16px padding).&quot;</li></ul>"}]}]}