e":"#ffffff"},{"name":"--surface-warm","value":"#f0e7d8"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#1c1b19"},{"name":"--fg-2","value":"#4b4740"},{"name":"--muted","value":"#746d63"},{"name":"--meta","value":"#a06a3b"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#ded6c9"},{"name":"--border-soft","value":"#eee7dc"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#a06a3b"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#3f8f5f"},{"name":"--warn","value":"#c4872c"},{"name":"--danger","value":"#b84a4a"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"19px"},{"name":"--text-xl","value":"26px"},{"name":"--text-2xl","value":"40px"},{"name":"--text-3xl","value":"60px"},{"name":"--text-4xl","value":"84px"},{"name":"--leading-body","value":"1.58"},{"name":"--leading-tight","value":"1.02"},{"name":"--tracking-display","value":"-0.02em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"112px"},{"name":"--section-y-tablet","value":"80px"},{"name":"--section-y-phone","value":"56px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"28px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 24px 64px rgba(28, 27, 25, 0.12)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(160, 106, 59, 0.24)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"170ms"},{"name":"--motion-base","value":"280ms"},{"name":"--ease-standard","value":"cubic-bezier(0.22, 1, 0.36, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1160px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#c4872c","--primary-500-fg":"#111111","--neutral-400":"#ababaa","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 65%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--bg":"#faf8f4","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#1c1b19","--fg-soft":"#4b4740","--muted":"#746d63","--border":"#ded6c9","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#a06a3b","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"var(--accent-strong)","--solid-fg":"#ffffff","--ok":"#3f8f5f","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#c4872c","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#b84a4a","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 24px 64px rgba(28, 27, 25, 0.12)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Inter\", sans-serif","--font-body":"\"Inter\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Apple-inspired premium aesthetic with precise spacing, modern typography, and a refined, polished visual language.</p>\n<ul><li><strong>Visual style:</strong> modern</li><li><strong>Color stance:</strong> primary, neutral, success, warning, danger</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#3B82F6</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#8B5CF6</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#FFFFFF</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#FFFFFF</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#3B82F6) for CTA emphasis.</li><li>Use Surface (#FFFFFF) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> 12/14/16/18/24/30/36</li><li><strong>Families:</strong> primary=Inter, display=Inter, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#3B82F6</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#3B82F6) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}