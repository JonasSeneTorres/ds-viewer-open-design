ack 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#22c55e"},{"name":"--warn","value":"#fbbf24"},{"name":"--danger","value":"#fb7185"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"18px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"36px"},{"name":"--text-3xl","value":"54px"},{"name":"--text-4xl","value":"76px"},{"name":"--leading-body","value":"1.52"},{"name":"--leading-tight","value":"1.06"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"68px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"24px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 24px 72px rgba(0, 0, 0, 0.42)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(96, 165, 250, 0.28)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"dark","font-synthesis-weight":"none","--primary-500":"#3b82f6","--primary-500-fg":"#111111","--neutral-400":"#a9abac","--neutral-400-fg":"#111111","--ok-ink":"var(--ok)","--ok-fg":"#111111","--warn-ink":"var(--warn)","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#111111","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.25rem","--fs-h1":"3.375rem","--fs-hero":"4.75rem","--lh-body":"1.52","--lh-tight":"1.06","--display-tracking":"-0.025em","--section-y":"96px","--section-y-tablet":"68px","--container-max":"1180px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"240ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 4px rgba(96, 165, 250, 0.28)","--secondary":"#9066f7","--secondary-fg":"#111111","--secondary-hover":"#9c7bfa","--bg":"#090b12","--surface":"#121722","--surface-2":"#1b2233","--fg":"#f8fafc","--fg-soft":"#cbd5e1","--muted":"#94a3b8","--meta":"#60a5fa","--border":"#2a3447","--border-soft":"#1d2636","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#60a5fa","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#06101d","--solid":"#60a5fa","--solid-hover":"#71aefb","--solid-fg":"#06101d","--ok":"#22c55e","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#fbbf24","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#fb7185","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 24px 72px rgba(0, 0, 0, 0.42)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Audiowide\", sans-serif","--font-body":"\"Roboto\", sans-serif","--font-code":"\"Anonymous Pro\", monospace","--font-mono":"\"Anonymous Pro\", monospace","--heading-weight":"400","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Forward-looking design with tech-inspired typography, modern layouts, and a sleek, innovation-driven aesthetic.</p>\n<ul><li><strong>Visual style:</strong> modern</li><li><strong>Color stance:</strong> primary, neutral, success, warning, danger</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#3B82F6</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#8B5CF6</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#FFFFFF</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#FFFFFF</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#3B82F6) for CTA emphasis.</li><li>Use Surface (#FFFFFF) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> desktop-first expressive scale</li><li><strong>Families:</strong> primary=Roboto, display=Audiowide, mono=Anonymous Pro</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#3B82F6</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#3B82F6) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}