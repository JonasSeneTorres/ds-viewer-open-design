{"id":"canva","name":"Canva","source":{"name":"Canva","url":"https://open-design.ai/plugins/design-system-canva/"},"category":[{"lang":"en-US","message":"Design & Creative"}],"intro":[{"lang":"en-US","message":"Visual creation platform. Vivid purple-blue gradient, generous spacing, friendly geometry."}],"roles":{"primary":"Canva Purple","neutral":"Neutral","secondary":"Canva Cyan"},"palettes":[{"name":"Canva Purple","base":"#7d2ae8","derived":true,"scale":[{"step":50,"hex":"#f7f5fe","exact":false},{"step":100,"hex":"#eeeafd","exact":false},{"step":200,"hex":"#dfd5ff","exact":false},{"step":300,"hex":"#ccbcfd","exact":false},{"step":400,"hex":"#b396fd","exact":false},{"step":500,"hex":"#9b87f5","exact":true},{"step":600,"hex":"#8a40f7","exact":false},{"step":700,"hex":"#7d2ae8","exact":true},{"step":800,"hex":"#5b01b2","exact":false},{"step":900,"hex":"#420086","exact":false},{"step":950,"hex":"#280057","exact":false}]},{"name":"Canva Cyan","base":"#00c4cc","derived":true,"scale":[{"step":50,"hex":"#e0feff","exact":false},{"step":100,"hex":"#b7fbff","exact":false},{"step":200,"hex":"#71f3fa","exact":false},{"step":300,"hex":"#4cdfe6","exact":false},{"step":400,"hex":"#00c4cc","exact":true},{"step":500,"hex":"#0ca3a9","exact":false},{"step":600,"hex":"#08888d","exact":false},{"step":700,"hex":"#026e73","exact":false},{"step":800,"hex":"#065559","exact":false},{"step":900,"hex":"#043e40","exact":false},{"step":950,"hex":"#002527","exact":false}]},{"name":"Canva Pink","base":"#ff5757","derived":true,"scale":[{"step":50,"hex":"#fdf5f4","exact":false},{"step":100,"hex":"#fee7e4","exact":false},{"step":200,"hex":"#fdd0cc","exact":false},{"step":300,"hex":"#ffb0a9","exact":false},{"step":400,"hex":"#fe7f79","exact":false},{"step":500,"hex":"#ff5757","exact":true},{"step":600,"hex":"#d0353a","exact":false},{"step":700,"hex":"#ae2229","exact":false},{"step":800,"hex":"#8b121b","exact":false},{"step":900,"hex":"#680510","exact":false},{"step":950,"hex":"#420106","exact":false}]},{"name":"Surface Cool","base":"#eef0fc","derived":true,"scale":[{"step":50,"hex":"#f5f6fc","exact":false},{"step":100,"hex":"#eef0fc","exact":true},{"step":200,"hex":"#dadce7","exact":false},{"step":300,"hex":"#c5c7d1","exact":false},{"step":400,"hex":"#a9aab3","exact":false},{"step":500,"hex":"#8d8f96","exact":false},{"step":600,"hex":"#76777d","exact":false},{"step":700,"hex":"#5f6064","exact":false},{"step":800,"hex":"#4a4a4d","exact":false},{"step":900,"hex":"#353537","exact":false},{"step":950,"hex":"#1f1f21","exact":false}]},{"name":"Ink Primary","base":"#0e1318","derived":true,"scale":[{"step":50,"hex":"#f5f7f9","exact":false},{"step":100,"hex":"#ebedef","exact":false},{"step":200,"hex":"#dbdcde","exact":false},{"step":300,"hex":"#c6c7c9","exact":false},{"step":400,"hex":"#3ea6ff","exact":true},{"step":500,"hex":"#8d8f92","exact":false},{"step":600,"hex":"#74787c","exact":false},{"step":700,"hex":"#5c6165","exact":false},{"step":800,"hex":"#464b50","exact":false},{"step":900,"hex":"#31363b","exact":false},{"step":950,"hex":"#0e1318","exact":true}]},{"name":"Success","base":"#00b894","derived":true,"scale":[{"step":50,"hex":"#e2fff4","exact":false},{"step":100,"hex":"#b6ffe7","exact":false},{"step":200,"hex":"#84f5d4","exact":false},{"step":300,"hex":"#62e2be","exact":false},{"step":400,"hex":"#48c997","exact":true},{"step":500,"hex":"#00b894","exact":true},{"step":600,"hex":"#068c70","exact":false},{"step":700,"hex":"#04715a","exact":false},{"step":800,"hex":"#005845","exact":false},{"step":900,"hex":"#033f32","exact":false},{"step":950,"hex":"#00261d","exact":false}]},{"name":"Warning","base":"#ffb020","derived":true,"scale":[{"step":50,"hex":"#fff5e9","exact":false},{"step":100,"hex":"#ffe9cd","exact":false},{"step":200,"hex":"#ffd59b","exact":false},{"step":300,"hex":"#ffb020","exact":true},{"step":400,"hex":"#e39a00","exact":false},{"step":500,"hex":"#be8108","exact":false},{"step":600,"hex":"#a06b03","exact":false},{"step":700,"hex":"#825600","exact":false},{"step":800,"hex":"#654201","exact":false},{"step":900,"hex":"#483006","exact":false},{"step":950,"hex":"#2b1c06","exact":false}]},{"name":"Tangerine","base":"#ff9633","derived":true,"scale":[{"step":50,"hex":"#fff5ed","exact":false},{"step":100,"hex":"#fee8d8","exact":false},{"step":200,"hex":"#fed3b3","exact":false},{"step":300,"hex":"#feb57c","exact":false},{"step":400,"hex":"#ff9633","exact":true},{"step":500,"hex":"#d27304","exact":false},{"step":600,"hex":"#b05f00","exact":false},{"step":700,"hex":"#8f4d04","exact":false},{"step":800,"hex":"#703a00","exact":false},{"step":900,"hex":"#522900","exact":false},{"step":950,"hex":"#301905","exact":false}]},{"name":"Neutral","base":"#5f6368","derived":true,"scale":[{"step":50,"hex":"#f4f5f7","exact":true},{"step":100,"hex":"#ebedf0","exact":false},{"step":200,"hex":"#e1e3e6","exact":true},{"step":300,"hex":"#c7cdd3","exact":true},{"step":400,"hex":"#9aa0a6","exact":true},{"step":500,"hex":"#8c8f94","exact":false},{"step":600,"hex":"#74787d","exact":false},{"step":700,"hex":"#5f6368","exact":true},{"step":800,"hex":"#474b4f","exact":false},{"step":900,"hex":"#3c4043","exact":true},{"step":950,"hex":"#1d1f23","exact":false}]}],"colors":[{"name":"Canva Purple","hex":"#7d2ae8","role":"(#7d2ae8): Brand primary; gradient origin."},{"name":"Canva Cyan","hex":"#00c4cc","role":"(#00c4cc): Brand secondary; gradient terminus."},{"name":"Canva Pink","hex":"#ff5757","role":"(#ff5757): Tertiary brand accent (Magic Studio)."},{"name":"Canvas","hex":"#ffffff","role":"(#ffffff): Primary background."},{"name":"Surface Subtle","hex":"#f4f5f7","role":"(#f4f5f7): Section break, sidebar."},{"name":"Surface Inset","hex":"#e8eaed","role":"(#e8eaed): Disabled, inset block."},{"name":"Surface Cool","hex":"#eef0fc","role":"(#eef0fc): Hover tint on purple-themed cards."},{"name":"Ink Primary","hex":"#0e1318","role":"(#0e1318): Primary text."},{"name":"Ink Secondary","hex":"#3c4043","role":"(#3c4043): Body prose."},{"name":"Ink Muted","hex":"#5f6368","role":"(#5f6368): Captions, descriptions."},{"name":"Ink Faint","hex":"#9aa0a6","role":"(#9aa0a6): Placeholder, disabled label."},{"name":"Success","hex":"#00b894","role":"(#00b894): Saved, exported."},{"name":"Warning","hex":"#ffb020","role":"(#ffb020): Storage limit, advisory."},{"name":"Info","hex":"#0d99ff","role":"(#0d99ff): Tip, link."},{"name":"Coral","hex":"#ff7059","role":"(#ff7059): Social posts."},{"name":"Tangerine","hex":"#ff9633","role":"(#ff9633): Marketing."},{"name":"Mint","hex":"#48c997","role":"(#48c997): Education."},{"name":"Sky","hex":"#3ea6ff","role":"(#3ea6ff): Business."},{"name":"Lavender","hex":"#9b87f5","role":"(#9b87f5): Personal."},{"name":"Border Default","hex":"#e1e3e6","role":"(#e1e3e6): Standard hairline."},{"name":"Border Strong","hex":"#c7cdd3","role":"(#c7cdd3): Emphasized border, hover state."}],"fonts":[{"role":[{"lang":"en-US","message":"Headings"}],"kind":"display","family":"Canva Sans","fallbacks":["YS Text","system-ui","-apple-system","sans-serif"],"stack":"\"Canva Sans\", \"YS Text\", system-ui, -apple-system, sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Editorial (rare)"}],"kind":"primary","family":"Canva Sans Display","fallbacks":["Canva Sans","sans-serif"],"stack":"\"Canva Sans Display\", \"Canva Sans\", sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Monospace"}],"kind":"mono","family":"JetBrains Mono","fallbacks":["ui-monospace","Menlo","Consolas","monospace"],"stack":"\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/JetBrains+Mono","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/jetbrains-mono"}}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#ffffff"},{"name":"--surface","value":"#f4f5f7"},{"name":"--surface-warm","value":"var(--surface)"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#0e1318"},{"name":"--fg-2","value":"#3c4043"},{"name":"--muted","value":"#5f6368"},{"name":"--meta","value":"#9aa0a6"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#e1e3e6"},{"name":"--border-soft","value":"var(--border)"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#7d2ae8"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"#6815d4"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#00b894"},{"name":"--warn","value":"#ffb020"},{"name":"--danger","value":"#ff5757"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"11px"},{"name":"--text-sm","value":"12px"},{"name":"--text-base","value":"14px"},{"name":"--text-lg","value":"16px"},{"name":"--text-xl","value":"18px"},{"name":"--text-2xl","value":"24px"},{"name":"--text-3xl","value":"36px"},{"name":"--text-4xl","value":"64px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.15"},{"name":"--tracking-display","value":"-0.02em"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"en-US","message":"Radius"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"12px"},{"name":"--radius-lg","value":"16px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 2px 8px rgba(0, 0, 0, 0.06)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px rgba(125, 42, 232, 0.16)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"180ms"},{"name":"--motion-base","value":"280ms"},{"name":"--ease-standard","value":"cubic-bezier(0.4, 0, 0.2, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1320px"},{"name":"--container-gutter-desktop","value":"32px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#9b87f5","--primary-500-fg":"#111111","--neutral-400":"#9aa0a6","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 65%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 70%, var(--fg))","--danger-fg":"#111111","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.125rem","--fs-h2":"1.5rem","--fs-h1":"2.25rem","--fs-hero":"4rem","--lh-body":"1.5","--lh-tight":"1.15","--display-tracking":"-0.02em","--section-y":"96px","--section-y-tablet":"64px","--container-max":"1320px","--gutter":"32px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"180ms","--motion-base":"280ms","--ease":"cubic-bezier(0.4, 0, 0.2, 1)","--radius-lg":"16px","--focus-ring":"0 0 0 3px rgba(125, 42, 232, 0.16)","--bg":"#ffffff","--surface":"#f4f5f7","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#0e1318","--fg-soft":"#3c4043","--muted":"#5f6368","--meta":"color-mix(in oklab, #9aa0a6 60%, var(--fg))","--border":"#e1e3e6","--border-soft":"#e1e3e6","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#7d2ae8","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#7d2ae8","--solid-hover":"#6815d4","--solid-fg":"#ffffff","--ok":"#00b894","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ffb020","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ff5757","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 2px 8px rgba(0, 0, 0, 0.06)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Canva Sans\", \"YS Text\", system-ui, -apple-system, sans-serif","--font-body":"\"Canva Sans Display\", \"Canva Sans\", sans-serif","--font-code":"\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace","--font-mono":"\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Canva is the friendly face of design tools — the brand makes a point of looking inviting where Adobe looks intimidating. The page is built on a clean white canvas (<code>#ffffff</code>) with a signature <strong>purple-to-blue gradient</strong> (<code>#7d2ae8</code> → <code>#00c4cc</code>) used in the brand mark, hero buttons, and Pro/Magic moments. Surfaces are generously padded, edges are gently rounded (8–16px), and shadows are soft and cool-toned.</p>\n<p>Typography uses <strong>Canva Sans</strong> (a custom geometric sans) for chrome and prose, with rounded letterforms that share DNA with brands like Airbnb and Asana. Weight contrast does the heavy lifting — 800 for hero display, 700 for section heads, 400 for body — while size hierarchy is more compressed than typical product brands so cards and templates read at a glance.</p>\n<p>The shape system is ultra-soft: 12px on most cards, 16–20px on larger panels, 9999px on chips. Buttons are rectangles with a subtle elevation shadow (<code>0 2px 8px rgba(0,0,0,0.06)</code>) that grows on hover. Iconography is filled and rounded, never line-only — Canva's icons speak the same shape language as its UI.</p>\n<p><strong>Key Characteristics:</strong></p>\n<ul><li>White canvas with a violet-to-cyan gradient (<code>#7d2ae8</code> → <code>#00c4cc</code>)</li><li>Canva Sans (rounded geometric) for everything; weight contrast over color</li><li>12–20px radii everywhere; 9999px pills for chips and tags</li><li>Soft cool-toned shadows that grow on hover</li><li>Filled rounded iconography — never outlined</li><li>Vibrant secondary palette (coral, mint, tangerine) for category tags</li><li>Pro/Magic moments lit by a static gradient — no animation</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<h3>Brand Gradient</h3>\n<ul><li><strong>Canva Purple</strong> (<code>#7d2ae8</code>): Brand primary; gradient origin.</li><li><strong>Canva Cyan</strong> (<code>#00c4cc</code>): Brand secondary; gradient terminus.</li><li><strong>Canva Pink</strong> (<code>#ff5757</code>): Tertiary brand accent (Magic Studio).</li></ul>\n<h3>Surface</h3>\n<ul><li><strong>Canvas</strong> (<code>#ffffff</code>): Primary background.</li><li><strong>Surface Subtle</strong> (<code>#f4f5f7</code>): Section break, sidebar.</li><li><strong>Surface Inset</strong> (<code>#e8eaed</code>): Disabled, inset block.</li><li><strong>Surface Cool</strong> (<code>#eef0fc</code>): Hover tint on purple-themed cards.</li></ul>\n<h3>Ink &amp; Text</h3>\n<ul><li><strong>Ink Primary</strong> (<code>#0e1318</code>): Primary text.</li><li><strong>Ink Secondary</strong> (<code>#3c4043</code>): Body prose.</li><li><strong>Ink Muted</strong> (<code>#5f6368</code>): Captions, descriptions.</li><li><strong>Ink Faint</strong> (<code>#9aa0a6</code>): Placeholder, disabled label.</li></ul>\n<h3>Semantic</h3>\n<ul><li><strong>Success</strong> (<code>#00b894</code>): Saved, exported.</li><li><strong>Warning</strong> (<code>#ffb020</code>): Storage limit, advisory.</li><li><strong>Error</strong> (<code>#ff5757</code>): Validation, destructive.</li><li><strong>Info</strong> (<code>#0d99ff</code>): Tip, link.</li></ul>\n<h3>Category Accents (Template Tags)</h3>\n<ul><li><strong>Coral</strong> (<code>#ff7059</code>): Social posts.</li><li><strong>Tangerine</strong> (<code>#ff9633</code>): Marketing.</li><li><strong>Mint</strong> (<code>#48c997</code>): Education.</li><li><strong>Sky</strong> (<code>#3ea6ff</code>): Business.</li><li><strong>Lavender</strong> (<code>#9b87f5</code>): Personal.</li></ul>\n<h3>Border</h3>\n<ul><li><strong>Border Default</strong> (<code>#e1e3e6</code>): Standard hairline.</li><li><strong>Border Strong</strong> (<code>#c7cdd3</code>): Emphasized border, hover state.</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<h3>Font Family</h3>\n<ul><li><strong>Display / UI / Body</strong>: <code>Canva Sans</code>, with fallback: <code>'YS Text', system-ui, -apple-system, sans-serif</code></li><li><strong>Editorial (rare)</strong>: <code>Canva Sans Display</code>, with fallback: <code>'Canva Sans', sans-serif</code></li><li><strong>Code (devtools only)</strong>: <code>JetBrains Mono</code>, with fallback: <code>ui-monospace, Menlo, Consolas, monospace</code></li></ul>\n<h3>Hierarchy</h3>\n<table><thead><tr><th>Role</th><th>Font</th><th>Size</th><th>Weight</th><th>Line Height</th><th>Letter Spacing</th><th>Notes</th></tr></thead><tbody><tr><td>Hero</td><td>Canva Sans</td><td>64px (4rem)</td><td>800</td><td>1.05</td><td>-0.02em</td><td>Marketing hero, &quot;Design anything.&quot;</td></tr><tr><td>H1</td><td>Canva Sans</td><td>36px (2.25rem)</td><td>700</td><td>1.15</td><td>-0.01em</td><td>Page heading</td></tr><tr><td>H2</td><td>Canva Sans</td><td>24px (1.5rem)</td><td>700</td><td>1.2</td><td>-0.005em</td><td>Section heading</td></tr><tr><td>H3</td><td>Canva Sans</td><td>18px (1.125rem)</td><td>600</td><td>1.3</td><td>normal</td><td>Sub-section, card title</td></tr><tr><td>Body Large</td><td>Canva Sans</td><td>16px (1rem)</td><td>400</td><td>1.55</td><td>normal</td><td>Lede, marketing body</td></tr><tr><td>Body</td><td>Canva Sans</td><td>14px (0.875rem)</td><td>400</td><td>1.5</td><td>normal</td><td>Standard UI prose</td></tr><tr><td>Caption</td><td>Canva Sans</td><td>12px (0.75rem)</td><td>500</td><td>1.4</td><td>0.005em</td><td>Metadata, hint text</td></tr><tr><td>Button</td><td>Canva Sans</td><td>14px (0.875rem)</td><td>600</td><td>1.2</td><td>normal</td><td>Default button label</td></tr><tr><td>Tag</td><td>Canva Sans</td><td>11px (0.6875rem)</td><td>600</td><td>1.2</td><td>0.04em</td><td>Uppercase category chip</td></tr></tbody></table>\n<h3>Principles</h3>\n<ul><li><strong>Weight contrast over color contrast</strong>: hierarchy steps via 800→700→600→400; the surface stays neutral.</li><li><strong>Tight line-height for cards</strong>: card titles use 1.15–1.2 so a 3-line title still fits a 4:3 thumbnail.</li><li><strong>No display serif</strong>: Canva is sans-only across all surfaces; serifs appear only as user-selectable template fonts inside the editor.</li></ul>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<h3>Buttons</h3>\n<p><strong>Primary (Gradient)</strong></p>\n<ul><li>Background: <code>linear-gradient(135deg, #7d2ae8, #00c4cc)</code></li><li>Text: <code>#ffffff</code></li><li>Padding: 12px 20px</li><li>Radius: 8px</li><li>Shadow: <code>0 2px 8px rgba(125, 42, 232, 0.2)</code></li><li>Hover: shadow grows to <code>0 4px 14px rgba(125, 42, 232, 0.3)</code></li><li>Use: hero CTAs, &quot;Try Canva Pro&quot;</li></ul>\n<p><strong>Primary (Solid Purple)</strong></p>\n<ul><li>Background: <code>#7d2ae8</code></li><li>Text: <code>#ffffff</code></li><li>Padding: 12px 20px</li><li>Radius: 8px</li><li>Hover: <code>#6815d4</code></li></ul>\n<p><strong>Secondary</strong></p>\n<ul><li>Background: <code>#ffffff</code></li><li>Text: <code>#0e1318</code></li><li>Border: 1px solid <code>#e1e3e6</code></li><li>Radius: 8px</li><li>Hover: background <code>#f4f5f7</code>, border <code>#c7cdd3</code></li></ul>\n<p><strong>Subtle / Tertiary</strong></p>\n<ul><li>Background: <code>rgba(125, 42, 232, 0.08)</code></li><li>Text: <code>#7d2ae8</code></li><li>Hover: background <code>rgba(125, 42, 232, 0.14)</code></li></ul>\n<h3>Cards / Template Tiles</h3>\n<ul><li>Background: <code>#ffffff</code></li><li>Border: 1px solid <code>#e1e3e6</code></li><li>Radius: 12px</li><li>Shadow at rest: <code>0 1px 3px rgba(0,0,0,0.04)</code></li><li>Shadow on hover: <code>0 8px 24px rgba(0,0,0,0.08)</code>, lift 2px</li><li>Aspect ratio: thumbnail respects template (1:1, 4:3, 9:16)</li></ul>\n<h3>Inputs</h3>\n<ul><li>Background: <code>#ffffff</code></li><li>Border: 1px solid <code>#e1e3e6</code></li><li>Radius: 8px</li><li>Padding: 10px 14px</li><li>Focus: border <code>#7d2ae8</code>, ring <code>0 0 0 3px rgba(125, 42, 232, 0.16)</code></li></ul>\n<h3>Chips / Tags</h3>\n<ul><li>Background: category-tinted soft.</li><li>Text: matching strong category color.</li><li>Padding: 4px 10px</li><li>Radius: 9999px</li><li>Font: 11px / 600 / uppercase</li></ul>\n<h3>Pro Badge</h3>\n<ul><li>Background: <code>linear-gradient(135deg, #7d2ae8, #ff5757)</code></li><li>Text: <code>#ffffff</code></li><li>Padding: 2px 8px</li><li>Radius: 9999px</li><li>Font: 10px / 700 / uppercase</li></ul>"}]},{"id":"spacing-layout","title":[{"lang":"en-US","message":"Spacing & Layout"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Base unit</strong>: 4px. Scale: 4, 8, 12, 16, 24, 32, 48, 64, 96.</li><li><strong>Container</strong>: max 1320px, 32px gutter.</li><li><strong>Sidebar (editor)</strong>: 320px wide; collapses to 56px icons.</li><li><strong>Card grid gap</strong>: 16px on mobile, 24px on desktop.</li></ul>"}]},{"id":"motion","title":[{"lang":"en-US","message":"Motion"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Duration</strong>: 180ms for hover; 280ms for menu open; 420ms for editor sidebar collapse.</li><li><strong>Easing</strong>: <code>cubic-bezier(0.4, 0, 0.2, 1)</code> (Material-style).</li><li><strong>Card lift</strong>: translateY(-2px) + shadow grow on hover, single transition.</li></ul>"}]},{"id":"usage-guardrails","title":[{"lang":"en-US","message":"Usage Guardrails"}],"html":[{"lang":"en-US","message":"<ul><li>Keep the white canvas dominant; the purple-to-cyan gradient should signal brand, Pro, Magic, or one primary CTA moment.</li><li>Use filled rounded icons and soft 12-20px geometry rather than sharp enterprise controls.</li><li>Keep category colors in tags, templates, and supporting metadata; do not let them compete with the main gradient action.</li><li>Preserve the friendly editor/product tone: dense tool UI is fine, but it should stay approachable and visually generous.</li></ul>"}]}]}