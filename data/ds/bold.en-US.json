dius"}],"items":[{"name":"--radius-sm","value":"4px"},{"name":"--radius-md","value":"8px"},{"name":"--radius-lg","value":"12px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"en-US","message":"Elevation"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 16px 40px rgba(0, 0, 0, 0.10)"}]},{"group":[{"lang":"en-US","message":"Focus"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px rgba(17, 17, 17, 0.18)"}]},{"group":[{"lang":"en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"light","font-synthesis-weight":"none","--primary-500":"#3d96da","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 85%, var(--fg))","--ok-fg":"#ffffff","--warn-ink":"color-mix(in oklab, var(--warn) 75%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2.25rem","--fs-h1":"3.375rem","--fs-hero":"4.75rem","--lh-body":"1.52","--lh-tight":"1.06","--display-tracking":"-0.025em","--section-y":"96px","--section-y-tablet":"68px","--container-max":"1180px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"240ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 3px rgba(17, 17, 17, 0.18)","--bg":"#ffffff","--surface":"#f7f7f7","--surface-2":"#eeeeee","--fg":"#111111","--fg-soft":"#3a3a3a","--muted":"color-mix(in oklab, #707070 80%, var(--fg))","--meta":"#111111","--border":"#d9d9d9","--border-soft":"#eeeeee","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#111111","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#111111","--solid-hover":"#0d0d0d","--solid-fg":"#ffffff","--ok":"#168a46","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#b7791f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#c53030","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 16px 40px rgba(0, 0, 0, 0.10)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Archivo Black\", sans-serif","--font-body":"\"Archivo Black\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"400","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Strong visual presence with heavyweight typography, high-contrast colors, and commanding layouts.</p>\n<ul><li><strong>Visual style:</strong> bold</li><li><strong>Color stance:</strong> primary, secondary</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#0077BC</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#009866</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#111111</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#111111</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#0077BC) for CTA emphasis.</li><li>Use Surface (#111111) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> desktop-first expressive scale</li><li><strong>Families:</strong> primary=Archivo Black, display=Archivo Black, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#0077BC</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#0077BC) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}