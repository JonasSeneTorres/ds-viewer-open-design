lse},{"step":700,"hex":"#606060","exact":false},{"step":800,"hex":"#4a4a4a","exact":false},{"step":900,"hex":"#353535","exact":false},{"step":950,"hex":"#141414","exact":true}]}],"colors":[{"name":"Primary","hex":"#1856ff","role":"#1856FF — Token from style foundations."},{"name":"Secondary","hex":"#3a344e","role":"#3A344E — Token from style foundations."},{"name":"Success","hex":"#07ca6b","role":"#07CA6B — Token from style foundations."},{"name":"Warning","hex":"#e89558","role":"#E89558 — Token from style foundations."},{"name":"Danger","hex":"#ea2143","role":"#EA2143 — Token from style foundations."},{"name":"Surface","hex":"#ffffff","role":"#FFFFFF — Token from style foundations."},{"name":"Text","hex":"#141414","role":"#141414 — Token from style foundations."}],"fonts":[{"role":[{"lang":"pt-BR","message":"Principal / Títulos"}],"kind":"display","family":"Plus Jakarta Sans","fallbacks":[],"stack":"\"Plus Jakarta Sans\", sans-serif","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.google.com/specimen/Plus+Jakarta+Sans","link":"<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap\">","import":"@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap');","npm":"npm i @fontsource/plus-jakarta-sans"}},{"role":[{"lang":"pt-BR","message":"Monoespaçada"}],"kind":"mono","family":"JetBrains Mono","fallbacks":[],"stack":"\"JetBrains Mono\", monospace","italic":true,"source":{"kind":"google","css":"https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap","page":"https://fonts.