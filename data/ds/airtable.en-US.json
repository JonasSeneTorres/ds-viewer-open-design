utter-phone":"12px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"24px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--h3-weight":"500","--body-weight":"400","--btn-weight":"500","--bg":"#ffffff","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#181d26","--fg-soft":"#333333","--muted":"color-mix(in oklab, var(--fg) 65%, var(--bg))","--meta":"var(--muted)","--border":"#e0e2e6","--border-soft":"#eef0f3","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#1b61c9","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#1b61c9","--solid-hover":"#254fad","--solid-fg":"#ffffff","--ok":"#006400","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"12px","--radius-pill":"9999px","--shadow-card":"0 0 1px rgba(0, 0, 0, 0.32), 0 0 2px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(45, 127, 249, 0.28), inset 0 0 0 0.5px rgba(0, 0, 0, 0.06)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Haas Groot Disp\", Haas, sans-serif","--font-body":"\"Haas\", -apple-system, system-ui, \"Segoe UI\", Roboto, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"400","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Airtable's website is a clean, enterprise-friendly platform that communicates &quot;sophisticated simplicity&quot; through a white canvas with deep navy text (<code>#181d26</code>) and Airtable Blue (<code>#1b61c9</code>) as the primary interactive accent. The Haas font family (display + text variants) creates a Swiss-precision typography system with positive letter-spacing throughout.</p>\n<p><strong>Key Characteristics:</strong></p>\n<ul><li>White canvas with deep navy text (<code>#181d26</code>)</li><li>Airtable Blue (<code>#1b61c9</code>) as primary CTA and link color</li><li>Haas + Haas Groot Disp dual font system</li><li>Positive letter-spacing on body text (0.08px–0.28px)</li><li>12px radius buttons, 16px–32px for cards</li><li>Multi-layer blue-tinted shadow: <code>rgba(45,127,249,0.28) 0px 1px 3px</code></li><li>Semantic theme tokens: <code>--theme_*</code> CSS variable naming</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"en-US","message":"Color Palette & Roles"}],"html":[{"lang":"en-US","message":"<h3>Primary</h3>\n<ul><li><strong>Deep Navy</strong> (<code>#181d26</code>): Primary text</li><li><strong>Airtable Blue</strong> (<code>#1b61c9</code>): CTA buttons, links</li><li><strong>White</strong> (<code>#ffffff</code>): Primary surface</li><li><strong>Spotlight</strong> (<code>rgba(249,252,255,0.97)</code>): <code>--theme_button-text-spotlight</code></li></ul>\n<h3>Semantic</h3>\n<ul><li><strong>Success Green</strong> (<code>#006400</code>): <code>--theme_success-text</code></li><li><strong>Weak Text</strong> (<code>rgba(4,14,32,0.69)</code>): <code>--theme_text-weak</code></li><li><strong>Secondary Active</strong> (<code>rgba(7,12,20,0.82)</code>): <code>--theme_button-text-secondary-active</code></li></ul>\n<h3>Neutral</h3>\n<ul><li><strong>Dark Gray</strong> (<code>#333333</code>): Secondary text</li><li><strong>Mid Blue</strong> (<code>#254fad</code>): Link/accent blue variant</li><li><strong>Border</strong> (<code>#e0e2e6</code>): Card borders</li><li><strong>Light Surface</strong> (<code>#f8fafc</code>): Subtle surface</li></ul>\n<h3>Shadows</h3>\n<ul><li><strong>Blue-tinted</strong> (<code>rgba(0,0,0,0.32) 0px 0px 1px, rgba(0,0,0,0.08) 0px 0px 2px, rgba(45,127,249,0.28) 0px 1px 3px, rgba(0,0,0,0.06) 0px 0px 0px 0.5px inset</code>)</li><li><strong>Soft</strong> (<code>rgba(15,48,106,0.05) 0px 0px 20px</code>)</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"en-US","message":"Typography Rules"}],"html":[{"lang":"en-US","message":"<h3>Font Families</h3>\n<ul><li><strong>Primary</strong>: <code>Haas</code>, fallbacks: <code>-apple-system, system-ui, Segoe UI, Roboto</code></li><li><strong>Display</strong>: <code>Haas Groot Disp</code>, fallback: <code>Haas</code></li></ul>\n<h3>Hierarchy</h3>\n<table><thead><tr><th>Role</th><th>Font</th><th>Size</th><th>Weight</th><th>Line Height</th><th>Letter Spacing</th></tr></thead><tbody><tr><td>Display Hero</td><td>Haas</td><td>48px</td><td>400</td><td>1.15</td><td>normal</td></tr><tr><td>Display Bold</td><td>Haas Groot Disp</td><td>48px</td><td>900</td><td>1.50</td><td>normal</td></tr><tr><td>Section Heading</td><td>Haas</td><td>40px</td><td>400</td><td>1.25</td><td>normal</td></tr><tr><td>Sub-heading</td><td>Haas</td><td>32px</td><td>400–500</td><td>1.15–1.25</td><td>normal</td></tr><tr><td>Card Title</td><td>Haas</td><td>24px</td><td>400</td><td>1.20–1.30</td><td>0.12px</td></tr><tr><td>Feature</td><td>Haas</td><td>20px</td><td>400</td><td>1.25–1.50</td><td>0.1px</td></tr><tr><td>Body</td><td>Haas</td><td>18px</td><td>400</td><td>1.35</td><td>0.18px</td></tr><tr><td>Body Medium</td><td>Haas</td><td>16px</td><td>500</td><td>1.30</td><td>0.08–0.16px</td></tr><tr><td>Button</td><td>Haas</td><td>16px</td><td>500</td><td>1.25–1.30</td><td>0.08px</td></tr><tr><td>Caption</td><td>Haas</td><td>14px</td><td>400–500</td><td>1.25–1.35</td><td>0.07–0.28px</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"en-US","message":"Component Stylings"}],"html":[{"lang":"en-US","message":"<h3>Buttons</h3>\n<ul><li><strong>Primary Blue</strong>: <code>#1b61c9</code>, white text, 16px 24px padding, 12px radius</li><li><strong>White</strong>: white bg, <code>#181d26</code> text, 12px radius, 1px border white</li><li><strong>Cookie Consent</strong>: <code>#1b61c9</code> bg, 2px radius (sharp)</li></ul>\n<h3>Cards: <code>1px solid #e0e2e6</code>, 16px–24px radius</h3>\n<h3>Inputs: Standard Haas styling</h3>"}]},{"id":"layout","title":[{"lang":"en-US","message":"Layout"}],"html":[{"lang":"en-US","message":"<ul><li>Spacing: 1–48px (8px base)</li><li>Radius: 2px (small), 12px (buttons), 16px (cards), 24px (sections), 32px (large), 50% (circles)</li></ul>"}]},{"id":"depth","title":[{"lang":"en-US","message":"Depth"}],"html":[{"lang":"en-US","message":"<ul><li>Blue-tinted multi-layer shadow system</li><li>Soft ambient: <code>rgba(15,48,106,0.05) 0px 0px 20px</code></li></ul>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"en-US","message":"Do's and Don'ts"}],"html":[{"lang":"en-US","message":"<h3>Do: Use Airtable Blue for CTAs, Haas with positive tracking, 12px radius buttons</h3>\n<h3>Don't: Skip positive letter-spacing, use heavy shadows</h3>"}]},{"id":"responsive-behavior","title":[{"lang":"en-US","message":"Responsive Behavior"}],"html":[{"lang":"en-US","message":"<p>Breakpoints: 425–1664px (23 breakpoints)</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"en-US","message":"Agent Prompt Guide"}],"html":[{"lang":"en-US","message":"<ul><li>Text: Deep Navy (<code>#181d26</code>)</li><li>CTA: Airtable Blue (<code>#1b61c9</code>)</li><li>Background: White (<code>#ffffff</code>)</li><li>Border: <code>#e0e2e6</code></li></ul>"}]}]}