Headings"}],"kind":"display","family":"Haas Groot Disp","fallbacks":["Haas"],"stack":"\"Haas Groot Disp\", Haas, sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"en-US","message":"Surface"}],"items":[{"name":"--bg","value":"#ffffff"},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"var(--surface)"}]},{"group":[{"lang":"en-US","message":"Text"}],"items":[{"name":"--fg","value":"#181d26"},{"name":"--fg-2","value":"#333333"},{"name":"--muted","value":"rgba(4, 14, 32, 0.69)"},{"name":"--meta","value":"var(--muted)"}]},{"group":[{"lang":"en-US","message":"Border"}],"items":[{"name":"--border","value":"#e0e2e6"},{"name":"--border-soft","value":"#eef0f3"}]},{"group":[{"lang":"en-US","message":"Accent"}],"items":[{"name":"--accent","value":"#1b61c9"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"#254fad"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"en-US","message":"Semantic"}],"items":[{"name":"--success","value":"#006400"},{"name":"--warn","value":"#eab308"},{"name":"--danger","value":"#dc2626"}]},{"group":[{"lang":"en-US","message":"Typography"}],"items":[]},{"group":[{"lang":"en-US","message":"Type scale"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"32px"},{"name":"--text-3xl","value":"40px"},{"name":"--text-4xl","value":"48px"},{"name":"--leading-body","value":"1.35"},{"name":"--leading-tight","value":"1.2"},{"name":"--tracking-display","value":"0"}]},{"group":[{"lang":"en-US","message":"Spacing"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":