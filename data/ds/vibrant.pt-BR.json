e":"36px"},{"name":"--text-3xl","value":"54px"},{"name":"--text-4xl","value":"76px"},{"name":"--leading-body","value":"1.52"},{"name":"--leading-tight","value":"1.06"},{"name":"--tracking-display","value":"-0.025em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"68px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"10px"},{"name":"--radius-md","value":"16px"},{"name":"--radius-lg","value":"24px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 18px 44px rgba(29, 24, 54, 0.14)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 4px rgba(255, 107, 0, 0.26)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"240ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1180px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"--primary-500":"#e66002","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 70%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 50%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 75%, var(--fg))","--danger-fg":"#111111","--bg":"#fff8d7","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#1d1836","--fg-soft":"#4c426c","--muted":"#796f91","--border":"#eadfba","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ff6b00","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"var(--accent-strong)","--solid-fg":"#ffffff","--ok":"#2e9d57","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ffb020","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#e5484d","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"16px","--radius-sm":"10px","--radius-pill":"9999px","--shadow-card":"0 18px 44px rgba(29, 24, 54, 0.14)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Fascinate\", sans-serif","--font-body":"\"Noto Sans\", sans-serif","--font-code":"\"Fira Code\", monospace","--font-mono":"\"Fira Code\", monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Design animado e colorido, com tipografia lúdica e ousada, destaques quentes e energia visual dinâmica.</p>\n<ul><li><strong>Estilo visual:</strong> moderno, limpo, ousado, lúdico</li><li><strong>Postura de cor:</strong> primária, secundária, neutra, sucesso</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#7C61D4</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#EAAE87</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#16A34A</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#D97706</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#DC2626</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#FFFFFF</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#2F281D</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#FFFFFF</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#7C61D4) para dar ênfase aos CTAs.</li><li>Use a Superfície (#FFFFFF) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#2F281D) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> 14/16/18/24/32/40</li><li><strong>Famílias:</strong> primary=Noto Sans, display=Fascinate, mono=Fira Code</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> 2/4/8/12/16/24/32/48</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#7C61D4</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#7C61D4) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}