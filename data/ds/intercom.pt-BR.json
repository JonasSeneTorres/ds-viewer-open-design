{"id":"intercom","name":"Intercom","source":{"name":"Intercom","url":"https://open-design.ai/plugins/design-system-intercom/"},"category":[{"lang":"pt-BR","message":"Produtividade & SaaS"}],"intro":[{"lang":"pt-BR","message":"Mensagens com clientes. Paleta azul amigável, padrões de interface conversacional."}],"roles":{"primary":"Fin Orange","neutral":"Neutral","secondary":"Report Blue"},"palettes":[{"name":"Fin Orange","base":"#ff5600","derived":true,"scale":[{"step":50,"hex":"#fef4f1","exact":false},{"step":100,"hex":"#fde8e1","exact":false},{"step":200,"hex":"#fed1c2","exact":false},{"step":300,"hex":"#feb299","exact":false},{"step":400,"hex":"#fd835a","exact":false},{"step":500,"hex":"#ff5600","exact":true},{"step":600,"hex":"#ca4304","exact":false},{"step":700,"hex":"#c41c1c","exact":true},{"step":800,"hex":"#832600","exact":false},{"step":900,"hex":"#601a00","exact":false},{"step":950,"hex":"#3e0a00","exact":false}]},{"name":"Report Blue","base":"#65b5ff","derived":true,"scale":[{"step":50,"hex":"#f2f8fd","exact":false},{"step":100,"hex":"#dfeffe","exact":false},{"step":200,"hex":"#c1e0ff","exact":false},{"step":300,"hex":"#99cdff","exact":false},{"step":400,"hex":"#65b5ff","exact":true},{"step":500,"hex":"#4994d8","exact":false},{"step":600,"hex":"#387cb8","exact":false},{"step":700,"hex":"#2a6497","exact":false},{"step":800,"hex":"#1e4d77","exact":false},{"step":900,"hex":"#153856","exact":false},{"step":950,"hex":"#0d2133","exact":false}]},{"name":"Report Green","base":"#0bdf50","derived":true,"scale":[{"step":50,"hex":"#e6ffe7","exact":false},{"step":100,"hex":"#c3ffc7","exact":false},{"step":200,"hex":"#72ff87","exact":false},{"step":300,"hex":"#0bdf50","exact":true},{"step":400,"hex":"#10cd4a","exact":false},{"step":500,"hex":"#00ad3b","exact":false},{"step":600,"hex":"#019030","exact":false},{"step":700,"hex":"#057527","exact":false},{"step":800,"hex":"#015b1b","exact":false},{"step":900,"hex":"#004211","exact":false},{"step":950,"hex":"#07270c","exact"