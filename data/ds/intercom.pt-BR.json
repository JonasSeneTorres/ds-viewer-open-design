c","exact":false},{"step":800,"hex":"#4c4a47","exact":false},{"step":900,"hex":"#363533","exact":false},{"step":950,"hex":"#201f1e","exact":false}]},{"name":"Neutral","base":"#626260","derived":true,"scale":[{"step":50,"hex":"#faf9f6","exact":true},{"step":100,"hex":"#ededec","exact":false},{"step":200,"hex":"#dedbd6","exact":true},{"step":300,"hex":"#c7c7c6","exact":false},{"step":400,"hex":"#9c9fa5","exact":true},{"step":500,"hex":"#8f8f8d","exact":false},{"step":600,"hex":"#7b7b78","exact":true},{"step":700,"hex":"#626260","exact":true},{"step":800,"hex":"#4a4a49","exact":false},{"step":900,"hex":"#313130","exact":true},{"step":950,"hex":"#111111","exact":true}]}],"colors":[{"name":"Off Black","hex":"#111111","role":"(#111111): --color-off-black, primary text, button backgrounds"},{"name":"Pure White","hex":"#ffffff","role":"(#ffffff): --wsc-color-content-primary, primary surface"},{"name":"Warm Cream","hex":"#faf9f6","role":"(#faf9f6): Button backgrounds, card surfaces"},{"name":"Fin Orange","hex":"#ff5600","role":"(#ff5600): --color-fin, primary brand accent"},{"name":"Report Orange","hex":"#fe4c02","role":"(#fe4c02): --color-report-orange, data visualization"},{"name":"Report Blue","hex":"#65b5ff","role":"(#65b5ff): --color-report-blue"},{"name":"Report Green","hex":"#0bdf50","role":"(#0bdf50): --color-report-green"},{"name":"Report Red","hex":"#c41c1c","role":"(#c41c1c): --color-report-red"},{"name":"Report Pink","hex":"#ff2067","role":"(#ff2067): --color-report-pink"},{"name":"Report Lime","hex":"#b3e01c","role":"(#b3e01c): --color-report-lime-300"},{"name":"Green","hex":"#00da00","role":"(#00da00): --color-green"},{"name":"Deep Blue","hex":"#0007cb","role":"(#0007cb): Deep blue accent"},{"name":"Black 80","hex":"#313130","role":"(#313130): --wsc-color-black-80, dark neutral"},{"name":"Black 60","hex":"#626260","role":"(#626260): --wsc-color-black-60, mid neutral"},{"name":"Black 50","hex":"#7b7b78","role":"(#7b7b78): --wsc-color-black-50, muted text"},{"name":"Content Tertiary","hex":"#9c9fa5","role":"(#9c9fa5): --wsc-color-content-tertiary"},{"name":"Oat Border","hex":"#dedbd6","role":"(#dedbd6): Warm border color"},{"name":"Warm Sand","hex":"#d3cec6","role":"(#d3cec6): Light warm neutral"}],"fonts":[{"role":[{"lang":"pt-BR","message":"Principal"}],"kind":"primary","family":"Saans","fallbacks":["Saans Fallback","ui-sans-serif","system-ui"],"stack":"\"Saans\", \"Saans Fallback\", ui-sans-serif, system-ui, sans-serif","italic":false,"source":null},{"role":[{"lang":"en-US","message":"Serif"}],"kind":"primary","family":"Serrif","fallbacks":["Serrif Fallback","ui-serif","Georgia"],"stack":"\"Serrif\", \"Serrif Fallback\", ui-serif, Georgia, sans-serif","italic":false,"source":null},{"role":[{"lang":"pt-BR","message":"Monoespaçada"}],"kind":"mono","family":"SaansMono","fallbacks":["SaansMono Fallback","ui-monospace"],"stack":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","italic":false,"source":null},{"role":[{"lang":"pt-BR","message":"Corpo"}],"kind":"body","family":"MediumLL","fallbacks":["LLMedium"],"stack":"\"MediumLL\", LLMedium, sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"pt-BR","message":"Superfície"}],"items":[{"name":"--bg","value":"#faf9f6"},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"#faf9f6"}]},{"group":[{"lang":"pt-BR","message":"Texto"}],"items":[{"name":"--fg","value":"#111111"},{"name":"--fg-2","value":"var(--fg)"},{"name":"--muted","value":"#7b7b78"},{"name":"--meta","value":"#9c9fa5"}]},{"group":[{"lang":"pt-BR","message":"Borda"}],"items":[{"name":"--border","value":"#dedbd6"},{"name":"--border-soft","value":"#ebe9e4"}]},{"group":[{"lang":"pt-BR","message":"Destaque"}],"items":[{"name":"--accent","value":"#ff5600"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), black 8%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#00da00"},{"name":"--warn","value":"#eab308"},{"name":"--danger","value":"#c41c1c"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"32px"},{"name":"--text-3xl","value":"54px"},{"name":"--text-4xl","value":"80px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.0"},{"name":"--tracking-display","value":"-0.03em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"4px"},{"name":"--radius-md","value":"6px"},{"name":"--radius-lg","value":"8px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 2px 8px color-mix(in oklab, var(--fg), transparent 94%)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"12px"}]}],"vars":{"--primary-500":"#ff5600","--primary-500-fg":"#111111","--neutral-400":"#9c9fa5","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 55%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2rem","--fs-h1":"3.375rem","--fs-hero":"5rem","--lh-body":"1.5","--lh-tight":"1.05","--display-tracking":"-0.03em","--section-y":"96px","--section-y-tablet":"64px","--container-max":"1280px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"12px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"8px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--bg":"#faf9f6","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111111","--fg-soft":"#111111","--muted":"color-mix(in oklab, #7b7b78 80%, var(--fg))","--meta":"color-mix(in oklab, #9c9fa5 60%, var(--fg))","--border":"#dedbd6","--border-soft":"#ebe9e4","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#ff5600","--accent-strong":"color-mix(in oklab, var(--accent) 70%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#ff5600","--solid-hover":"#ff6b35","--solid-fg":"#111111","--ok":"#00da00","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#c41c1c","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"6px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 2px 8px color-mix(in oklab, var(--fg), transparent 94%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Saans\", \"Saans Fallback\", ui-sans-serif, system-ui, sans-serif","--font-body":"\"MediumLL\", LLMedium, sans-serif","--font-code":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","--font-mono":"\"SaansMono\", \"SaansMono Fallback\", ui-monospace, monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>O site da Intercom é uma plataforma de atendimento ao cliente calorosa e confiante, que comunica &quot;helpdesk com IA em primeiro lugar&quot; por meio de uma linguagem de design limpa e editorial. A página funciona sobre uma tela off-white quente (<code>#faf9f6</code>) com texto quase preto (<code>#111111</code>), criando uma experiência de leitura íntima, de revista. O característico Fin Orange (<code>#ff5600</code>) — batizado em homenagem ao agente de IA da Intercom — é o único destaque vibrante sobre a paleta neutra quente.</p>\n<p>A tipografia usa a Saans — uma sem serifa geométrica própria, com espaçamento entre letras fortemente negativo (-2.4px em 80px, -0.48px em 24px) e altura de linha constante de 1.00 em todos os tamanhos de título. Isso cria títulos ultracomprimidos, de outdoor, que parecem projetados e precisos. A Serrif é a companheira serifada para os momentos editoriais, e a SaansMono cuida do código e dos rótulos técnicos em caixa-alta. MediumLL e LLMedium aparecem em contextos específicos da interface, formando um rico ecossistema de cinco fontes.</p>\n<p>O que distingue a Intercom é sua geometria notavelmente angulosa — o border-radius de 4px nos botões cria elementos interativos quase retangulares, que parecem industriais e precisos, em contraste com as cores quentes das superfícies. Os estados de hover dos botões usam a expansão <code>scale(1.1)</code>, criando uma interação física de &quot;crescer&quot;. O sistema de bordas usa tons quentes de aveia (<code>#dedbd6</code>) e valores de opacidade baseados em oklab para uma gestão de cor sofisticada.</p>\n<p><strong>Características principais:</strong></p>\n<ul><li>Tela off-white quente (<code>#faf9f6</code>) com bordas em tom de aveia (<code>#dedbd6</code>)</li><li>Fonte Saans com tracking extremamente negativo (-2.4px em 80px) e altura de linha 1.00</li><li>Fin Orange (<code>#ff5600</code>) como único destaque da marca</li><li>Border-radius anguloso de 4px — botões e elementos quase retangulares</li><li>Hover com scale(1.1) e ativo com scale(0.85) — interação física dos botões</li><li>Rótulos em SaansMono caixa-alta com tracking largo (0.6px–1.2px)</li><li>Paleta rica e multicolorida para relatórios (azul, verde, vermelho, rosa, lima, laranja)</li><li>Valores de cor oklab para uma gestão de opacidade sofisticada</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<h3>Primárias</h3>\n<ul><li><strong>Off Black</strong> (<code>#111111</code>): <code>--color-off-black</code>, texto principal, fundos de botões</li><li><strong>Pure White</strong> (<code>#ffffff</code>): <code>--wsc-color-content-primary</code>, superfície principal</li><li><strong>Warm Cream</strong> (<code>#faf9f6</code>): fundos de botões, superfícies de cards</li><li><strong>Fin Orange</strong> (<code>#ff5600</code>): <code>--color-fin</code>, principal destaque da marca</li><li><strong>Report Orange</strong> (<code>#fe4c02</code>): <code>--color-report-orange</code>, visualização de dados</li></ul>\n<h3>Paleta de relatórios</h3>\n<ul><li><strong>Report Blue</strong> (<code>#65b5ff</code>): <code>--color-report-blue</code></li><li><strong>Report Green</strong> (<code>#0bdf50</code>): <code>--color-report-green</code></li><li><strong>Report Red</strong> (<code>#c41c1c</code>): <code>--color-report-red</code></li><li><strong>Report Pink</strong> (<code>#ff2067</code>): <code>--color-report-pink</code></li><li><strong>Report Lime</strong> (<code>#b3e01c</code>): <code>--color-report-lime-300</code></li><li><strong>Green</strong> (<code>#00da00</code>): <code>--color-green</code></li><li><strong>Deep Blue</strong> (<code>#0007cb</code>): destaque em azul profundo</li></ul>\n<h3>Escala neutra (quente)</h3>\n<ul><li><strong>Black 80</strong> (<code>#313130</code>): <code>--wsc-color-black-80</code>, neutra escura</li><li><strong>Black 60</strong> (<code>#626260</code>): <code>--wsc-color-black-60</code>, neutra média</li><li><strong>Black 50</strong> (<code>#7b7b78</code>): <code>--wsc-color-black-50</code>, texto esmaecido</li><li><strong>Content Tertiary</strong> (<code>#9c9fa5</code>): <code>--wsc-color-content-tertiary</code></li><li><strong>Oat Border</strong> (<code>#dedbd6</code>): cor de borda quente</li><li><strong>Warm Sand</strong> (<code>#d3cec6</code>): neutra quente clara</li></ul>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<h3>Famílias tipográficas</h3>\n<ul><li><strong>Principal</strong>: <code>Saans</code>, fallbacks: <code>Saans Fallback, ui-sans-serif, system-ui</code></li><li><strong>Serifada</strong>: <code>Serrif</code>, fallbacks: <code>Serrif Fallback, ui-serif, Georgia</code></li><li><strong>Monoespaçada</strong>: <code>SaansMono</code>, fallbacks: <code>SaansMono Fallback, ui-monospace</code></li><li><strong>Interface</strong>: <code>MediumLL</code> / <code>LLMedium</code>, fallbacks: <code>system-ui, -apple-system</code></li></ul>\n<h3>Hierarquia</h3>\n<table><thead><tr><th>Papel</th><th>Fonte</th><th>Tamanho</th><th>Peso</th><th>Altura da linha</th><th>Espaçamento entre letras</th></tr></thead><tbody><tr><td>Display Hero</td><td>Saans</td><td>80px</td><td>400</td><td>1.00 (justa)</td><td>-2.4px</td></tr><tr><td>Título de seção</td><td>Saans</td><td>54px</td><td>400</td><td>1.00</td><td>-1.6px</td></tr><tr><td>Subtítulo</td><td>Saans</td><td>40px</td><td>400</td><td>1.00</td><td>-1.2px</td></tr><tr><td>Título de card</td><td>Saans</td><td>32px</td><td>400</td><td>1.00</td><td>-0.96px</td></tr><tr><td>Título de recurso</td><td>Saans</td><td>24px</td><td>400</td><td>1.00</td><td>-0.48px</td></tr><tr><td>Corpo com ênfase</td><td>Saans</td><td>20px</td><td>400</td><td>0.95</td><td>-0.2px</td></tr><tr><td>Navegação / interface</td><td>Saans</td><td>18px</td><td>400</td><td>1.00</td><td>normal</td></tr><tr><td>Corpo</td><td>Saans</td><td>16px</td><td>400</td><td>1.50</td><td>normal</td></tr><tr><td>Corpo leve</td><td>Saans</td><td>14px</td><td>300</td><td>1.40</td><td>normal</td></tr><tr><td>Botão</td><td>Saans</td><td>16px / 14px</td><td>400</td><td>1.50 / 1.43</td><td>normal</td></tr><tr><td>Botão negrito</td><td>LLMedium</td><td>16px</td><td>700</td><td>1.20</td><td>0.16px</td></tr><tr><td>Corpo serifado</td><td>Serrif</td><td>16px</td><td>300</td><td>1.40</td><td>-0.16px</td></tr><tr><td>Rótulo mono</td><td>SaansMono</td><td>12px</td><td>400–500</td><td>1.00–1.30</td><td>0.6px–1.2px caixa-alta</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<h3>Botões</h3>\n<p><strong>Primário escuro</strong></p>\n<ul><li>Fundo: <code>#111111</code></li><li>Texto: <code>#ffffff</code></li><li>Padding: 0px 14px</li><li>Raio: 4px</li><li>Hover: fundo branco, texto escuro, scale(1.1)</li><li>Ativo: fundo verde (<code>#2c6415</code>), scale(0.85)</li></ul>\n<p><strong>Com contorno</strong></p>\n<ul><li>Fundo: transparente</li><li>Texto: <code>#111111</code></li><li>Borda: <code>1px solid #111111</code></li><li>Raio: 4px</li><li>Mesmo comportamento de escala no hover/ativo</li></ul>\n<p><strong>Botão de card quente</strong></p>\n<ul><li>Fundo: <code>#faf9f6</code></li><li>Texto: <code>#111111</code></li><li>Padding: 16px</li><li>Borda: <code>1px solid oklab(... / 0.1)</code></li></ul>\n<h3>Cards e contêineres</h3>\n<ul><li>Fundo: <code>#faf9f6</code> (creme quente)</li><li>Borda: <code>1px solid #dedbd6</code> (aveia quente)</li><li>Raio: 8px</li><li>Sem sombras visíveis</li></ul>\n<h3>Navegação</h3>\n<ul><li>Saans 16px nos links</li><li>Texto quase preto sobre branco</li><li>Botões pequenos com raio de 4px–6px</li><li>Destaque laranja Fin para os recursos de IA</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"pt-BR","message":"Princípios de layout"}],"html":[{"lang":"pt-BR","message":"<h3>Espaçamento: 8px, 10px, 12px, 14px, 16px, 20px, 24px, 32px, 40px, 48px, 60px, 64px, 80px, 96px</h3>\n<h3>Raio de borda: 4px (botões), 6px (itens de navegação), 8px (cards, contêineres)</h3>"}]},{"id":"depth-elevation","title":[{"lang":"pt-BR","message":"Profundidade e elevação"}],"html":[{"lang":"pt-BR","message":"<p>Sombras mínimas. A profundidade vem das cores quentes das bordas e dos tons das superfícies.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<h3>Faça</h3>\n<ul><li>Use a Saans com altura de linha 1.00 e tracking negativo em todos os títulos</li><li>Aplique raio de 4px nos botões — a geometria angulosa é a identidade</li><li>Use o Fin Orange (#ff5600) apenas como destaque de IA/marca</li><li>Aplique hover com scale(1.1) nos botões</li><li>Use neutras quentes (#faf9f6, #dedbd6)</li></ul>\n<h3>Não faça</h3>\n<ul><li>Não arredonde botões além de 4px</li><li>Não use o Fin Orange de forma decorativa</li><li>Não use bordas cinza frias — sempre tons quentes de aveia</li><li>Não abra mão do tracking negativo nos títulos</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<p>Breakpoints: 425px, 530px, 600px, 640px, 768px, 896px</p>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<h3>Referência rápida de cores</h3>\n<ul><li>Texto: Off Black (<code>#111111</code>)</li><li>Fundo: Warm Cream (<code>#faf9f6</code>)</li><li>Destaque: Fin Orange (<code>#ff5600</code>)</li><li>Borda: Oat (<code>#dedbd6</code>)</li><li>Esmaecido: <code>#7b7b78</code></li></ul>\n<h3>Exemplos de prompts de componentes</h3>\n<ul><li>&quot;Crie um hero: fundo creme quente (#faf9f6). Saans 80px peso 400, line-height 1.00, letter-spacing -2.4px, #111111. Botão escuro (#111111, raio de 4px). Hover: scale(1.1), fundo branco.&quot;</li></ul>"}]}]}