"},{"name":"--leading-tight","value":"1.2"},{"name":"--tracking-display","value":"-0.01em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"80px"},{"name":"--section-y-tablet","value":"48px"},{"name":"--section-y-phone","value":"32px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"8px"},{"name":"--radius-md","value":"12px"},{"name":"--radius-lg","value":"16px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 2px 8px color-mix(in oklab, var(--fg), transparent 92%)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1200px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"12px"}]}],"vars":{"color-scheme":"light","--primary-500":"#4c89fe","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 70%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 55%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2rem","--fs-h1":"3rem","--fs-hero":"4rem","--lh-body":"1.5","--lh-tight":"1.2","--display-tracking":"-0.01em","--section-y":"80px","--section-y-tablet":"48px","--container-max":"1200px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"12px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"16px","--focus-ring":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)","--bg":"#fafafa","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111111","--fg-soft":"#111111","--muted":"color-mix(in oklab, #6b6b6b 95%, var(--fg))","--meta":"color-mix(in oklab, #6b6b6b 95%, var(--fg))","--border":"#e5e5e5","--border-soft":"#e5e5e5","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#2f6feb","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#2f6feb","--solid-hover":"#2760cc","--solid-fg":"#ffffff","--ok":"#17a34a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#eab308","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"12px","--radius-sm":"8px","--radius-pill":"9999px","--shadow-card":"0 2px 8px color-mix(in oklab, var(--fg), transparent 92%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Inter\", -apple-system, system-ui, sans-serif","--font-body":"\"Inter\", -apple-system, system-ui, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--heading-weight":"600","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Calmo, funcional, discretamente confiante. Sem ornamentos. Conteúdo em primeiro lugar, moldura em segundo.</p>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Fundo:</strong> <code>#FAFAFA</code></li><li><strong>Primeiro plano:</strong> <code>#111111</code></li><li><strong>Destaque:</strong> <code>#2F6FEB</code> (cobalto) — CTAs principais, links, um elemento de destaque por tela</li><li><strong>Esmaecido:</strong> <code>#6B6B6B</code> — texto secundário, legendas</li><li><strong>Borda:</strong> <code>#E5E5E5</code></li><li><strong>Superfície:</strong> <code>#FFFFFF</code> — cards, modais</li><li><strong>Sucesso:</strong> <code>#17A34A</code>, <strong>Alerta:</strong> <code>#EAB308</code>, <strong>Perigo:</strong> <code>#DC2626</code></li></ul>\n<p>Nunca preto puro; nunca branco puro nos fundos.</p>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Display / títulos:</strong> <code>'Inter', -apple-system, system-ui, sans-serif</code>, peso 600</li><li><strong>Corpo:</strong> <code>'Inter', -apple-system, system-ui, sans-serif</code>, peso 400</li><li><strong>Mono:</strong> <code>ui-monospace, 'JetBrains Mono', monospace</code></li><li>Escala (px): 12 · 14 · 16 · 20 · 24 · 32 · 48 · 64</li><li>Altura da linha: 1.5 no corpo, 1.2 nos títulos</li><li>Espaçamento entre letras: -0.01em nos tamanhos de display ≥32px</li></ul>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Botões:</strong> raio de 8px, padding-block de 10px, padding-inline de 16px. Primário = preenchimento cobalto, rótulo branco. Secundário = borda de 1px, preenchimento transparente.</li><li><strong>Cards:</strong> brancos, borda de 1px, raio de 12px, padding interno de 20px, sem sombra por padrão.</li><li><strong>Campos:</strong> borda de 1px, raio de 8px, padding vertical de 10px, borda cobalto no foco.</li><li><strong>Links:</strong> cobalto, sem sublinhado, sublinhado no hover.</li></ul>"}]},{"id":"layout-principles","title":[{"lang":"pt-BR","message":"Princípios de layout"}],"html":[{"lang":"pt-BR","message":"<ul><li>Grid de 12 colunas, largura máxima de 1200px, gutters de 24px.</li><li>Hero: 40–60vh. Conteúdo puxado para o topo, nunca centralizado na vertical.</li><li>Seções: espaçamento de 80px em cima e embaixo no desktop, 48px no tablet, 32px no celular.</li><li>Use o espaço em branco como separador principal. Divisores só entre seções de primeiro nível sem relação.</li></ul>"}]},{"id":"depth-elevation","title":[{"lang":"pt-BR","message":"Profundidade e elevação"}],"html":[{"lang":"pt-BR","message":"<p>Apenas dois níveis:</p>\n<ul><li><strong>Plano (0):</strong> padrão.</li><li><strong>Elevado (1):</strong> dropdowns, modais, botões flutuantes. Deslocamento y de 2px, desfoque de 8px, cor de primeiro plano com 8% de opacidade.</li></ul>\n<p>Sem neumorfismo, sem glassmorphism.</p>"}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<ul><li>✅ Deixe o espaço em branco fazer o trabalho.</li><li>✅ Um elemento de destaque por tela.</li><li>✅ Títulos com só a primeira letra maiúscula por padrão; iniciais maiúsculas só em nomes de marcas.</li><li>❌ Sem gradientes (exceto destaque → destaque a 80% num hero, com parcimônia).</li><li>❌ Sem sombras projetadas nos campos.</li><li>❌ No máximo três tamanhos de fonte por tela.</li></ul>"}]},{"id":"responsive-behavior","title":[{"lang":"pt-BR","message":"Comportamento responsivo"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Desktop ≥ 1024px:</strong> grid de 12 colunas.</li><li><strong>Tablet 640–1023px:</strong> grid de 8 colunas, gutters de 16px.</li><li><strong>Celular &lt; 640px:</strong> grid de 4 colunas, gutters de 12px; o hero cai para 40vh.</li></ul>"}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Na dúvida, subtraia. Menos caixas, menos moldura, mais espaço.</li><li>Use a cor de destaque com parcimônia — no máximo um destaque no hero e um no CTA por tela.</li><li>Não invente valores hex fora desta paleta. Se o pedido precisar de um, deixe um comentário de aviso no artefato e use o token existente mais próximo.</li></ul>"}]}]}