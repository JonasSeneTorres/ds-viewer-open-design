order Hover","hex":"#898989","role":"(#898989): Hover border"}],"fonts":[{"role":[{"lang":"pt-BR","message":"Principal"}],"kind":"primary","family":"WF Visual Sans Variable","fallbacks":["Arial"],"stack":"\"WF Visual Sans Variable\", Arial, sans-serif","italic":false,"source":null}],"tokens":[{"group":[{"lang":"pt-BR","message":"Superfície"}],"items":[{"name":"--bg","value":"#ffffff"},{"name":"--surface","value":"#ffffff"},{"name":"--surface-warm","value":"var(--surface)"}]},{"group":[{"lang":"pt-BR","message":"Texto"}],"items":[{"name":"--fg","value":"#080808"},{"name":"--fg-2","value":"#363636"},{"name":"--muted","value":"#5a5a5a"},{"name":"--meta","value":"#ababab"}]},{"group":[{"lang":"pt-BR","message":"Borda"}],"items":[{"name":"--border","value":"#d8d8d8"},{"name":"--border-soft","value":"#ebebeb"}]},{"group":[{"lang":"pt-BR","message":"Destaque"}],"items":[{"name":"--accent","value":"#146ef5"},{"name":"--accent-on","value":"#ffffff"},{"name":"--accent-hover","value":"#0055d4"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), black 14%)"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#00d722"},{"name":"--warn","value":"#ffae13"},{"name":"--danger","value":"#ee1d36"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"32px"},{"name":"--text-3xl","value":"56px"},{"name":"--text-4xl","value":"80px"},{"name":"--leading-body","value":"1.6"},{"name":"--leading-tight","value":"1.04"},{"name":"--tracking-display","value":"-0.01em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"4px"},{"name":"--radius-md","value":"4px"},{"name":"--radius-lg","value":"8px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0px 84px 24px rgba(0, 0, 0, 0), 0px 54px 22px rgba(0, 0, 0, 0.01), 0px 30px 18px rgba(0, 0, 0, 0.04), 0px 13px 13px rgba(0, 0, 0, 0.08), 0px 3px 7px rgba(0, 0, 0, 0.09)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 3px color-mix(in oklab, var(--accent), transparent 70%)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1200px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"12px"}]}],"vars":{"--primary-500":"#3b89ff","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 60%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 60%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 85%, var(--fg))","--danger-fg":"#111111","--bg":"#ffffff","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#080808","--fg-soft":"#363636","--muted":"#5a5a5a","--border":"#d8d8d8","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#146ef5","--accent-strong":"color-mix(in oklab, var(--accent), var(--fg) 16%)","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"var(--accent-strong)","--solid-fg":"#ffffff","--ok":"#00d722","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#ffae13","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#ee1d36","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"4px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0px 84px 24px rgba(0, 0, 0, 0), 0px 54px 22px rgba(0, 0, 0, 0.01), 0px 30px 18px rgba(0, 0, 0, 0.04), 0px 13px 13px rgba(0, 0, 0, 0.08), 0px 3px 7px rgba(0, 0, 0, 0.09)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"WF Visual Sans Variable\", Arial, sans-serif","--font-body":"\"WF Visual Sans Variable\", Arial, sans-serif","--font-code":"ui-monospace, SFMono-Regular, Menlo, monospace","--font-mono":"ui-monospace, SFMono-Regular, Menlo, monospace","--display-tracking":"-0.02em","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>O site da Webflow é uma plataforma visualmente rica e centrada na ferramenta, que comunica &quot;design sem código&quot; por meio de superfícies brancas limpas, do característico Webflow Blue (<code>#146ef5</code>) e de uma rica paleta secundária (roxo, rosa, verde, laranja, amarelo, vermelho). A fonte própria WF Visual Sans Variable cria um sistema tipográfico confiante e preciso, com peso 600 no display e 500 no corpo.</p>\n<p><strong>Características principais:</strong></p>\n<ul><li>Tela branca com texto quase preto (<code>#080808</code>)</li><li>Webflow Blue (<code>#146ef5</code>) como cor principal da marca + cor interativa</li><li>WF Visual Sans Variable — fonte variável própria com peso 500–600</li><li>Paleta secundária rica: roxo <code>#7a3dff</code>, rosa <code>#ed52cb</code>, verde <code>#00d722</code>, laranja <code>#ff6b00</code>, amarelo <code>#ffae13</code>, vermelho <code>#ee1d36</code></li><li>Border-radius conservador de 4px–8px — anguloso, não arredondado</li><li>Pilhas de sombras em várias camadas (sombras em cascata de 5 camadas)</li><li>Rótulos em caixa-alta: 10px–15px, peso 500–600, espaçamento entre letras largo (0.6px–1.5px)</li><li>Animação de hover translate(6px) nos botões</li></ul>"}]},{"id":"color-palette-roles","title":[{"lang":"pt-BR","message":"Paleta de cores e papéis"}],"html":[{"lang":"pt-BR","message":"<h3>Primárias</h3>\n<ul><li><strong>Near Black</strong> (<code>#080808</code>): texto principal</li><li><strong>Webflow Blue</strong> (<code>#146ef5</code>): <code>--_color---primary--webflow-blue</code>, CTA principal e links</li><li><strong>Blue 400</strong> (<code>#3b89ff</code>): <code>--_color---primary--blue-400</code>, azul interativo mais claro</li><li><strong>Blue 300</strong> (<code>#006acc</code>): <code>--_color---blue-300</code>, variante de azul mais escura</li><li><strong>Button Hover Blue</strong> (<code>#0055d4</code>): <code>--mkto-embed-color-button-hover</code></li></ul>\n<h3>Destaques secundários</h3>\n<ul><li><strong>Purple</strong> (<code>#7a3dff</code>): <code>--_color---secondary--purple</code></li><li><strong>Pink</strong> (<code>#ed52cb</code>): <code>--_color---secondary--pink</code></li><li><strong>Green</strong> (<code>#00d722</code>): <code>--_color---secondary--green</code></li><li><strong>Orange</strong> (<code>#ff6b00</code>): <code>--_color---secondary--orange</code></li><li><strong>Yellow</strong> (<code>#ffae13</code>): <code>--_color---secondary--yellow</code></li><li><strong>Red</strong> (<code>#ee1d36</code>): <code>--_color---secondary--red</code></li></ul>\n<h3>Neutras</h3>\n<ul><li><strong>Gray 800</strong> (<code>#222222</code>): texto secundário escuro</li><li><strong>Gray 700</strong> (<code>#363636</code>): texto intermediário</li><li><strong>Gray 300</strong> (<code>#ababab</code>): texto esmaecido, placeholder</li><li><strong>Mid Gray</strong> (<code>#5a5a5a</code>): texto de links</li><li><strong>Border Gray</strong> (<code>#d8d8d8</code>): bordas, divisores</li><li><strong>Border Hover</strong> (<code>#898989</code>): borda no hover</li></ul>\n<h3>Sombras</h3>\n<ul><li><strong>Cascata de 5 camadas</strong>: <code>rgba(0,0,0,0) 0px 84px 24px, rgba(0,0,0,0.01) 0px 54px 22px, rgba(0,0,0,0.04) 0px 30px 18px, rgba(0,0,0,0.08) 0px 13px 13px, rgba(0,0,0,0.09) 0px 3px 7px</code></li></ul>"}]},{"id":"typography-rules","title":[{"lang":"pt-BR","message":"Regras de tipografia"}],"html":[{"lang":"pt-BR","message":"<h3>Fonte: <code>WF Visual Sans Variable</code>, fallback: <code>Arial</code></h3>\n<table><thead><tr><th>Papel</th><th>Tamanho</th><th>Peso</th><th>Altura da linha</th><th>Espaçamento entre letras</th><th>Observações</th></tr></thead><tbody><tr><td>Display Hero</td><td>80px</td><td>600</td><td>1.04</td><td>-0.8px</td><td></td></tr><tr><td>Título de seção</td><td>56px</td><td>600</td><td>1.04</td><td>normal</td><td></td></tr><tr><td>Subtítulo</td><td>32px</td><td>500</td><td>1.30</td><td>normal</td><td></td></tr><tr><td>Título de recurso</td><td>24px</td><td>500–600</td><td>1.30</td><td>normal</td><td></td></tr><tr><td>Corpo</td><td>20px</td><td>400–500</td><td>1.40–1.50</td><td>normal</td><td></td></tr><tr><td>Corpo padrão</td><td>16px</td><td>400–500</td><td>1.60</td><td>-0.16px</td><td></td></tr><tr><td>Botão</td><td>16px</td><td>500</td><td>1.60</td><td>-0.16px</td><td></td></tr><tr><td>Rótulo em caixa-alta</td><td>15px</td><td>500</td><td>1.30</td><td>1.5px</td><td>caixa-alta</td></tr><tr><td>Legenda</td><td>14px</td><td>400–500</td><td>1.40–1.60</td><td>normal</td><td></td></tr><tr><td>Badge em caixa-alta</td><td>12.8px</td><td>550</td><td>1.20</td><td>normal</td><td>caixa-alta</td></tr><tr><td>Micro em caixa-alta</td><td>10px</td><td>500–600</td><td>1.30</td><td>1px</td><td>caixa-alta</td></tr><tr><td>Código: Inconsolata (fonte monoespaçada complementar)</td></tr></tbody></table>"}]},{"id":"component-stylings","title":[{"lang":"pt-BR","message":"Estilo dos componentes"}],"html":[{"lang":"pt-BR","message":"<h3>Botões</h3>\n<ul><li>Transparente: texto <code>#080808</code>, translate(6px) no hover</li><li>Círculo branco: raio de 50%, fundo branco</li><li>Badge azul: fundo <code>#146ef5</code>, raio de 4px, peso 550</li></ul>\n<h3>Cards: <code>1px solid #d8d8d8</code>, raio de 4px–8px</h3>\n<h3>Badges: fundo tingido de azul a 10% de opacidade, raio de 4px</h3>"}]},{"id":"layout","title":[{"lang":"pt-BR","message":"Layout"}],"html":[{"lang":"pt-BR","message":"<ul><li>Espaçamento: escala fracionária (1px, 2.4px, 3.2px, 4px, 5.6px, 6px, 7.2px, 8px, 9.6px, 12px, 16px, 24px)</li><li>Raio: 2px, 4px, 8px, 50% — conservador, anguloso</li><li>Breakpoints: 479px, 768px, 992px</li></ul>"}]},{"id":"depth-5-layer-cascading-shadow-system","title":[{"lang":"pt-BR","message":"Profundidade: sistema de sombras em cascata de 5 camadas"}],"html":[{"lang":"en-US","message":""}]},{"id":"do-s-and-don-ts","title":[{"lang":"pt-BR","message":"O que fazer e o que evitar"}],"html":[{"lang":"pt-BR","message":"<ul><li>Faça: use WF Visual Sans Variable em 500–600. Azul (#146ef5) nos CTAs. Raio de 4px. Hover com translate(6px).</li><li>Não faça: arredondar além de 8px em elementos funcionais. Usar cores secundárias nos CTAs principais.</li></ul>"}]},{"id":"responsive-479px-768px-992px","title":[{"lang":"pt-BR","message":"Responsivo: 479px, 768px, 992px"}],"html":[{"lang":"en-US","message":""}]},{"id":"agent-prompt-guide","title":[{"lang":"pt-BR","message":"Guia de prompts para agentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Texto: Near Black (<code>#080808</code>)</li><li>CTA: Webflow Blue (<code>#146ef5</code>)</li><li>Fundo: White (<code>#ffffff</code>)</li><li>Borda: <code>#d8d8d8</code></li><li>Secundárias: Purple <code>#7a3dff</code>, Pink <code>#ed52cb</code>, Green <code>#00d722</code></li></ul>"}]}]}