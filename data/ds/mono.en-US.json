en-US","message":"Motion"}],"items":[{"name":"--motion-fast","value":"100ms"},{"name":"--motion-base","value":"180ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"light","--primary-500":"#00a63d","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 85%, var(--fg))","--ok-fg":"#ffffff","--warn-ink":"color-mix(in oklab, var(--warn) 75%, var(--fg))","--warn-fg":"#111111","--danger-ink":"var(--danger)","--danger-fg":"#ffffff","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.25rem","--fs-h2":"1.75rem","--fs-h1":"2.5rem","--fs-hero":"3.5rem","--lh-body":"1.45","--lh-tight":"1.06","--display-tracking":"-0.025em","--section-y":"80px","--section-y-tablet":"60px","--container-max":"1280px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"100ms","--motion-base":"180ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 3px rgba(17, 17, 17, 0.18)","--secondary":"#1295da","--secondary-fg":"#111111","--secondary-hover":"#43a2df","--bg":"#ffffff","--surface":"#f7f7f7","--surface-2":"#eeeeee","--fg":"#111111","--fg-soft":"#3a3a3a","--muted":"color-mix(in oklab, #707070 80%, var(--fg))","--meta":"#111111","--border":"#d9d9d9","--border-soft":"#eeeeee","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#111111","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#111111","--solid-hover":"#0d0d0d","--solid-fg":"#ffffff","--ok":"#168a46","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#b7791f","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#c53030","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"0 16px 40px rgba(0, 0, 0, 0.10)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Space Mono\", sans-serif","--font-body":"\"Space Mono\", sans-serif","--font-code":"\"JetBrains Mono\", monospace","--font-mono":"\"JetBrains Mono\", monospace","--heading-weight":"400","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Monospace-driven, matrix-inspired design with high-contrast elements, compact density, and a hacker-chic aesthetic.</p>\n<ul><li><strong>Visual style:</strong> minimal, clean, high-contrast, playful, matrix</li><li><strong>Color stance:</strong> primary, secondary, success, warning, danger, info</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#37F712</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#00A6F4</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#00A63D</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#FE9900</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#FF2157</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#E7E5E4</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#78716B</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#E7E5E4</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#37F712) for CTA emphasis.</li><li>Use Surface (#E7E5E4) for large backgrounds and cards.</li><li>Keep body copy on Text (#78716B) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> desktop-first expressive scale</li><li><strong>Families:</strong> primary=Space Mono, display=Space Mono, mono=JetBrains Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> compact density mode</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#37F712</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#37F712) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}