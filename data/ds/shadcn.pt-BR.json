lue":"#ffffff"},{"name":"--accent-hover","value":"color-mix(in oklab, var(--accent), white 10%)"},{"name":"--accent-active","value":"color-mix(in oklab, var(--accent), white 18%)"}]},{"group":[{"lang":"pt-BR","message":"Semântico"}],"items":[{"name":"--success","value":"#16a34a"},{"name":"--warn","value":"#d97706"},{"name":"--danger","value":"#dc2626"}]},{"group":[{"lang":"pt-BR","message":"Tipografia"}],"items":[]},{"group":[{"lang":"pt-BR","message":"Escala tipográfica"}],"items":[{"name":"--text-xs","value":"12px"},{"name":"--text-sm","value":"14px"},{"name":"--text-base","value":"16px"},{"name":"--text-lg","value":"20px"},{"name":"--text-xl","value":"24px"},{"name":"--text-2xl","value":"32px"},{"name":"--text-3xl","value":"40px"},{"name":"--text-4xl","value":"48px"},{"name":"--leading-body","value":"1.5"},{"name":"--leading-tight","value":"1.2"},{"name":"--tracking-display","value":"-0.02em"}]},{"group":[{"lang":"pt-BR","message":"Espaçamento"}],"items":[{"name":"--space-1","value":"4px"},{"name":"--space-2","value":"8px"},{"name":"--space-3","value":"12px"},{"name":"--space-4","value":"16px"},{"name":"--space-5","value":"20px"},{"name":"--space-6","value":"24px"},{"name":"--space-8","value":"32px"},{"name":"--space-12","value":"48px"},{"name":"--section-y-desktop","value":"96px"},{"name":"--section-y-tablet","value":"64px"},{"name":"--section-y-phone","value":"48px"}]},{"group":[{"lang":"pt-BR","message":"Raio"}],"items":[{"name":"--radius-sm","value":"6px"},{"name":"--radius-md","value":"8px"},{"name":"--radius-lg","value":"12px"},{"name":"--radius-pill","value":"9999px"}]},{"group":[{"lang":"pt-BR","message":"Elevação"}],"items":[{"name":"--elev-flat","value":"none"},{"name":"--elev-ring","value":"0 0 0 1px var(--border)"},{"name":"--elev-raised","value":"0 1px 2px 0 color-mix(in oklab, var(--fg), transparent 92%), 0 1px 3px 0 color-mix(in oklab, var(--fg), transparent 88%)"}]},{"group":[{"lang":"pt-BR","message":"Foco"}],"items":[{"name":"--focus-ring","value":"0 0 0 2px var(--bg), 0 0 0 4px var(--accent)"}]},{"group":[{"lang":"pt-BR","message":"Movimento"}],"items":[{"name":"--motion-fast","value":"150ms"},{"name":"--motion-base","value":"200ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"pt-BR","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"24px"},{"name":"--container-gutter-tablet","value":"16px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"light","--primary-500":"#16a34a","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 70%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 70%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 90%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.75rem","--fs-sm":"0.875rem","--fs-base":"1rem","--fs-h3":"1.5rem","--fs-h2":"2rem","--fs-h1":"2.5rem","--fs-hero":"3rem","--lh-body":"1.5","--lh-tight":"1.2","--display-tracking":"-0.02em","--section-y":"96px","--section-y-tablet":"64px","--container-max":"1280px","--gutter":"24px","--gutter-tablet":"16px","--gutter-phone":"16px","--motion-fast":"150ms","--motion-base":"200ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 2px var(--bg), 0 0 0 4px var(--accent)","--bg":"#ffffff","--surface":"#ffffff","--surface-2":"color-mix(in oklab, var(--bg), var(--fg) 4%)","--fg":"#111827","--fg-soft":"#111827","--muted":"color-mix(in oklab, #64748b 75%, var(--fg))","--meta":"color-mix(in oklab, #64748b 75%, var(--fg))","--border":"#e5e7eb","--border-soft":"#e5e7eb","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#000000","--accent-strong":"color-mix(in oklab, var(--accent) 85%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#000000","--solid-hover":"#000000","--solid-fg":"#ffffff","--ok":"#16a34a","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#d97706","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#dc2626","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"6px","--radius-pill":"9999px","--shadow-card":"0 1px 2px 0 color-mix(in oklab, var(--fg), transparent 92%), 0 1px 3px 0 color-mix(in oklab, var(--fg), transparent 88%)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Geist\", sans-serif","--font-body":"\"Geist\", sans-serif","--font-code":"\"Fira Code\", monospace","--font-mono":"\"Fira Code\", monospace","--heading-weight":"600","--kicker-transform":"uppercase","--kicker-spacing":"0.08em","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"pt-BR","message":"Tema visual e atmosfera"}],"html":[{"lang":"pt-BR","message":"<p>Design inspirado no shadcn/ui, com componentes minimalistas e limpos, paleta monocromática e padrões utility-first.</p>\n<ul><li><strong>Estilo visual:</strong> minimalista, limpo</li><li><strong>Postura de cor:</strong> primária, secundária</li><li><strong>Intenção de design:</strong> Manter os resultados reconhecíveis como parte desta família de estilo, preservando a usabilidade e a legibilidade.</li></ul>"}]},{"id":"color","title":[{"lang":"pt-BR","message":"Cor"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Primária:</strong> <code>#000000</code> — Token das bases do estilo.</li><li><strong>Secundária:</strong> <code>#111111</code> — Token das bases do estilo.</li><li><strong>Sucesso:</strong> <code>#16A34A</code> — Token das bases do estilo.</li><li><strong>Alerta:</strong> <code>#D97706</code> — Token das bases do estilo.</li><li><strong>Perigo:</strong> <code>#DC2626</code> — Token das bases do estilo.</li><li><strong>Superfície:</strong> <code>#FFFFFF</code> — Token das bases do estilo.</li><li><strong>Texto:</strong> <code>#111827</code> — Token das bases do estilo.</li><li><strong>Neutra:</strong> <code>#FFFFFF</code> — Derivado do token de superfície para compatibilidade com o formato oficial.</li></ul>\n<ul><li>Prefira a Primária (#000000) para dar ênfase aos CTAs.</li><li>Use a Superfície (#FFFFFF) em fundos grandes e cards.</li><li>Mantenha o texto de corpo na cor Texto (#111827) para garantir a legibilidade.</li></ul>"}]},{"id":"typography","title":[{"lang":"pt-BR","message":"Tipografia"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala:</strong> 12/14/16/20/24/32</li><li><strong>Famílias:</strong> primary=Geist, display=Geist, mono=Fira Code</li><li><strong>Pesos:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Os títulos devem carregar a personalidade do estilo; o texto de corpo deve otimizar a leitura rápida e o contraste.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"pt-BR","message":"Espaçamento e grid"}],"html":[{"lang":"pt-BR","message":"<ul><li><strong>Escala de espaçamento:</strong> 4/8/12/16/24/32</li><li>Mantenha o ritmo vertical consistente entre seções e componentes.</li><li>Alinhe colunas e módulos a um grid previsível; evite deslocamentos improvisados.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"pt-BR","message":"Layout e composição"}],"html":[{"lang":"pt-BR","message":"<ul><li>Prefira blocos de conteúdo claros, com padding interno consistente.</li><li>Mantenha a hierarquia óbvia: título → texto de apoio → ação principal.</li><li>Use o espaço em branco para separar assuntos antes de adicionar bordas ou sombras.</li></ul>"}]},{"id":"components","title":[{"lang":"pt-BR","message":"Componentes"}],"html":[{"lang":"pt-BR","message":"<ul><li>Botões: a ação principal usa <code>#000000</code>; as ações secundárias ficam neutras.</li><li>Campos: estados de foco visível marcantes, rótulos claros e mensagens de erro previsíveis.</li><li>Cards/seções: use raios, espaçamentos e estratégia de elevação consistentes em toda a página.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"pt-BR","message":"Movimento e interação"}],"html":[{"lang":"pt-BR","message":"<ul><li>Use transições sutis que destaquem a Primária (#000000) como sinal de interação.</li><li>Use por padrão transições curtas e intencionais (150–250ms) com easing estável.</li><li>Garanta que os estados de hover, foco visível, ativo, desabilitado e carregando sejam explícitos.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"pt-BR","message":"Voz e marca"}],"html":[{"lang":"pt-BR","message":"<ul><li>O tom deve refletir o estilo visual: conciso, confiante e específico do produto.</li><li>Mantenha os microtextos orientados à ação e evite linguagem genérica de enchimento.</li><li>Preserve a identidade do estilo nos títulos, mantendo os rótulos da interface literais e claros.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"pt-BR","message":"Antipadrões"}],"html":[{"lang":"pt-BR","message":"<ul><li>Não introduza cores fora da paleta quando um token existente resolve o problema.</li><li>Não achate a hierarquia usando o mesmo tamanho/peso de fonte para todo o texto.</li><li>Não adicione efeitos decorativos que reduzam a legibilidade ou a acessibilidade.</li><li>Não misture metáforas visuais sem relação na mesma interface.</li></ul>"}]}]}