s"},{"name":"--motion-base","value":"180ms"},{"name":"--ease-standard","value":"cubic-bezier(0.2, 0, 0, 1)"}]},{"group":[{"lang":"en-US","message":"Layout"}],"items":[{"name":"--container-max","value":"1280px"},{"name":"--container-gutter-desktop","value":"36px"},{"name":"--container-gutter-tablet","value":"24px"},{"name":"--container-gutter-phone","value":"16px"}]}],"vars":{"color-scheme":"light","--primary-500":"#e55f37","--primary-500-fg":"#111111","--neutral-400":"#ababab","--neutral-400-fg":"#111111","--ok-ink":"color-mix(in oklab, var(--ok) 75%, var(--fg))","--ok-fg":"#111111","--warn-ink":"color-mix(in oklab, var(--warn) 50%, var(--fg))","--warn-fg":"#111111","--danger-ink":"color-mix(in oklab, var(--danger) 95%, var(--fg))","--danger-fg":"#ffffff","--fs-xs":"0.6875rem","--fs-sm":"0.75rem","--fs-base":"0.9375rem","--fs-h3":"1.25rem","--fs-h2":"1.75rem","--fs-h1":"2.5rem","--fs-hero":"3.5rem","--lh-body":"1.45","--lh-tight":"1.06","--display-tracking":"0em","--section-y":"80px","--section-y-tablet":"60px","--container-max":"1280px","--gutter":"36px","--gutter-tablet":"24px","--gutter-phone":"16px","--motion-fast":"100ms","--motion-base":"180ms","--ease":"cubic-bezier(0.2, 0, 0, 1)","--radius-lg":"12px","--focus-ring":"0 0 0 4px rgba(210, 75, 31, 0.28)","--secondary":"#9066f7","--secondary-fg":"#111111","--secondary-hover":"#9c7bfa","--bg":"#fff4cf","--surface":"#fffaf0","--surface-2":"#ffdca8","--fg":"#2a1810","--fg-soft":"#593625","--muted":"color-mix(in oklab, #8a6652 85%, var(--fg))","--meta":"color-mix(in oklab, #d24b1f 75%, var(--fg))","--border":"#d9aa7a","--border-soft":"#efd0ab","--border-strong":"color-mix(in oklab, var(--fg) 22%, transparent)","--accent":"#d24b1f","--accent-strong":"color-mix(in oklab, var(--accent) 75%, var(--fg))","--accent-weak":"color-mix(in oklab, var(--accent) 12%, var(--bg))","--accent-fg":"#ffffff","--solid":"#c4451c","--solid-hover":"#aa3b17","--solid-fg":"#ffffff","--ok":"#3d8f4f","--ok-weak":"color-mix(in oklab, var(--ok) 12%, var(--bg))","--warn":"#f2a93b","--warn-weak":"color-mix(in oklab, var(--warn) 14%, var(--bg))","--danger":"#b83a2f","--danger-weak":"color-mix(in oklab, var(--danger) 12%, var(--bg))","--bw":"1px","--radius":"8px","--radius-sm":"4px","--radius-pill":"9999px","--shadow-card":"6px 6px 0 rgba(42, 24, 16, 0.26)","--shadow-pop":"0 14px 40px rgba(0, 0, 0, 0.22)","--font-display":"\"Space Grotesk\", sans-serif","--font-body":"\"Open Sans\", sans-serif","--font-code":"\"IBM Plex Mono\", monospace","--font-mono":"\"IBM Plex Mono\", monospace","--heading-weight":"600","--hero-ground":"var(--surface-2)","--hero-ink":"var(--fg)"},"sections":[{"id":"visual-theme-atmosphere","title":[{"lang":"en-US","message":"Visual Theme & Atmosphere"}],"html":[{"lang":"en-US","message":"<p>Dot-pattern rendering technique that simulates shades with a limited palette for nostalgic, retro, high-contrast visuals.</p>\n<ul><li><strong>Visual style:</strong> modern, minimal</li><li><strong>Color stance:</strong> primary, neutral, success, warning, danger</li><li><strong>Design intent:</strong> Keep outputs recognizable to this style family while preserving usability and readability.</li></ul>"}]},{"id":"color","title":[{"lang":"en-US","message":"Color"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Primary:</strong> <code>#3B82F6</code> — Token from style foundations.</li><li><strong>Secondary:</strong> <code>#8B5CF6</code> — Token from style foundations.</li><li><strong>Success:</strong> <code>#16A34A</code> — Token from style foundations.</li><li><strong>Warning:</strong> <code>#D97706</code> — Token from style foundations.</li><li><strong>Danger:</strong> <code>#DC2626</code> — Token from style foundations.</li><li><strong>Surface:</strong> <code>#FFFFFF</code> — Token from style foundations.</li><li><strong>Text:</strong> <code>#111827</code> — Token from style foundations.</li><li><strong>Neutral:</strong> <code>#FFFFFF</code> — Derived from the surface token for official format compatibility.</li></ul>\n<ul><li>Favor Primary (#3B82F6) for CTA emphasis.</li><li>Use Surface (#FFFFFF) for large backgrounds and cards.</li><li>Keep body copy on Text (#111827) for legibility.</li></ul>"}]},{"id":"typography","title":[{"lang":"en-US","message":"Typography"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Scale:</strong> 14/16/18/24/32/40</li><li><strong>Families:</strong> primary=Open Sans, display=Space Grotesk, mono=IBM Plex Mono</li><li><strong>Weights:</strong> 100, 200, 300, 400, 500, 600, 700, 800, 900</li><li>Headings should carry the style personality; body text should optimize scanability and contrast.</li></ul>"}]},{"id":"spacing-grid","title":[{"lang":"en-US","message":"Spacing & Grid"}],"html":[{"lang":"en-US","message":"<ul><li><strong>Spacing scale:</strong> 4/8/12/16/24/32</li><li>Keep vertical rhythm consistent across sections and components.</li><li>Align columns and modules to a predictable grid; avoid ad-hoc offsets.</li></ul>"}]},{"id":"layout-composition","title":[{"lang":"en-US","message":"Layout & Composition"}],"html":[{"lang":"en-US","message":"<ul><li>Prefer clear content blocks with consistent internal padding.</li><li>Keep hierarchy obvious: headline → support text → primary action.</li><li>Use whitespace to separate concerns before adding borders or shadows.</li></ul>"}]},{"id":"components","title":[{"lang":"en-US","message":"Components"}],"html":[{"lang":"en-US","message":"<ul><li>Buttons: primary action uses <code>#3B82F6</code>; secondary actions stay neutral.</li><li>Inputs: strong focus-visible states, clear labels, and predictable error messaging.</li><li>Cards/sections: use consistent radii, spacing, and elevation strategy across the page.</li></ul>"}]},{"id":"motion-interaction","title":[{"lang":"en-US","message":"Motion & Interaction"}],"html":[{"lang":"en-US","message":"<ul><li>Use subtle transitions that emphasize Primary (#3B82F6) as the interaction signal.</li><li>Default to short, purposeful transitions (150–250ms) with stable easing.</li><li>Ensure hover, focus-visible, active, disabled, and loading states are explicit.</li></ul>"}]},{"id":"voice-brand","title":[{"lang":"en-US","message":"Voice & Brand"}],"html":[{"lang":"en-US","message":"<ul><li>Tone should reflect the visual style: concise, confident, and product-specific.</li><li>Keep microcopy action-oriented and avoid generic filler language.</li><li>Preserve the style identity in headlines while keeping UI labels literal and clear.</li></ul>"}]},{"id":"anti-patterns","title":[{"lang":"en-US","message":"Anti-patterns"}],"html":[{"lang":"en-US","message":"<ul><li>Do not introduce off-palette colors when an existing token can solve the problem.</li><li>Do not flatten hierarchy by using the same type size/weight for all text.</li><li>Do not add decorative effects that reduce readability or accessibility.</li><li>Do not mix unrelated visual metaphors in the same interface.</li></ul>"}]}]}